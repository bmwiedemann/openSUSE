# ============================================================================
# Derived from the external library configuration
#
# Every block here is guarded by a single %bundle_* macro from that region.
# Nothing here may test %%suse_version to decide bundled-vs-system; the only
# distro tests left are about how a system package happens to be split up.
#
# Why the guards read `"%%{name}" == "libreoffice" && %%{bundle_X}`: OBS'
# source_validator does not evaluate %if, except for %if lines that mention
# %%{name}, and it requires every Source: it can see to be a file in the
# package. Without the %%{name} test, Tumbleweed would have to carry every
# tarball SLE bundles. With it, the validator evaluates %%{bundle_X} -- as the
# last value the region assigns, which is 0 for anything not always bundled
# -- and only asks for the tarballs that are always shipped. rpmbuild itself
# evaluates the whole condition normally.
#
# Source numbers are historical and carry no meaning beyond uniqueness.
# ============================================================================
%if !%{bundle_abseil}
BuildRequires:  abseil-cpp-devel
%endif
%if "%{name}" == "libreoffice" && %{bundle_afdko}
Source403:      %{external_url}/afdko-%{version_afdko}.tar.gz
Provides:       bundled(afdko) = %{version_afdko}
%endif
%if "%{name}" == "libreoffice" && %{bundle_argon2}
Source2027:     %{external_url}/phc-winner-argon2-%{version_argon2}.tar.gz
Provides:       bundled(argon2) = %{version_argon2}
