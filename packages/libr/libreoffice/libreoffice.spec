%ifarch %{ix86}
# zstd payload compression OOMs on 32-bit during package creation
# use gzip level 1 (streaming, minimal memory footprint)
%define _binary_payload w1.gzdio
%endif

%{!?aarch64:%global aarch64 aarch64 arm64 armv8}
# Urls
%define external_url https://dev-www.libreoffice.org/src/
%define tarball_url  https://dev-builds.libreoffice.org/pre-releases/src/
# LTO needs newer toolchain stack only
%if 0%{?suse_version} >= 1500
%bcond_without lto
%else
%bcond_with lto
%endif

# When Tumbleweed or SLOF
# Enable QT6 support
%if 0%{?suse_version} >= 1600
%bcond_without qt
%bcond_without qt6
%bcond_with qt5
%else
# When Leap or SLE15-SP4 or newer
# Enable QT5 support
# Disable QT6 support
%if 0%{?is_opensuse} || 0%{?sle_version} >= 150400
%bcond_without qt
%bcond_without qt5
%bcond_with qt6
%else
# Disable QT5/QT6 support
%bcond_with qt
%bcond_with qt5
%bcond_with qt6
%endif
%endif

# Generic GNU triplets for the bundled Python. %%configure passes SUSE
# triplets (x86_64-suse-linux), and the bundled CPython names its
# _sysconfigdata and extension modules after the triplet it is configured
# for, which then no longer matches what external/python3 expects. Only
# used when %%{bundle_python} is 1, see the configure invocation.
%ifarch x86_64
%define host_triplet x86_64-linux-gnu
%endif
%ifarch %{ix86}
%define host_triplet i386-linux-gnu
%endif
%ifarch aarch64
%define host_triplet aarch64-linux-gnu
%endif
%ifarch ppc64le
%define host_triplet powerpc64le-linux-gnu
%endif
%ifarch s390x
%define host_triplet s390x-linux-gnu
%endif

# When Leap 15.X or SLE15 (any service pack)
# Enable firebird support
%if 0%{?suse_version} >= 1500 && 0%{?suse_version} < 1600
%bcond_without firebird
%else
# Otherwise
# Disable Firebird support
%bcond_with firebird
%endif

# Versioned compiler to build with, where the distribution default is not
# the one we want: LibreOffice 26.8 refuses anything below gcc 13
# (configure.ac), SLE 15 ships gcc 7 and Leap/SLES 16 default to gcc 13.
# Tumbleweed's default gcc is used as is. No %%elif: SLE 15 has rpm 4.14.
%if 0%{?suse_version} == 1600
%global with_gcc 15
%else
%if 0%{?suse_version} >= 1500 && 0%{?suse_version} < 1600
%global with_gcc 14
%endif
%endif

# ============================================================================
# External library configuration
#
# Generated by tools/gen_libconfig.py from LibreOffice's download.lst. Every
# tarball download.lst lists appears below, either as a library block or with
# the reason it cannot be used by this package.
#
# Exactly one if/else per library, and it decides everything about that
# library:
#
#   %enable_X    1 = the library/feature is built at all
#   %bundle_X    1 = build the external tarball, 0 = link the system copy
#   %support_X   the literal configure switches (may be %%{nil})
#   %version_X   version download.lst fetches, whatever %bundle_X says
#
# Tumbleweed links every library it can against the system copy. SLE 15
# (suse_version < 1600) bundles every library LibreOffice can build itself.
# To change one library, change its %if; nothing else in this file needs to
# follow, because everything further down is derived from these macros: the
# Source/Provides/BuildRequires block after the patches keys off %bundle_X,
# and configure is handed %support_X.
#
# LibreOffice only has an --enable-X/--disable-X for a handful of these,
# and spells most of them differently from the library (libeot is
# --disable-eot, rhino is --disable-scripting-javascript, and so on). Where
# no such option exists the library is mandatory: %enable_X is pinned to 1
# and %support_X carries only the system-vs-bundled half. Never invent an
# --enable-X; autoconf accepts unknown ones, warns, and ignores them.
#
# Libraries that are only consumed by another one do not get their own
# distro test; they follow their driver's %bundle_X.
#
# Do not use %elif here: SLE 15 ships rpm 4.14, which does not know it.
# ============================================================================

# --- libraries with a real system-vs-bundled choice -------------------------

