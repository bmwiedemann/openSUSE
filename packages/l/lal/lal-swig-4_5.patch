 %swiglal_py_ury_op(nonzero, inquiry, nb_nonzero);
+#if SWIG_VERSION >= 0x040500
+// SWIG 4.5 removed Python 2 support: nb_nonzero was renamed to nb_bool.
+%swiglal_py_ury_op(nonzero, inquiry, nb_bool);
