Subject: compatibility with SWIG 4.5

SWIG 4.5 dropped Python 2 support. LAL needs three small adjustments to keep
building and passing its Python tests with that version:

- %typemaps_string_alloc requires a named fragment for the copy helper, so
  define %swiglal_new_copy_char_array and pass that instead of the bare macro.
- PyInt_AsLong no longer exists; use PyLong_AsLong.
- The python:slot feature nb_nonzero was renamed to nb_bool. Wire __nonzero__
  to nb_bool as well, otherwise types such as LIGOTimeGPS and LALUnit become
  truthy even when they are zero and test_LIGOTimeGPS_operations fails with
  "assert (not LIGOTimeGPS(0, 0))".

--- a/swig/SWIGCommon.i
+++ b/swig/SWIGCommon.i
@@ -182,6 +182,8 @@ MACRO(A, B, C, X);
 #define %swiglal_new_copy(VAL, TYPE...) %reinterpret_cast(memcpy(%swiglal_new_instance(TYPE), &(VAL), sizeof(TYPE)), TYPE*)
 #define %swiglal_new_array(SIZE, TYPE...) %reinterpret_cast(XLALCalloc(SIZE, sizeof(TYPE)), TYPE*)
 #define %swiglal_new_copy_array(PTR, SIZE, TYPE...) %reinterpret_cast(memcpy(%swiglal_new_array(SIZE, TYPE), PTR, sizeof(TYPE)*(SIZE)), TYPE*)
+#define %swiglal_new_copy_char_array(PTR, SIZE) %swiglal_new_copy_array(PTR, SIZE, char)
+%fragment("%swiglal_new_copy_char_array", "header") {}
 
 ///
 /// # General interface code
@@ -1800,12 +1802,12 @@ if (strides[I-1] == 0) {
 %typemaps_string_alloc(%checkcode(STRING), %checkcode(char),
                        SWIGWARN_TYPEMAP_CHARLEAK_MSG, char, LALchar,
                        SWIG_AsLALcharPtrAndSize, SWIG_FromLALcharPtrAndSize,
-                       strlen, SWIG_strnlen, %swiglal_new_copy_array, XLALFree,
+                       strlen, SWIG_strnlen, %swiglal_new_copy_char_array, XLALFree,
                        "<limits.h>", CHAR_MIN, CHAR_MAX);
 #else
 %typemaps_string_alloc(%checkcode(STRING), %checkcode(char), char, LALchar,
                        SWIG_AsLALcharPtrAndSize, SWIG_FromLALcharPtrAndSize,
-                       strlen, SWIG_strnlen, %swiglal_new_copy_array, XLALFree,
+                       strlen, SWIG_strnlen, %swiglal_new_copy_char_array, XLALFree,
                        "<limits.h>", CHAR_MIN, CHAR_MAX);
 #endif
 
--- a/swig/SWIGPython.i
