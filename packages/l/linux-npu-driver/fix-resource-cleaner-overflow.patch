From 84819fb90b5786fcde13552df772467f9d6b7ffe Mon Sep 17 00:00:00 2001
From: "Alessandro de Oliveira Faria (A.K.A. CABELO)" <cabelo@opensuse.org>
Date: Thu, 30 Jul 2026 00:55:32 -0300
Subject: [PATCH] UMD: Prevent ResourceCleaner timeout overflow on libstdc++

Avoid passing the max steady_clock time_point to cv.wait_until, which
can overflow internally on libstdc++ and cause undefined behavior.
Instead, use cv.wait() when no timeout is set, only computing an
actual wait_until deadline when a real idle timeout is active.
---
 umd/level_zero_driver/source/context.cpp | 13 +++++++++----
 1 file changed, 9 insertions(+), 4 deletions(-)

diff --git a/umd/level_zero_driver/source/context.cpp b/umd/level_zero_driver/source/context.cpp
index a4d29fe..171aed5 100644
--- a/umd/level_zero_driver/source/context.cpp
+++ b/umd/level_zero_driver/source/context.cpp
@@ -258,12 +258,17 @@ ResourceCleaner::ResourceCleaner(Context *ctx, std::chrono::milliseconds timeout
     , thread(
           [this](Context *ctx) {
               std::unique_lock<std::mutex> lock(mutex);
-              auto timeout = std::chrono::time_point<std::chrono::steady_clock>::max();
+              const auto noTimeout = std::chrono::time_point<std::chrono::steady_clock>::max();
+              auto timeout = noTimeout;
               while (action != Action::BREAK) {
-                  if (cv.wait_until(lock, timeout) == std::cv_status::timeout) {
+                  if (timeout == noTimeout) {
+                      cv.wait(lock);
+                  } else if (cv.wait_until(lock, timeout) == std::cv_status::timeout) {
                       ctx->releaseMemory();
-                      timeout = std::chrono::time_point<std::chrono::steady_clock>::max();
-                  } else if (action == Action::PRUNE_AFTER_TIMEOUT) {
+                      timeout = noTimeout;
+                      continue;
+                  }
+                  if (action == Action::PRUNE_AFTER_TIMEOUT) {
                       timeout = std::chrono::steady_clock::now() + idleTimeout;
                   }
               }
