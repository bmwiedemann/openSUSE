product_compose_schema: 0.2

vendor: openSUSE
name: openSUSE
version_from_package: openSUSE-release
product-type: base
summary: openSUSE Tumbleweed

# enable iso file generation
iso:
  publisher: openSUSE

installcheck:
- ignore_errors

source: split
debug: split

# will be extended with architecture and flavor string
flavors:
  tw_dvd5_x86_64:
    architectures: [ x86_64 ]
    product_directory_name: TW-offline-installer
    name: Tumbleweed
    summary: openSUSE Tumbleweed offline installer
    iso:
      volume_id: Install-Tumbleweed-x86_64
      base: agama-installer-Tumbleweed
      tree: drop
    source: drop
    debug: drop
  tw_mini_x86_64:
    architectures: [ x86_64 ]
    product_directory_name: TW-online-installer
    name: Tumbleweed
    summary: openSUSE Tumbleweed online installer
    build_options:
      - base_skip_packages
    iso:
      volume_id: Install-Tumbleweed-x86_64
      base: agama-installer-Tumbleweed
      tree: drop
    source: drop
    debug: drop

unpack:
  - unpackset

packagesets:
- name: unpackset
  packages:
  - skelcd-openSUSE

# The following is generated by openSUSE-release-tools
