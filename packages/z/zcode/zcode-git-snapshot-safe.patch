 }
 
+// The snapshot runs before any approval: a repository-planted bare
+// repository, core.fsmonitor or signature check must not run a command.
+const SAFE_GIT_ARGS = [
+  "-c",
+  "safe.bareRepository=explicit",
+  "-c",
+  "core.fsmonitor=false",
+  "-c",
+  "log.showSignature=false",
+];
