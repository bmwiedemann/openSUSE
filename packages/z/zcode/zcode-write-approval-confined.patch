@@ -30,6 +33,51 @@
 /** 草稿免确认的规则号。 */
 const WORKFLOW_DRAFT_PREAPPROVED_RULE_ID = "tool.workflowDraft.preapproved";
 
+// A write is only auto-approved where its path says it goes: inside the
+// workspace root (Bash moves the working directory, into .git as well), not
+// into a .git directory, and through no symlink (a repository can commit
+// .zcode/workflow-drafts -> ../.git). Anything else asks.
+function isConfinedWriteTarget(
+  workingDirectory: string | undefined,
+  workspaceRoot: string | undefined,
+  input: unknown,
+): boolean {
+  if (!workingDirectory || !workspaceRoot) return false;
+  const filePath =
+    input && typeof input === "object" ? (input as Record<string, unknown>).file_path : undefined;
+  if (typeof filePath !== "string" || filePath.length === 0) return false;
+  return isConfinedPath(workspaceRoot, nodePath.resolve(workingDirectory, filePath));
+}
+
+// target is below root, has no .git component in any letter case anywhere
+// (a subagent's workspace root is the working directory it started in, which
+// Bash may have moved into .git) and no symlink below root on the way.
+export function isConfinedPath(root: string, target: string): boolean {
+  const base = nodePath.resolve(root);
+  const resolved = nodePath.resolve(base, target);
+  const relative = nodePath.relative(base, resolved);
+  if (
+    relative.length === 0 ||
+    relative === ".." ||
+    relative.startsWith(`..${nodePath.sep}`) ||
+    nodePath.isAbsolute(relative) ||
+    resolved.split(nodePath.sep).some((part) => part.toLowerCase() === ".git")
+  ) {
+    return false;
+  }
+  let current = base;
+  for (const part of relative.split(nodePath.sep)) {
+    current = nodePath.join(current, part);
+    try {
+      if (lstatSync(current).isSymbolicLink()) return false;
+    } catch {
+      // Not there yet: the rest is created as plain directories and a file.
+      break;
+    }
+  }
+  return true;
+}
