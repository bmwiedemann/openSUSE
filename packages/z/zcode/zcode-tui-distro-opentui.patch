--- a/apps/zcode-cli/packages/tui/package.json	2026-09-24 08:49:06.000000000 +0200
+++ b/apps/zcode-cli/packages/tui/package.json	2026-09-25 09:04:33.603055591 +0200
@@ -19,8 +19,8 @@
     "lint:fix": "oxlint --write src"
   },
   "dependencies": {
-    "@mbears/opentui-core": "0.2.15",
-    "@mbears/opentui-react": "0.2.15",
+    "@opentui/core": "0.5.12",
+    "@opentui/react": "0.5.12",
     "@zcode/contracts": "workspace:*",
