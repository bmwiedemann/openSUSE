         return await denyBroker.requestPermission(request, options);
       }
+      // world.run runs commands unchecked: no workflow outside yolo mode.
+      if (request.mode !== "yolo") {
+        return {
+          decision: "deny",
+          reason: `${request.toolName} denied: workflows run only in yolo mode (--mode yolo).`,
+          resolvedAt: new Date(),
+        };
+      }
       return {
         decision: "allow",
         reason: `Headless CLI auto-approves ${request.toolName}: no interactive gate exists in -p mode.`,
