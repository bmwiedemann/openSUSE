<services>
  <service name="obs_scm" mode="manual">
    <param name="scm">git</param>
    <param name="url">https://github.com/zed-industries/zed.git</param>
    <param name="revision">v1.24.2</param>
    <param name="versionformat">@PARENT_TAG@</param>
    <param name="versionrewrite-pattern">v(.*)</param>
    <param name="versionrewrite-replacement">\1</param>
    <param name="package-meta">yes</param>
    <param name="submodules">enable</param>
    <param name="changesgenerate">disable</param>
  </service>
  <service name="tar" mode="buildtime"/>
  <service name="recompress" mode="buildtime">
    <param name="compression">zst</param>
    <param name="file">*.tar</param>
  </service>
  <service name="set_version" mode="buildtime"/>
  <!--
    update=false ships upstream's own tested crate set. update=true re-resolves
    every registry dependency to the newest semver-compatible release, which is
    a combination nobody has tested. It is not what holds the livekit stack
    in place: livekit, libwebrtc and webrtc-sys are [patch.crates-io] git
    dependencies pinned by rev (0a1c519c), and cargo update cannot move a rev
    pin.
  -->
  <service name="cargo_vendor" mode="manual">
    <param name="srcdir">zed</param>
    <param name="update">false</param>
    <param name="compression">zst</param>
  </service>
</services>
