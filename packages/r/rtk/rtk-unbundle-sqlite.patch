Link against the system SQLite instead of the copy bundled inside
libsqlite3-sys. openSUSE packages must not ship bundled libraries: a
statically linked SQLite would have to be tracked and patched separately
for every SQLite CVE.

Index: rtk-0.49.0/Cargo.toml
===================================================================
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -72,8 +72,8 @@
 # Pinned to what the proxy crate's icm-store links: libsqlite3-sys declares
 # `links = "sqlite3"`, and two versions of it cannot coexist in one workspace
 # resolve. See proxy/Cargo.toml.
-rusqlite = { version = "0.34", features = ["bundled"] }
+rusqlite = { version = "0.34" }
 toml = "0.8"
 toml_edit = "0.22"
 chrono = "0.4"
 tempfile = "3"
