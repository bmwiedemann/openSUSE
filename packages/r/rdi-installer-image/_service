<services>
    <service name="obs_scm" mode="manual">
        <param name="url">https://github.com/thkukuk/rdi-installer.git</param>
        <param name="scm">git</param>
        <param name="revision">main</param>
        <param name="version">_none_</param>
	<param name="subdir">images</param>
        <param name="extract">obs/mkosi.conf</param>
	<param name="extract">obs/mkosi-obs-include.obscpio</param>
        <param name="versionformat">%cd.%h</param>
	<param name="filename">rdi-installer-image</param>
        <param name="changesgenerate">enable</param>
    </service>
</services>

