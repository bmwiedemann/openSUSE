+++ tools/cliutils.c	2026-11-12 10:11:31.041988755 +0000
@@ -11,6 +11,7 @@
 #include "debug.h"
 
 static pid_t pipeChild = 0;
+static pid_t rpopenChild = 0;
 
 RPM_GNUC_NORETURN
 void argerror(const char * desc)
@@ -83,3 +84,64 @@ int finishPipe(void)
     }
     return rc;
 }
+
+FILE* rpopen(const char *cmd, const char *arg, ...)
+{
+    FILE *fp = NULL;
+    int pipefd[2];
+    ARGV_t argv = NULL;
+    va_list ap;
+
+    if (pipe(pipefd) < 0)
+	return NULL;
+
+    if ((fp = fdopen(pipefd[0], "r")) == NULL) {
+	close(pipefd[0]);
+	close(pipefd[1]);
+	return NULL;
+    }
+
+    argvAdd(&argv, "/bin/sh");
+    argvAdd(&argv, "-c");
+    argvAdd(&argv, "--");
+    argvAdd(&argv, cmd);    /* User command */
+    argvAdd(&argv, "sh");   /* Shell name ($0) */
+
+    /* User positional parameters ($1, $2, ...) */
+    va_start(ap, arg);
+    for (const char *s = arg; s != NULL; s = va_arg(ap, const char *))
+	argvAdd(&argv, s);
+    va_end(ap);
+
+    if ((rpopenChild = fork()) == 0) {
+	dup2(pipefd[1], STDOUT_FILENO);
+	close(pipefd[1]);
+	close(pipefd[0]);
+	execv(argv[0], argv);
+	_exit(127);
+    } else if (rpopenChild == -1) {
+	fclose(fp);
+	fp = NULL;
+    }
+
+    close(pipefd[1]);
+    argvFree(argv);
+
+    return fp;
+}
+
+int rpclose(FILE *fp)
+{
+    int status = -1;
+    pid_t reaped;
+
+    fclose(fp);
+    do {
+	reaped = waitpid(rpopenChild, &status, 0);
+    } while (reaped == -1 && errno == EINTR);
+
+    if (reaped == -1)
+	return -1;
+
+    return status;
+}
