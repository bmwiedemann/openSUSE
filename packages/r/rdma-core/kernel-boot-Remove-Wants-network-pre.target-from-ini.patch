From 4cbdf9d01bcd6e5b7b33bb91c610987396376cba Mon Sep 17 00:00:00 2001
From: Nicolas Morey <nmorey@suse.com>
Date: Fri, 18 Sep 2026 12:32:08 +0200
Subject: [PATCH] kernel-boot: Remove Wants=network-pre.target from initrd

rdma-load-modules@.service has a Wants=network-pre.target.
While this ensures it is ordered before network initialization even
when no other unit explicitly wants network-pre.target, it causes issues
when executed from the initrd.

During the initrd phase, systemd has no visibility into services on the
root filesystem. Triggering network-pre.target in the initrd marks it as
satisfied before switch-root, causing systemd to bypass rootfs services
ordered Before=network-pre.target (such as firewalls or custom network
scripts) once NetworkManager or Wicked starts on the host.

Work around this issue by moving the Wants= and Before= network-pre.target
directives into a drop-in file that is installed only on the root
filesystem and excluded from the initrd.

In the initrd, there is no direct network-pre dependency, but
Before=sysinit.target ensures modules load before sysinit completes.
Post root switch, the drop-in restores the Wants/Before dependencies,
preserving legacy host behavior. Because udev replays device events
after root switch, the service is re-evaluated with its drop-in,
and dependencies execute as expected.

Signed-off-by: Nicolas Morey <nmorey@suse.com>
---
 debian/rdma-core.install                       | 1 +
 kernel-boot/CMakeLists.txt                     | 4 ++++
 kernel-boot/rdma-load-modules-network-pre.conf | 6 ++++++
 kernel-boot/rdma-load-modules@.service.in      | 5 -----
 redhat/rdma-core.spec                          | 1 +
 suse/rdma-core.spec                            | 1 +
 6 files changed, 13 insertions(+), 5 deletions(-)
 create mode 100644 kernel-boot/rdma-load-modules-network-pre.conf

diff --git debian/rdma-core.install debian/rdma-core.install
index 30c22ff72cb0..dd1c3672e14c 100644
--- debian/rdma-core.install
+++ debian/rdma-core.install
@@ -11,6 +11,7 @@ etc/rdma/modules/roce.conf
 lib/systemd/system/iwpmd.service
 lib/systemd/system/rdma-hw.target
 lib/systemd/system/rdma-load-modules@.service
+lib/systemd/system/rdma-load-modules@.service.d
 lib/systemd/system/rdma-ndd.service
 lib/udev/rdma_rename
 lib/udev/rules.d/60-rdma-ndd.rules
diff --git kernel-boot/CMakeLists.txt kernel-boot/CMakeLists.txt
index 515aa6684d5d..195220557b63 100644
--- kernel-boot/CMakeLists.txt
+++ kernel-boot/CMakeLists.txt
@@ -3,6 +3,10 @@ rdma_subst_install(FILES rdma-load-modules@.service.in
   RENAME rdma-load-modules@.service
   PERMISSIONS OWNER_WRITE OWNER_READ GROUP_READ WORLD_READ)
 
+install(FILES rdma-load-modules-network-pre.conf
+  RENAME "10-network-pre.conf"
+  DESTINATION "${CMAKE_INSTALL_SYSTEMD_SERVICEDIR}/rdma-load-modules@.service.d/")
+
 rdma_subst_install(FILES "rdma-hw.target.in"
   RENAME "rdma-hw.target"
   DESTINATION "${CMAKE_INSTALL_SYSTEMD_SERVICEDIR}"
diff --git kernel-boot/rdma-load-modules-network-pre.conf kernel-boot/rdma-load-modules-network-pre.conf
new file mode 100644
index 000000000000..c81dcd501233
--- /dev/null
+++ kernel-boot/rdma-load-modules-network-pre.conf
@@ -0,0 +1,6 @@
+[Unit]
+# Partially support distro network setup scripts that run after
+# systemd-modules-load.service but before sysinit.target, eg a classic network
+# setup script. Run them after modules have loaded.
+Wants=network-pre.target
+Before=network-pre.target
diff --git kernel-boot/rdma-load-modules@.service.in kernel-boot/rdma-load-modules@.service.in
index 773f6237d63e..064c10281fc7 100644
--- kernel-boot/rdma-load-modules@.service.in
+++ kernel-boot/rdma-load-modules@.service.in
@@ -11,11 +11,6 @@ Before=initrd.target
 # Do not execute concurrently with an ongoing shutdown
 Conflicts=shutdown.target
 Before=shutdown.target
-# Partially support distro network setup scripts that run after
-# systemd-modules-load.service but before sysinit.target, eg a classic network
-# setup script. Run them after modules have loaded.
-Wants=network-pre.target
-Before=network-pre.target
 # Orders all kernel module startup before rdma-hw.target can become ready
 Before=rdma-hw.target
 
diff --git redhat/rdma-core.spec redhat/rdma-core.spec
index 461cd64c1419..5fa8f2755c09 100644
--- redhat/rdma-core.spec
+++ redhat/rdma-core.spec
@@ -431,6 +431,7 @@ fi
 %config(noreplace) %{_sysconfdir}/modprobe.d/truescale.conf
 %{_unitdir}/rdma-hw.target
 %{_unitdir}/rdma-load-modules@.service
+%{_unitdir}/rdma-load-modules@.service.d/
 %dir %{dracutlibdir}
 %dir %{dracutlibdir}/modules.d
 %dir %{dracutlibdir}/modules.d/50rdma
diff --git suse/rdma-core.spec suse/rdma-core.spec
index 72eebd67af3e..1e0de1048416 100644
--- suse/rdma-core.spec
+++ suse/rdma-core.spec
@@ -645,6 +645,7 @@ done
 %{_modprobedir}/truescale.conf
 %{_unitdir}/rdma-hw.target
 %{_unitdir}/rdma-load-modules@.service
+%{_unitdir}/rdma-load-modules@.service.d/
 %dir %{dracutlibdir}
 %dir %{dracutlibdir}/modules.d
 %dir %{dracutlibdir}/modules.d/50rdma
-- 
