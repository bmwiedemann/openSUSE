+
+#ifndef __CLANG_CUDA_WRAPPERS_FORMAT
+#define __CLANG_CUDA_WRAPPERS_FORMAT
+
+#if _GLIBCXX_RELEASE >= 16
+#pragma push_macro("__noinline__")
+#undef __noinline__
+#endif
+
+#include_next <format>
+
+#if _GLIBCXX_RELEASE >= 16
+#pragma pop_macro("__noinline__")
+#endif
+
+#endif // include guard
