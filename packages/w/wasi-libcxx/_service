<services>
  <!-- LLVM only publishes the full llvm-project tarball (~170 MB).
       Pack just what a standalone libc++/libc++abi runtimes build needs. -->
  <service name="tar_scm" mode="manual">
    <param name="scm">git</param>
    <param name="url">https://github.com/llvm/llvm-project.git</param>
    <param name="revision">llvmorg-23.1.2</param>
    <param name="version">23.1.2</param>
    <param name="filename">llvm-runtimes-subset</param>
    <param name="include">runtimes</param>
    <param name="include">cmake</param>
    <param name="include">llvm/cmake</param>
    <param name="include">libcxx</param>
    <param name="include">libcxxabi</param>
    <!-- libc++ from_chars uses llvm-libc's shared/ headers -->
    <param name="include">libc</param>
  </service>
  <service name="recompress" mode="manual">
    <param name="file">*.tar</param>
    <param name="compression">xz</param>
  </service>
</services>
