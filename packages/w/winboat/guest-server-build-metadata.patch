From: openSUSE Packaging <packages@opensuse.org>
Date: Tue, 11 Aug 2026 00:00:00 +0000
Subject: Allow the package build to provide reproducible metadata

--- a/build-guest-server.sh
+++ b/build-guest-server.sh
@@ -8,8 +8,8 @@ export GOOS=windows
 export GOARCH=amd64
 export PACKAGE=winboat-server
 export VERSION="$(node -p "require('./package.json').version")"
-export COMMIT_HASH="$(git rev-parse --short HEAD)"
-export BUILD_TIMESTAMP=$(date '+%Y-%m-%dT%H:%M:%S')
+export COMMIT_HASH="${COMMIT_HASH:-$(git rev-parse --short HEAD)}"
+export BUILD_TIMESTAMP="${BUILD_TIMESTAMP:-$(date -u '+%Y-%m-%dT%H:%M:%S')}"
 export LDFLAGS=(
   "-X 'main.Version=${VERSION}'"
   "-X 'main.CommitHash=${COMMIT_HASH}'"
