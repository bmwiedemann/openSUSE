<services>
  <service name="tar_scm" mode="disabled">
    <param name="url">https://github.com/Azure/azure-storage-azcopy</param>
    <param name="scm">git</param>
    <param name="exclude">.git</param>
    <param name="versionformat">v10.32.6</param>
    <param name="revision">v10.32.6</param>
    <param name="changesgenerate">disable</param>
  </service>
  <service name="recompress" mode="disabled">
    <param name="file">azure-storage-azcopy-*.tar</param>
    <param name="compression">gz</param>
  </service>
  <service name="set_version" mode="disabled">
    <param name="basename">azure-storage-azcopy</param>
  </service>
  <service name="go_modules" mode="disabled">
    <param name="archive">azure-storage-azcopy-v10.32.6.tar.gz</param>
    <param name="replace">golang.org/x/net=golang.org/x/net@v0.57.0</param>
    <param name="replace">golang.org/x/text=golang.org/x/text@v0.40.0</param>
  </service>
</services>
