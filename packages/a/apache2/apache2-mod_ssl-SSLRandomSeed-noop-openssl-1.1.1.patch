+++ b/modules/ssl/ssl_engine_config.c	2026-11-04 04:53:14.732165052 -0300
@@ -644,6 +644,7 @@ const char *ssl_cmd_SSLRandomSeed(cmd_pa
                                   const char *arg2,
                                   const char *arg3)
 {
+#ifdef MODSSL_USE_SSLRAND
     SSLModConfigRec *mc = myModConfig(cmd->server);
     const char *err;
     ssl_randseed_t *seed;
@@ -728,6 +729,12 @@ const char *ssl_cmd_SSLRandomSeed(cmd_pa
         }
     }
 
+#else
+    ap_log_error(APLOG_MARK, APLOG_WARNING, 0, cmd->server, APLOGNO(10235)
+                 "SSLRandomSeed is deprecated and has no effect "
+                 "with OpenSSL 1.1.1 and later");
+#endif
+
     return NULL;
 }
 
