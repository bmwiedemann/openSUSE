From 6d1c7f83b9a5e4d3c2b1a0f9e8d7c6b5a4f31209 Mon Sep 17 00:00:00 2001
From: Guo Yunhe <i@guoyunhe.me>
Date: Tue, 22 Sep 2026 19:50:00 +0800
Subject: [PATCH] Fix the build with Boost 1.91

Boost 1.91 trimmed a lot of includes which used to come in transitively:

 * boost/asio.hpp does not include deadline_timer.hpp any more and the
   deprecated deadline_timer/expires_from_now are gone from the default API.
   The timers are ported to steady_timer with expires_after and std::chrono
   types - the same shape as the system_timer which the Boost deprecation
   notice suggests, but with a monotonic clock, which is what a timeout wants.
 * tbs_web_server.cpp used boost::shared_ptr without including
   <boost/shared_ptr.hpp>.
 * tbs_web_server.hpp names boost::interprocess::named_semaphore in a member
   declaration without including it.

Seven timer declarations and eleven expires_from_now() calls are affected.

--- a/src/module_web_server.cpp
+++ b/src/module_web_server.cpp
@@ -72,7 +72,7 @@
 
 void ModuleWebServer::heartbeat()
 {
-	timer_.expires_from_now(boost::posix_time::seconds(1));
+	timer_.expires_after(std::chrono::seconds(1));
 	timer_.async_wait(std::bind(&ModuleWebServer::heartbeat, this));
 }
 
