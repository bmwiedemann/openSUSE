+            let summary = "Results:\navailable   ai.storyteller.pdfcraft 0.3.0-1 (updates) Pdf tools, once printcraft\n";
+            assert_eq!(resolved_name(summary, &pdf), Some("ai.storyteller.pdfcraft"));
