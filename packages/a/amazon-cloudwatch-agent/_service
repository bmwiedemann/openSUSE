<services>
  <service name="tar_scm" mode="disabled">
    <param name="url">https://github.com/aws/amazon-cloudwatch-agent</param>
    <param name="scm">git</param>
    <param name="exclude">.git</param>
    <param name="revision">v1.300072.0</param>
    <param name="versionformat">@PARENT_TAG@</param>
    <param name="changesgenerate">enable</param>
    <param name="versionrewrite-pattern">v(.*)</param>
  </service>
  <service name="set_version" mode="disabled">
    <param name="basename">amazon-cloudwatch-agent</param>
  </service>
  <service name="recompress" mode="disabled">
    <param name="file">*.tar</param>
    <param name="compression">gz</param>
  </service>
  <service name="go_modules" mode="disabled">
    <param name="replace">github.com/grpc-ecosystem/grpc-gateway/v2=github.com/grpc-ecosystem/grpc-gateway/v2@v2.30.0</param>
    <param name="replace">github.com/prometheus/common=github.com/prometheus/common@v0.62.0</param>
    <param name="replace">go.opentelemetry.io/otel=go.opentelemetry.io/otel@v1.46.0</param>
    <param name="replace">google.golang.org/grpc=google.golang.org/grpc@v1.83.2</param>
  </service>
</services>
