From: Antonio Larrosa <alarrosa@suse.com>
Subject: Fix test_article_insensitive_adapter with Qt 6.12

When building with Qt 6.12, test_article_insensitive_adapter fails with:

```
    @pytest.mark.skipif(IS_WIN, reason="QCollator not used on Windows")
    def test_article_insensitive_adapter() -> None:
        setup_i18n(None, 'en')
        values = ["The Beatles", "Beatles", "An Artist", "Artist"]
        expected = ["An Artist", "Artist", "The Beatles", "Beatles"]
        result = _sorted_values(ArticleInsensitiveAdapter, values)
>       assert result == expected
E       AssertionError: assert ['Artist', 'An Artist', 'Beatles', 'The Beatles'] == ['An Artist', 'Artist', 'The Beatles', 'Beatles']
E         
E         At index 0 diff: 'Artist' != 'An Artist'
E         
E         Full diff:
E           [
E         +     'Artist',
E               'An Artist',
E         -     'Artist',
E         +     'Beatles',
E               'The Beatles',
E         -     'Beatles',
E           ]

test/ui/test_custom_columns_sorting_adapters.py:161: AssertionError
```

This fixes it by changing the expected ordered list depending on the Qt version

Index: picard-release-3.0.2/test/ui/test_custom_columns_sorting_adapters.py
===================================================================
--- picard-release-3.0.2.orig/test/ui/test_custom_columns_sorting_adapters.py
+++ picard-release-3.0.2/test/ui/test_custom_columns_sorting_adapters.py
@@ -25,6 +25,8 @@ from unittest.mock import MagicMock
 from picard.const.sys import IS_WIN
 from picard.i18n import setup_i18n
 
+from PyQt6.QtCore import QT_VERSION
+
 import pytest
 
 from picard.ui.columns import (
@@ -156,7 +158,11 @@ def test_length_sort_adapter() -> None:
 def test_article_insensitive_adapter() -> None:
     setup_i18n(None, 'en')
     values = ["The Beatles", "Beatles", "An Artist", "Artist"]
-    expected = ["An Artist", "Artist", "The Beatles", "Beatles"]
+    # Qt 6.12 changed the way texts are collated so the sort order is different
+    if QT_VERSION >= ((6 << 16) | (12 << 8)):
+        expected = ["Artist", "An Artist", "Beatles", "The Beatles"]
+    else:
+        expected = ["An Artist", "Artist", "The Beatles", "Beatles"]
     result = _sorted_values(ArticleInsensitiveAdapter, values)
     assert result == expected
 
