From 57ed6c092dd23890fbc074c88061f88533d8717c Mon Sep 17 00:00:00 2001
From: varun <varunjuneja7@gmail.com>
Date: Sat, 5 Sep 2026 02:28:50 +0530
Subject: [PATCH] Fix test_manipulated_cookie to work with Django 6.1's cookie
 signing

---
 tests/wizard/test_cookiestorage.py | 9 ++++-----
 1 file changed, 4 insertions(+), 5 deletions(-)

diff --git a/tests/wizard/test_cookiestorage.py b/tests/wizard/test_cookiestorage.py
index ba8d493..2467977 100644
--- a/tests/wizard/test_cookiestorage.py
+++ b/tests/wizard/test_cookiestorage.py
@@ -1,4 +1,3 @@
-from django.core import signing
 from django.http import HttpResponse
 from django.test import TestCase
 
@@ -15,11 +14,11 @@ def test_manipulated_cookie(self):
         request = get_request()
         storage = self.get_storage()('wizard1', request, None)
 
-        cookie_signer = signing.get_cookie_signer(storage.prefix)
+        storage.data = {'key1': 'value1'}
+        response = HttpResponse()
+        storage.update_response(response)
 
-        storage.request.COOKIES[storage.prefix] = cookie_signer.sign(
-            storage.encoder.encode({'key1': 'value1'})
-        )
+        storage.request.COOKIES[storage.prefix] = response.cookies[storage.prefix].value
 
         self.assertEqual(storage.load_data(), {'key1': 'value1'})
 
