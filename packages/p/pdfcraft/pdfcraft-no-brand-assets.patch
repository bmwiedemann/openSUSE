From: openSUSE Publishing <publishing@opensuse.org>
Subject: [PATCH] Use open-source PdfCraft tile instead of trademarked ArtCraft marks
Bug: none (downstream trademark removal, not upstreamable)

docs/brand/ (ArtCraft wordmark/mark, LICENSE-brand.txt) is explicitly NOT
open source and must not ship in the tarball, the RPM, or the linked
binary (LICENSE-brand.txt: forks/modified versions must remove the marks).
crates/ui-egui embeds three brand SVGs via include_bytes!, so excluding
docs/brand breaks the build. Point those includes at the open-source
PdfCraft app tile (assets/app-icon/pdfcraft-small.svg, MIT OR Apache-2.0)
instead. The About/Home placements stay, only the artwork changes.

--- a/crates/ui-egui/src/widgets.rs
+++ b/crates/ui-egui/src/widgets.rs
@@ -509,23 +509,24 @@
     cancel
 }
 
-/// The ArtCraft wordmark (Storyteller's brand, docs/brand/; not open source), sized to `height`.
+/// Downstream logo (openSUSE): the trademarked ArtCraft marks in docs/brand/
+/// are not shipped; show the open-source PdfCraft tile instead.
 pub fn artcraft_logo(ui: &mut egui::Ui, height: f32) -> Response {
     let dark = ui.visuals().dark_mode;
     let (uri, bytes): (&str, &'static [u8]) = if dark {
-        ("bytes://artcraft-logo-white.svg", include_bytes!("../../../docs/brand/artcraft-logo-white.svg"))
+        ("bytes://artcraft-logo-white.svg", include_bytes!("../../../assets/app-icon/pdfcraft-small.svg"))
     } else {
-        ("bytes://artcraft-logo.svg", include_bytes!("../../../docs/brand/artcraft-logo.svg"))
+        ("bytes://artcraft-logo.svg", include_bytes!("../../../assets/app-icon/pdfcraft-small.svg"))
     };
-    ui.add(egui::Image::from_bytes(uri, bytes).max_height(height).alt_text("ArtCraft"))
+    ui.add(egui::Image::from_bytes(uri, bytes).max_height(height).alt_text("PdfCraft"))
 }
 
-/// The ArtCraft mark (brand blue, works on light and dark), `size` points square.
+/// Downstream mark (openSUSE): see artcraft_logo.
 pub fn artcraft_mark(ui: &mut egui::Ui, size: f32) -> Response {
     ui.add(
-        egui::Image::from_bytes("bytes://artcraft-mark.svg", include_bytes!("../../../docs/brand/artcraft-mark.svg"))
+        egui::Image::from_bytes("bytes://artcraft-mark.svg", include_bytes!("../../../assets/app-icon/pdfcraft-small.svg"))
             .fit_to_exact_size(vec2(size, size))
-            .alt_text("ArtCraft"),
+            .alt_text("PdfCraft"),
     )
 }
 
