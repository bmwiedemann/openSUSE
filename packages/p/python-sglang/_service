<services>
  <!-- Run this on a tree with sglang-api-codegen-system-protoc.patch applied:
       the sglang-api-codegen generator's vendored protoc must not end up in
       vendor.tar.zst. -->
  <service name="cargo_vendor" mode="manual">
    <param name="src">sglang-*.tar.gz</param>
    <param name="custom-root">rust</param>
    <param name="compression">zst</param>
    <param name="update">true</param>
  </service>
</services>
