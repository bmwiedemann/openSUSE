---
 debug_toolbar/panels/profiling.py | 1 +
 1 file changed, 1 insertion(+)

diff --git a/debug_toolbar/panels/profiling.py b/debug_toolbar/panels/profiling.py
index 3698ec45f..7b65805f3 100644
--- a/debug_toolbar/panels/profiling.py
+++ b/debug_toolbar/panels/profiling.py
@@ -184,6 +184,7 @@ def generate_stats(self, request, response):
         self.stats = Stats(self.profiler)
         self.stats.calc_callees()
 
+        # This tuple replaces cProfile.label(), which was removed in Python 3.15.
         code = super().process_request.__code__
         root_func = (code.co_filename, code.co_firstlineno, code.co_name)
 
