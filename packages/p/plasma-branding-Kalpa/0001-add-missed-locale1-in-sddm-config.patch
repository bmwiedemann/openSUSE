From 6db4a7e94fc351a966dd4e36758a5961da357d22 Mon Sep 17 00:00:00 2001
From: Shawn W Dunn <sfalken@kalpadesktop.org>
Date: Thu, 18 Jun 2026 08:42:57 -0700
Subject: [PATCH] add missed locale1 in sddm config

---
 usr/lib/sddm/sddm.conf.d/10-wayland.conf | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/usr/lib/sddm/sddm.conf.d/10-wayland.conf b/usr/lib/sddm/sddm.conf.d/10-wayland.conf
index 91c5bc6..4eff7ba 100644
--- a/usr/lib/sddm/sddm.conf.d/10-wayland.conf
+++ b/usr/lib/sddm/sddm.conf.d/10-wayland.conf
@@ -3,4 +3,4 @@ DisplayServer=wayland
 GreeterEnvironment=QT_WAYLAND_SHELL_INTEGRATION=layer-shell
 
 [Wayland]
-CompositorCommand=kwin_wayland --no-lockscreen --no-global-shortcuts
+CompositorCommand=kwin_wayland --no-lockscreen --no-global-shortcuts --locale1
