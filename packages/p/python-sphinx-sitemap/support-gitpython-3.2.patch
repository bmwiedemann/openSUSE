Subject: [PATCH 1/2] Move git_setup fixture to conftest

The git_setup fixture was duplicated into both test files, with the same
content, move it into conftest, and also exclude .git from
repo.index.add(), to support GitPython 3.2+ path validation.
---
 tests/conftest.py           | 10 ++++++++++
 tests/test_parallel_mode.py |  9 ---------
 tests/test_simple.py        |  9 ---------
 3 files changed, 10 insertions(+), 18 deletions(-)

diff --git a/tests/conftest.py b/tests/conftest.py
index 5332dce..7ae660d 100644
--- a/tests/conftest.py
+++ b/tests/conftest.py
@@ -1,5 +1,7 @@
+import os
 from pathlib import Path
 
+from git import Repo
 import pytest
 import sphinx
 
@@ -22,3 +24,11 @@ def rootdir():
         return path(__file__).parent.abspath() / "roots"
 
     return Path(__file__).resolve().parent / "roots"
+
+
+@pytest.fixture(autouse=True, scope="function")
+def git_setup(app):
+    repo = Repo.init(app.srcdir)
+    repo.index.add([p for p in os.listdir(app.srcdir) if p != ".git"])
+    repo.index.commit("test: creating git record for files")
+    yield
diff --git a/tests/test_parallel_mode.py b/tests/test_parallel_mode.py
index 88fc4fd..0a1e480 100644
--- a/tests/test_parallel_mode.py
+++ b/tests/test_parallel_mode.py
@@ -2,15 +2,6 @@
 from xml.etree import ElementTree as etree
 
