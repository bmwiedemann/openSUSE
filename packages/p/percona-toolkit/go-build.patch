Index: percona-toolkit-3.7.1-4/Makefile.PL
===================================================================
--- percona-toolkit-3.7.1-4.orig/Makefile.PL	2026-07-03 17:01:03.000000000 +0200
+++ percona-toolkit-3.7.1-4/Makefile.PL	2026-10-17 17:33:05.996984171 +0200
@@ -6,7 +6,7 @@
 pkgs = $(shell find src/go -type d -name "pt-*" -exec basename {} \;)
 
 gotools:
-	cd src/go && VERSION=$(VERSION) $(MAKE) build
