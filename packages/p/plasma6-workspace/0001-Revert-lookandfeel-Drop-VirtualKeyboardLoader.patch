From afb36ee23148feeb1b12c06a7359f18f18daf9c4 Mon Sep 17 00:00:00 2001
From: Fabian Vogt <fabian@ritter-vogt.de>
Date: Sun, 13 Sep 2026 20:55:07 +0200
Subject: [PATCH] Revert "lookandfeel: Drop VirtualKeyboardLoader"

This reverts commit f1c83d153768faf16a35993465957f3902534e3e.

SDDM may still run on X11.
---
 lookandfeel/CMakeLists.txt                    |   3 +
 lookandfeel/components/VirtualKeyboard.qml    |  69 ++++++++++
 .../components/VirtualKeyboardLoader.qml      | 122 ++++++++++++++++++
 .../components/VirtualKeyboard_wayland.qml    |  25 ++++
 4 files changed, 219 insertions(+)
 create mode 100644 lookandfeel/components/VirtualKeyboard.qml
 create mode 100644 lookandfeel/components/VirtualKeyboardLoader.qml
 create mode 100644 lookandfeel/components/VirtualKeyboard_wayland.qml

diff --git a/lookandfeel/CMakeLists.txt b/lookandfeel/CMakeLists.txt
index 822004bb18..1b76309531 100644
--- a/lookandfeel/CMakeLists.txt
+++ b/lookandfeel/CMakeLists.txt
@@ -12,6 +12,9 @@ ecm_target_qml_sources(components SOURCES
     components/SessionManagementScreen.qml
     components/UserDelegate.qml
     components/UserList.qml
+    components/VirtualKeyboard.qml
