From: Martin Pluskal <mpluskal@suse.com>
Subject: [PATCH] Disable the craft-update self-update install path

PATCH-FIX-OPENSUSE: photocraft-no-self-update.patch: upstream ships a
craft-update self-update client that installs upstream RPMs over distro
files (via zypper/rpm -U). Default automatic update checks to off
(opt-in via the preferences toggle) and remove the Update-and-Restart
install prompt, so no install-over-distro path remains on fresh
preferences. The manual Help check and the toggle itself stay.

--- a/crates/engine/src/cmd/updates_cmds.rs
+++ b/crates/engine/src/cmd/updates_cmds.rs
@@ -211,7 +211,7 @@
         s.execute("help.checkForUpdates", json!({})).unwrap();
         assert_eq!(s.execute("updates.status", json!({})).unwrap()["result"]["status"], "failed");
         s.load_prefs_json("{}").unwrap();
-        assert!(s.prefs().general.automatically_check_updates);
+        assert!(!s.prefs().general.automatically_check_updates);
         s.execute("prefs.set", json!({"path": "general.automaticallyCheckUpdates", "value": false})).unwrap();
         let saved = s.prefs_to_json();
         let mut restored = Session::new();
