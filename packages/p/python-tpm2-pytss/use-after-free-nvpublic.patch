From 1263a1552c1120e157ba3944aee7628797655a73 Mon Sep 17 00:00:00 2001
From: Steve Kowalik <steven@wedontsleep.org>
Date: Thu, 19 Nov 2026 15:04:25 +1100
Subject: [PATCH] fix(policy): copy TPMS_NV_PUBLIC in polauthnv callback

_policy_cb_exec_polauthnv wrapped the borrowed TPMS_NV_PUBLIC pointer
from libtss2-policy directly without copying it. Once Tss2_PolicyExecute
returns, libtss2-policy frees its temporary buffer, leaving any saved
TPMS_NV_PUBLIC instance with a dangling pointer. Copy the struct into
CFFI-managed memory so the Python object can safely outlive the
callback.

Signed-off-by: Steve Kowalik <steven@wedontsleep.org>
---
 src/tpm2_pytss/policy.py |  2 +-
 test/test_policy.py      | 20 ++++++++++++++++++++
 2 files changed, 21 insertions(+), 1 deletion(-)

diff --git a/src/tpm2_pytss/policy.py b/src/tpm2_pytss/policy.py
index cc6beadf..b044dc75 100644
--- a/src/tpm2_pytss/policy.py
+++ b/src/tpm2_pytss/policy.py
@@ -326,7 +326,7 @@ def _policy_cb_exec_polauthnv(nv_public, hash_alg, userdata):
     if not cb:
         return TSS2_RC.POLICY_RC_NULL_CALLBACK
     try:
-        nvp = TPMS_NV_PUBLIC(nv_public)
+        nvp = TPMS_NV_PUBLIC(ffi.new("TPMS_NV_PUBLIC *", nv_public[0]))
         halg = TPM2_ALG(hash_alg)
         cb(nvp, halg)
     except Exception as e:
diff --git a/test/test_policy.py b/test/test_policy.py
index d8a93a17..c7c96b1a 100644
--- a/test/test_policy.py
+++ b/test/test_policy.py
@@ -862,3 +862,23 @@ def bad_cb(*args):
             p.set_callback(policy_cb_types.EXEC_POLACTION, bad_cb)
             p.execute(self.ectx, session)
         self.assertEqual(str(e.exception), "callback exception")
+
+    def test_polauthnv_cb_copies_nv_public(self):
+        from tpm2_pytss.policy import _policy_cb_exec_polauthnv, ffi
+
+        src = ffi.new("TPMS_NV_PUBLIC *", {"nvIndex": 0x1000000})
+        captured = None
+
+        def cb(nv_public, hash_alg):
+            nonlocal captured
+            captured = nv_public
+
+        with policy('{"description": "", "policy": []}', TPM2_ALG.SHA256) as p:
+            p._callbacks[policy_cb_types.EXEC_POLAUTHNV] = cb
+            handle = ffi.new_handle(p)
+            rc = _policy_cb_exec_polauthnv(src, TPM2_ALG.SHA256, handle)
+            self.assertEqual(rc, TPM2_RC.SUCCESS)
+
+        # Simulate libtss2-policy freeing/reusing the buffer
+        src[0].nvIndex = 0xDEADBEEF
+        self.assertEqual(captured.nvIndex, 0x1000000)
