From 179d5b163ccbe312fd25c28b0501dbe24fcbd360 Mon Sep 17 00:00:00 2001
From: pawciobiel <pawciobiel@gmail.com>
Date: Fri, 12 Dec 2025 12:14:37 +0100
Subject: [PATCH] Migrate to Python 3.10+ and modernize packaging

* update code style with pyupgrade to py3.10+ and black formatting
* replace pkg_resources with packaging to fix deprecation warning
* migrate from setup.py to pyproject.toml only
* update .travis.yml to use py3.10+ on Ubuntu jammy
* bump version to 0.9.dev1
---
 .travis.yml              |  36 +++--------
 pyproject.toml           |  45 ++++++++++++++
 pytest_tornado/plugin.py | 129 +++++++++++++++++++++------------------
 setup.cfg                |   2 -
 setup.py                 |  43 -------------
 5 files changed, 124 insertions(+), 131 deletions(-)
 create mode 100644 pyproject.toml
 delete mode 100644 setup.cfg
 delete mode 100644 setup.py

diff --git a/.travis.yml b/.travis.yml
index 94b66ee..f28755f 100644
--- a/.travis.yml
+++ b/.travis.yml
@@ -1,25 +1,17 @@
 language: python
 cache: pip
-dist: xenial
+dist: jammy
 python:
-    - 2.7
-    - 3.5
-    - 3.6
-    - 3.7
-    - 3.8
+    - "3.10"
+    - "3.11"
+    - "3.12"
 env:
-    - TORNADO_VERSION=6.0 PYTEST_VERSION=5.2
-    - TORNADO_VERSION=6.0 PYTEST_VERSION=4.3
-    - TORNADO_VERSION=5.0 PYTEST_VERSION=5.2
-    - TORNADO_VERSION=5.0 PYTEST_VERSION=4.0
-    - TORNADO_VERSION=5.0.0 PYTEST_VERSION=3.6
-    - TORNADO_VERSION=5.0.0 PYTEST_VERSION=4.0.0
-    - TORNADO_VERSION=4.3.0 PYTEST_VERSION=3.6
-    - TORNADO_VERSION=4.1.0 PYTEST_VERSION=3.6.4
+    - TORNADO_VERSION=6.5 PYTEST_VERSION=9.0
+    - TORNADO_VERSION=6.4 PYTEST_VERSION=8.3
 install:
     - pip install tornado~=$TORNADO_VERSION pytest~=$PYTEST_VERSION
     - pip install PyOpenSSL  # used to create a cert for testing
-    - python setup.py install
+    - pip install -e .
     - pip install coverage coveralls
 script:
     - python test/create_cert.py --cert test/testcert.pem
@@ -29,21 +21,9 @@ after_success:
     - coveralls
 
 jobs:
-  exclude:
-    # Tornado 6 only supports Python >= 3.5
-    - python: 2.7
-      env: TORNADO_VERSION=6.0 PYTEST_VERSION=4.3
-    # Pytest 4.0.0 requires a version of attrs that does not work with Python 3.8.
-    - python: 3.8
-      env: TORNADO_VERSION=5.0.0 PYTEST_VERSION=4.0.0
-    # pytest 5 requires Python 3
-    - python: 2.7
-      env: TORNADO_VERSION=6.0 PYTEST_VERSION=5.2
-    - python: 2.7
-      env: TORNADO_VERSION=5.0 PYTEST_VERSION=5.2
   include:
     - stage: deploy
-      python: 3.7
+      python: "3.10"
       deploy:
         provider: pypi
         distributions: sdist bdist_wheel
diff --git a/pyproject.toml b/pyproject.toml
new file mode 100644
index 0000000..c775354
--- /dev/null
+++ b/pyproject.toml
@@ -0,0 +1,45 @@
+[build-system]
+requires = ["setuptools"]
+build-backend = "setuptools.build_meta"
+
+[project]
+name = "pytest-tornado"
+version = "0.8.1"
+description = "A py.test plugin providing fixtures and markers to simplify testing of asynchronous tornado applications."
+readme = "README.rst"
+requires-python = ">=3.10"
+license = {text = "Apache License, Version 2.0"}
+authors = [
+    {name = "Eugeniy Kalinin", email = "burump@gmail.com"}
+]
+maintainers = [
+    {name = "Vidar Tonaas Fauske", email = "vidartf@gmail.com"}
+]
+keywords = ["pytest", "py.test", "tornado", "async", "asynchronous", "testing", "unit tests", "plugin"]
+classifiers = [
+    "Development Status :: 5 - Production/Stable",
+    "Environment :: Plugins",
+    "Intended Audience :: Developers",
+    "License :: OSI Approved :: Apache Software License",
+    "Operating System :: OS Independent",
+    "Programming Language :: Python :: 3",
+    "Programming Language :: Python :: 3.10",
+    "Programming Language :: Python :: 3.11",
+    "Programming Language :: Python :: 3.12",
+    "Topic :: Software Development",
+    "Topic :: Software Development :: Testing",
+]
+dependencies = [
+    "pytest>=3.6",
+    "tornado>=4.1",
+    "packaging",
+]
+
+[project.urls]
+Homepage = "https://github.com/eugeniy/pytest-tornado"
+
+[project.entry-points.pytest11]
+tornado = "pytest_tornado.plugin"
+
+[tool.setuptools]
+packages = ["pytest_tornado"]
diff --git a/pytest_tornado/plugin.py b/pytest_tornado/plugin.py
