## Path:        Network/WWW/vinyl-cache
## Description: Startup parameters for vinyl-cache
## Type:        string
## Default:     "-j linux,user=vinyl-cache -f /etc/vinyl-cache/vcl.conf -T:6082 -s file,/var/cache/vinyl-cache,1M"
## Config:      vinyl-cache
#
VC_PARAMS="-j linux,user=vinyl-cache -f /etc/vinyl-cache/vcl.conf -T:6082 -s file,/var/cache/vinyl-cache,1M"

## Path:        Network/WWW/vinyl-cache
## Description: Startup parameters for vinyl-cache's logger
## Type:        string
## Default:     "-a -w /var/log/vinyl-cache/vinyl-cache.log"
## Config:      vinyl-cache
#
VL_PARAMS="-a -w /var/log/vinyl-cache/vinyl-cache.log"
