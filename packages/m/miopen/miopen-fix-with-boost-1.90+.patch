From b6b91cb3b7e4bf6ae7cbe7a401b2e096580c0ce0 Mon Sep 17 00:00:00 2001
From: Andreas Schneider <asn@cryptomilk.org>
Date: Sat, 18 Jul 2026 10:29:43 +0200
Subject: [PATCH] fix(miopen): Avoid explicit boost::optional ctor in list-init
 returns

With newer Boost releases, boost::optional<T> gained a perfect
forwarding constructor `explicit optional(U&& v)` that is a better
overload match than `optional(const T&)` for a non-const lvalue, because
it binds without adding a const qualifier. Since that constructor is
explicit, `return {some_lvalue};` (copy-list- initialization) fails to
compile with:

  error: chosen constructor is explicit in copy-initialization
---
 src/find_controls.cpp            | 2 +-
 src/include/miopen/sqlite_db.hpp | 4 ++--
 2 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/src/find_controls.cpp b/src/find_controls.cpp
--- a/src/find_controls.cpp
+++ b/src/find_controls.cpp
@@ -161,7 +161,7 @@
     if(res.empty())
         return boost::none;
     else
-        return {res};
+        return res;
 }

 } // namespace
diff --git a/src/include/miopen/sqlite_db.hpp b/src/include/miopen/sqlite_db.hpp
--- a/src/include/miopen/sqlite_db.hpp
+++ b/src/include/miopen/sqlite_db.hpp
@@ -463,7 +463,7 @@
                 ovr_rec.SetValues(vals.at(0), vals.at(1));
             }
             if(success)
-                return {ovr_rec};
+                return ovr_rec;
         }
         std::string clause;
         std::vector<std::string> values;
@@ -498,7 +498,7 @@
         if(rec.GetSize() == 0)
             return boost::none;
         else
-            return {rec};
+            return rec;
     }

     /// Removes ID with associated VALUES from record with key PROBLEM_CONFIG from db.
--
2.51.0
