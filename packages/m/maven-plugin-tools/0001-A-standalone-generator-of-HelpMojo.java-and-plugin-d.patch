+    @Test
+    void testFindOnRuntimeClasspath() throws Exception {
+        String originalClasspath = System.getProperty("java.class.path");
+        try {
+            File tempRoot = Files.createTempDirectory("reactor-root").toFile();
+            tempRoot.deleteOnExit();
+
+            File moduleClasses = new File(tempRoot, "maven-surefire-common/target/classes");
+            moduleClasses.mkdirs();
+
+            File libDir = new File(tempRoot, "lib");
+            libDir.mkdirs();
+            File jarFile = new File(libDir, "guava-31.1.jar");
+            jarFile.createNewFile();
+
+            // regression check: "maven-model" must not match "maven-model-builder-3.9.16.jar",
+            // a different artifact that merely shares a hyphen-separated prefix
+            File decoyJarFile = new File(libDir, "maven-model-builder-3.9.16.jar");
+            decoyJarFile.createNewFile();
+            File realJarFile = new File(libDir, "maven-model-3.9.16.jar");
+            realJarFile.createNewFile();
+
+            System.setProperty(
+                    "java.class.path",
+                    moduleClasses.getAbsolutePath()
+                            + File.pathSeparator
+                            + jarFile.getAbsolutePath()
+                            + File.pathSeparator
+                            + decoyJarFile.getAbsolutePath()
+                            + File.pathSeparator
+                            + realJarFile.getAbsolutePath());
+
+            File resolvedDir = StandaloneDescriptorGenerator.findOnRuntimeClasspath("maven-surefire-common");
+            assertNotNull(resolvedDir);
+            assertEquals(moduleClasses.getAbsolutePath(), resolvedDir.getAbsolutePath());
+
+            File resolvedJar = StandaloneDescriptorGenerator.findOnRuntimeClasspath("guava");
+            assertNotNull(resolvedJar);
+            assertEquals(jarFile.getAbsolutePath(), resolvedJar.getAbsolutePath());
+
+            File resolvedModel = StandaloneDescriptorGenerator.findOnRuntimeClasspath("maven-model");
+            assertNotNull(resolvedModel);
+            assertEquals(realJarFile.getAbsolutePath(), resolvedModel.getAbsolutePath());
+
+            assertNull(StandaloneDescriptorGenerator.findOnRuntimeClasspath("non-existent"));
+        } finally {
+            if (originalClasspath != null) {
+                System.setProperty("java.class.path", originalClasspath);
+            }
+        }
+    }
