+package org.apache.maven.plugin.plugin;
+
+import java.io.File;
+import java.io.InputStream;
+import java.nio.file.Files;
+import java.util.Collections;
+import java.util.HashSet;
+import java.util.LinkedHashMap;
+import java.util.Map;
+import java.util.Set;
+
+import org.apache.maven.model.Build;
+import org.apache.maven.model.Model;
+import org.apache.maven.model.io.xpp3.MavenXpp3Reader;
+import org.apache.maven.plugin.descriptor.PluginDescriptor;
+import org.apache.maven.project.MavenProject;
+import org.apache.maven.tools.plugin.DefaultPluginToolsRequest;
+import org.apache.maven.tools.plugin.extractor.annotations.JavaAnnotationsMojoDescriptorExtractor;
+import org.apache.maven.tools.plugin.extractor.annotations.converter.JavadocBlockTagsToXhtmlConverter;
+import org.apache.maven.tools.plugin.extractor.annotations.converter.JavadocInlineTagsToXhtmlConverter;
+import org.apache.maven.tools.plugin.extractor.annotations.scanner.DefaultMojoAnnotationsScanner;
+import org.apache.maven.tools.plugin.generator.PluginDescriptorFilesGenerator;
+import org.apache.maven.tools.plugin.generator.PluginHelpGenerator;
+import org.apache.maven.tools.plugin.scanner.DefaultMojoScanner;
+import org.apache.maven.tools.plugin.scanner.MojoScanner;
+import org.codehaus.plexus.util.xml.Xpp3Dom;
+import org.codehaus.plexus.velocity.VelocityComponent;
+import org.eclipse.aether.DefaultRepositorySystemSession;
+import org.eclipse.aether.RepositorySystem;
+import org.eclipse.aether.repository.LocalRepository;
+import org.eclipse.aether.repository.LocalRepositoryManager;
+import org.eclipse.aether.resolution.ArtifactRequest;
+import org.eclipse.aether.resolution.ArtifactResult;
+
+/**
+ * Standalone container-free command-line runner to generate Maven plugin descriptors outside of a Sisu/Plexus DI container.
+ * This is extremely robust and suitable for bootstrapping and RPM build environments.
+ */
+public class StandaloneDescriptorGenerator {
+
+    public static void main(String[] args) {
+        if (args.length != 0 && args.length != 1 && args.length != 3 && args.length != 4) {
+            System.err.println(
+                    "Usage: java org.apache.maven.plugin.plugin.StandaloneDescriptorGenerator [<pomFile>] [<sourceDir> <classesDir> [<outputDir>]]");
+            System.err.println("Note: Valid argument counts are 0, 1, 3, or 4.");
+            System.exit(1);
+        }
+
+        try {
+            File pomFile =
+                    (args.length == 0) ? new File("pom.xml").getAbsoluteFile() : new File(args[0]).getAbsoluteFile();
+            File sourceDirectory = (args.length >= 3) ? new File(args[1]).getAbsoluteFile() : null;
+            File classesDirectory = (args.length >= 3) ? new File(args[2]).getAbsoluteFile() : null;
+            File outputDirectory = (args.length == 4) ? new File(args[3]).getAbsoluteFile() : null;
+            run(pomFile, sourceDirectory, classesDirectory, outputDirectory);
+        } catch (Exception e) {
+            e.printStackTrace();
+            System.exit(1);
+        }
+    }
+
+    /** Ant-invocable entry point for generating just {@code HelpMojo.java}. */
+    public static final class HelpMojoJava {
+        private HelpMojoJava() {}
+
+        public static void main(String[] args) {
+            if (args.length != 1 && args.length != 2) {
+                System.err.println("Usage: java " + HelpMojoJava.class.getName() + " <pomFile> [<classesDir>]");
+                System.exit(1);
+            }
+            try {
+                File pomFile = new File(args[0]).getAbsoluteFile();
+                if (args.length == 2) {
+                    generateHelpMojoJava(pomFile, new File(args[1]).getAbsoluteFile());
+                } else {
+                    generateHelpMojoJava(pomFile, null);
+                }
+            } catch (Exception e) {
+                e.printStackTrace();
+                System.exit(1);
+            }
+        }
+
+        /** No scan/compile needed - content is just groupId/artifactId/goalPrefix, so this can run
+         * as an early ant target before the normal compile. */
+        private static void generateHelpMojoJava(File pomFile, File classesDirectory) throws Exception {
+            System.out.println("=== Standalone HelpMojo.java Source Generation ===");
+            System.out.println("POM File: " + pomFile.getAbsolutePath());
+
+            Model model = readModel(pomFile);
+            Map<String, String> properties = new LinkedHashMap<>();
+            Map<String, String> managedVersions = new LinkedHashMap<>();
+            gatherPomChainInfo(pomFile, model, properties, managedVersions);
+
+            MavenProject project = newProject(model, pomFile, properties);
+            String goalPrefix = determineGoalPrefix(model, project, properties);
+            if (classesDirectory == null) {
+                classesDirectory = defaultClassesDirectory(pomFile.getParentFile(), model, properties);
+            }
+            generateHelpMojo(project, goalPrefix, classesDirectory);
+        }
+
+        private static void generateHelpMojo(MavenProject project, String goalPrefix, File classesDirectory) {
+            try {
+                System.out.println("Generating HelpMojo source code...");
+                // classesDirectory's parent is the project's target dir
+                File targetDir =
+                        classesDirectory.getParentFile() != null ? classesDirectory.getParentFile() : classesDirectory;
+                File generatedSourcesDirectory = new File(targetDir, "generated-sources/plugin");
+                PluginHelpGenerator helpGenerator = new PluginHelpGenerator()
+                        .setMavenProject(project)
+                        .setHelpPackageName(project.getGroupId() + "."
+                                + project.getArtifactId().replace("-", "_"))
+                        .setGoalPrefix(goalPrefix)
+                        .setVelocityComponent(createVelocityComponent());
+                helpGenerator.execute(generatedSourcesDirectory);
+                if (!project.getCompileSourceRoots().contains(generatedSourcesDirectory.getAbsolutePath())) {
+                    project.addCompileSourceRoot(generatedSourcesDirectory.getAbsolutePath());
+                }
+                System.out.println("Project Compile Source Roots: " + project.getCompileSourceRoots());
+                System.out.println(
+                        "SUCCESS: Generated HelpMojo.java at " + generatedSourcesDirectory.getAbsolutePath());
+            } catch (Exception e) {
+                System.err.println("Warning: Could not generate HelpMojo.java - " + e.getMessage());
+            }
+        }
+
+        private static VelocityComponent createVelocityComponent() throws Exception {
+            org.apache.velocity.app.VelocityEngine engine = new org.apache.velocity.app.VelocityEngine();
+            engine.setProperty("resource.loader", "class");
+            engine.setProperty(
+                    "class.resource.loader.class",
+                    "org.apache.velocity.runtime.resource.loader.ClasspathResourceLoader");
+            engine.init();
+
+            return (VelocityComponent) java.lang.reflect.Proxy.newProxyInstance(
+                    VelocityComponent.class.getClassLoader(),
+                    new Class<?>[] {VelocityComponent.class},
+                    (proxy, method, args) -> {
+                        if ("getEngine".equals(method.getName())) {
+                            return engine;
+                        }
+                        throw new UnsupportedOperationException();
+                    });
+        }
+    }
+
+    private static MavenProject newProject(Model model, File pomFile, Map<String, String> properties) {
+        MavenProject project = new MavenProject(model);
+        project.setFile(pomFile);
+        if (project.getGroupId() == null && model.getParent() != null) {
+            project.setGroupId(model.getParent().getGroupId());
+        }
+        if (project.getVersion() == null && model.getParent() != null) {
+            project.setVersion(model.getParent().getVersion());
+        }
+        // built-ins take precedence over any same-named property from the POM/parent chain
+        properties.put("project.groupId", project.getGroupId());
+        properties.put("project.artifactId", project.getArtifactId());
+        properties.put("project.version", project.getVersion());
+        return project;
+    }
+
+    private static String determineGoalPrefix(Model model, MavenProject project, Map<String, String> properties) {
+        String goalPrefix = interpolate(findGoalPrefix(model), properties);
+        if (goalPrefix == null || goalPrefix.isEmpty()) {
+            goalPrefix = AbstractGeneratorMojo.getDefaultGoalPrefix(project);
+        }
+        return (goalPrefix == null || goalPrefix.isEmpty()) ? "plugin" : goalPrefix;
+    }
+
+    public static void run(File pomFile) throws Exception {
+        run(pomFile, null, null, null);
+    }
+
+    public static void run(File pomFile, File sourceDirectory, File classesDirectory) throws Exception {
+        run(pomFile, sourceDirectory, classesDirectory, null);
+    }
+
+    /** Any directory arg may be null - defaults are filled in below, after a single POM parse. */
+    public static void run(File pomFile, File sourceDirectory, File classesDirectory, File outputDirectory)
+            throws Exception {
+        System.out.println("=== Standalone Container-Free Plugin Descriptor Generation Starting ===");
+        System.out.println("POM File:          " + pomFile.getAbsolutePath());
+
+        // 1. Parse POM using MavenXpp3Reader
+        System.out.println("Parsing POM...");
+        Model model = readModel(pomFile);
+
+        // so ${...} references and unversioned dependencies resolve instead of leaking through raw
+        Map<String, String> properties = new LinkedHashMap<>();
+        Map<String, String> managedVersions = new LinkedHashMap<>();
+        gatherPomChainInfo(pomFile, model, properties, managedVersions);
+
+        File[] dirs =
+                resolveDirectories(pomFile, model, properties, sourceDirectory, classesDirectory, outputDirectory);
+        sourceDirectory = dirs[0];
+        classesDirectory = dirs[1];
+        outputDirectory = dirs[2];
+
+        // 2. Setup a minimal Aether RepositorySystem/Session (see createMinimalRepositorySystem for why
+        // this doesn't need any real resolver implementation on the classpath)
+        RepositorySystem repoSystem = createMinimalRepositorySystem();
+        DefaultRepositorySystemSession repoSession = createRepositorySession(repoSystem);
+
+        // 3. Setup MavenProject with parsed model values
+        MavenProject project = newProject(model, pomFile, properties);
+
+        org.apache.maven.artifact.handler.ArtifactHandler projectHandler =
+                new org.apache.maven.artifact.handler.DefaultArtifactHandler("maven-plugin");
+        org.apache.maven.artifact.Artifact projectArtifact = new org.apache.maven.artifact.DefaultArtifact(
+                project.getGroupId(),
+                project.getArtifactId(),
+                project.getVersion(),
+                null,
+                "maven-plugin",
+                "",
+                projectHandler);
+        project.setArtifact(projectArtifact);
+
+        Build build = new Build();
+        // classesDirectory is target/classes by convention, so its parent is target/ -
+        // outputDirectory's parent (classes/META-INF) is NOT the same thing and misplaces plugin-enhanced.xml
+        File targetDirectory =
+                classesDirectory.getParentFile() != null ? classesDirectory.getParentFile() : classesDirectory;
+        build.setDirectory(targetDirectory.getAbsolutePath());
+        build.setOutputDirectory(classesDirectory.getAbsolutePath());
+        project.setBuild(build);
+        project.addCompileSourceRoot(sourceDirectory.getAbsolutePath());
+
+        project.setArtifacts(populateDependencies(model, project, properties, managedVersions));
+
+        // 4. Manually wire up MojoScanner and extractors container-free
+        System.out.println("Manually wiring MojoScanner...");
+        JavadocInlineTagsToXhtmlConverter inlineTagsConverter =
+                new JavadocInlineTagsToXhtmlConverter(Collections.emptyMap());
+        JavadocBlockTagsToXhtmlConverter blockTagsConverter =
+                new JavadocBlockTagsToXhtmlConverter(inlineTagsConverter, Collections.emptyMap());
+
+        org.codehaus.plexus.archiver.manager.ArchiverManager archiverManager = createArchiverManager();
+
+        JavaAnnotationsMojoDescriptorExtractor extractor = new JavaAnnotationsMojoDescriptorExtractor();
+        setField(extractor, "mojoAnnotationsScanner", new DefaultMojoAnnotationsScanner());
+        setField(extractor, "javadocInlineTagsToHtmlConverter", inlineTagsConverter);
+        setField(extractor, "javadocBlockTagsToHtmlConverter", blockTagsConverter);
+        setField(extractor, "repositorySystem", repoSystem);
+        setField(extractor, "archiverManager", archiverManager);
+
+        MojoScanner mojoScanner = new DefaultMojoScanner(Collections.singletonMap("java-annotations", extractor));
+
+        // 5. Setup PluginDescriptor
+        PluginDescriptor pluginDescriptor = buildPluginDescriptor(project, model, properties);
+
+        DefaultPluginToolsRequest request = new DefaultPluginToolsRequest(project, pluginDescriptor);
+        request.setRepoSession(repoSession);
+        request.setEncoding("UTF-8");
+        request.setSkipErrorNoDescriptorsFound(true);
+        // without this, inherited @Parameter fields from a Mojo superclass in another artifact are dropped
+        request.setDependencies(buildScanArtifacts(project.getArtifacts()));
+
+        // 6. Populate Descriptor using MojoScanner
+        System.out.println("Scanning Mojos...");
+        mojoScanner.populatePluginDescriptor(request);
+        System.out.println("Scan complete. Found " + pluginDescriptor.getMojos().size() + " Mojos.");
+
+        // Generate v4 factories if there are any v4 Mojos
+        outputDirectory.mkdirs();
+        for (org.apache.maven.plugin.descriptor.MojoDescriptor md : pluginDescriptor.getMojos()) {
+            if (md instanceof org.apache.maven.tools.plugin.ExtendedMojoDescriptor
+                    && ((org.apache.maven.tools.plugin.ExtendedMojoDescriptor) md).isV4Api()) {
+                generateV4Factory(md, classesDirectory);
+            }
+        }
+        // without this, Maven 4's DI container can't bind the v4 factories and Mojo lookup fails
+        generateV4DiIndex(classesDirectory, outputDirectory);
+
+        // 7. Generate Descriptor
+        System.out.println("Generating descriptor files...");
+        PluginDescriptorFilesGenerator generator = new PluginDescriptorFilesGenerator();
+        generator.execute(outputDirectory, request);
+
+        File generatedFile = new File(outputDirectory, "plugin.xml");
+        if (generatedFile.exists()) {
+            System.out.println("SUCCESS: Generated descriptor at " + generatedFile.getAbsolutePath());
+        } else {
+            System.err.println("FAILED: Descriptor was not generated.");
+            System.exit(1);
+        }
+    }
+
+    private static void generateV4Factory(org.apache.maven.plugin.descriptor.MojoDescriptor md, File classesDirectory)
+            throws Exception {
+        String mojoClassName = md.getImplementation();
+        String packageName = mojoClassName.substring(0, mojoClassName.lastIndexOf('.'));
+        String generatorClassName = mojoClassName.substring(mojoClassName.lastIndexOf('.') + 1) + "Factory";
+        String mojoName = md.getId();
+
+        System.out.println("Generating v4 factory for " + mojoClassName);
+
+        byte[] bin = DescriptorGeneratorMojo.computeGeneratorClassBytes(
+                packageName, generatorClassName, mojoName, mojoClassName);
+
+        File packageDir = new File(classesDirectory, packageName.replace('.', '/'));
+        packageDir.mkdirs();
+        File classFile = new File(packageDir, generatorClassName + ".class");
+        java.nio.file.Files.write(classFile.toPath(), bin);
+        System.out.println("Generated factory class: " + classFile.getAbsolutePath());
+    }
+
+    /** ASM-scans for {@code @org.apache.maven.api.di.Named} classes, writing their FQCNs to
+     * {@code outputDirectory/org.apache.maven.api.di.Inject} - the index Maven 4's DI container
+     * needs to bind them. */
+    static void generateV4DiIndex(File classesDirectory, File outputDirectory) throws Exception {
+        java.util.Set<String> diBeans = new java.util.TreeSet<>();
+        try (java.util.stream.Stream<java.nio.file.Path> paths = java.nio.file.Files.walk(classesDirectory.toPath())) {
+            java.util.List<java.nio.file.Path> classFiles = paths.filter(
+                            p -> p.getFileName().toString().endsWith(".class"))
+                    .collect(java.util.stream.Collectors.toList());
+            for (java.nio.file.Path classFile : classFiles) {
+                try (InputStream is = java.nio.file.Files.newInputStream(classFile)) {
+                    org.objectweb.asm.ClassReader reader = new org.objectweb.asm.ClassReader(is);
+                    reader.accept(
+                            new org.objectweb.asm.ClassVisitor(org.objectweb.asm.Opcodes.ASM9) {
+                                private String internalName;
+
+                                @Override
+                                public void visit(
+                                        int version,
+                                        int access,
+                                        String name,
+                                        String signature,
+                                        String superName,
+                                        String[] interfaces) {
+                                    super.visit(version, access, name, signature, superName, interfaces);
+                                    internalName = name;
+                                }
+
+                                @Override
+                                public org.objectweb.asm.AnnotationVisitor visitAnnotation(
+                                        String descriptor, boolean visible) {
+                                    if ("Lorg/apache/maven/api/di/Named;".equals(descriptor)) {
+                                        diBeans.add(internalName.replace('/', '.'));
+                                    }
+                                    return null;
+                                }
+                            },
+                            org.objectweb.asm.ClassReader.SKIP_FRAMES
+                                    | org.objectweb.asm.ClassReader.SKIP_CODE
+                                    | org.objectweb.asm.ClassReader.SKIP_DEBUG);
+                }
+            }
+        }
+
+        File indexFile = new File(outputDirectory, "org.apache.maven.api.di.Inject");
+        if (diBeans.isEmpty()) {
+            java.nio.file.Files.deleteIfExists(indexFile.toPath());
+        } else {
+            StringBuilder content = new StringBuilder();
+            for (String bean : diBeans) {
+                content.append(bean).append(System.lineSeparator());
+            }
+            java.nio.file.Files.write(
+                    indexFile.toPath(), content.toString().getBytes(java.nio.charset.StandardCharsets.UTF_8));
+        }
+    }
+
+    private static void setField(Object target, String fieldName, Object value) throws Exception {
+        java.lang.reflect.Field field = target.getClass().getDeclaredField(fieldName);
+        field.setAccessible(true);
+        field.set(target, value);
+    }
+
+    private static PluginDescriptor buildPluginDescriptor(
+            MavenProject project, Model model, Map<String, String> properties) {
+        PluginDescriptor pluginDescriptor = new PluginDescriptor();
+        pluginDescriptor.setGroupId(project.getGroupId());
+        pluginDescriptor.setArtifactId(project.getArtifactId());
+        pluginDescriptor.setVersion(project.getVersion());
+
+        pluginDescriptor.setGoalPrefix(determineGoalPrefix(model, project, properties));
+
+        pluginDescriptor.setName(project.getName());
+        pluginDescriptor.setDescription(project.getDescription());
+        pluginDescriptor.setDependencies(
+                org.apache.maven.tools.plugin.generator.GeneratorUtils.toComponentDependencies(project.getArtifacts()));
+
+        if (project.getPrerequisites() != null) {
+            String requiredMavenVersion = interpolate(project.getPrerequisites().getMaven(), properties);
+            if (requiredMavenVersion != null) {
+                pluginDescriptor.setRequiredMavenVersion(requiredMavenVersion);
+            }
+        }
+        // merged properties, not just this POM's own, so a parent-declared javaVersion is picked up
+        String javaVersion = properties.get("javaVersion");
+        if (javaVersion != null) {
+            if ("8".equals(javaVersion)) {
+                javaVersion = "1.8";
+            }
+            pluginDescriptor.setRequiredJavaVersion(javaVersion);
+        }
+        return pluginDescriptor;
+    }
+
+    /** Fills in any of sourceDirectory/classesDirectory/outputDirectory that's null with a POM/convention
+     * default, returned as {source, classes, output}. */
+    private static File[] resolveDirectories(
+            File pomFile,
+            Model model,
+            Map<String, String> properties,
+            File sourceDirectory,
+            File classesDirectory,
+            File outputDirectory) {
+        File baseDir = pomFile.getParentFile();
+        if (sourceDirectory == null) {
+            sourceDirectory = defaultSourceDirectory(baseDir, model, properties);
+        }
+        if (classesDirectory == null) {
+            classesDirectory = defaultClassesDirectory(baseDir, model, properties);
+        }
+        if (outputDirectory == null) {
+            outputDirectory = new File(classesDirectory, "META-INF/maven").getAbsoluteFile();
+        }
+        System.out.println("Source Directory:  " + sourceDirectory.getAbsolutePath());
+        System.out.println("Classes Directory: " + classesDirectory.getAbsolutePath());
+        System.out.println("Output Directory:  " + outputDirectory.getAbsolutePath());
+        return new File[] {sourceDirectory, classesDirectory, outputDirectory};
+    }
+
+    private static File defaultSourceDirectory(File baseDir, Model model, Map<String, String> properties) {
+        return (model.getBuild() != null && model.getBuild().getSourceDirectory() != null)
+                ? new File(baseDir, interpolate(model.getBuild().getSourceDirectory(), properties)).getAbsoluteFile()
+                : new File(baseDir, "src/main/java").getAbsoluteFile();
+    }
+
+    private static File defaultClassesDirectory(File baseDir, Model model, Map<String, String> properties) {
+        return (model.getBuild() != null && model.getBuild().getOutputDirectory() != null)
+                ? new File(baseDir, interpolate(model.getBuild().getOutputDirectory(), properties)).getAbsoluteFile()
+                : new File(baseDir, "target/classes").getAbsoluteFile();
+    }
+
+    private static Model readModel(File pomFile) throws Exception {
+        MavenXpp3Reader pomReader = new MavenXpp3Reader();
+        try (InputStream is = Files.newInputStream(pomFile.toPath())) {
+            return pomReader.read(is);
+        }
+    }
+
+    /** Merges {@code <properties>} and {@code <dependencyManagement>} up the parent chain (child
+     * wins), via {@code relativePath} then XMvn for external parents. One walk for both maps, to
+     * avoid duplicate warnings. */
+    static void gatherPomChainInfo(
+            File pomFile, Model model, Map<String, String> properties, Map<String, String> managedVersions) {
+        walkParentChain(pomFile, model, m -> {
+            putAllIfAbsent(properties, propertiesOf(m));
+            addManagedVersions(managedVersions, m);
+        });
+    }
+
+    private static void addManagedVersions(Map<String, String> managedVersions, Model model) {
+        if (model.getDependencyManagement() == null) {
+            return;
+        }
+        for (org.apache.maven.model.Dependency managed :
+                model.getDependencyManagement().getDependencies()) {
+            managedVersions.putIfAbsent(managed.getGroupId() + ":" + managed.getArtifactId(), managed.getVersion());
+        }
+    }
+
+    private static void walkParentChain(File pomFile, Model model, java.util.function.Consumer<Model> visitor) {
+        visitor.accept(model);
+
+        Set<String> visitedPoms = new HashSet<>();
+        visitedPoms.add(canonicalPath(pomFile));
+
+        File currentPomFile = pomFile;
+        org.apache.maven.model.Parent parent = model.getParent();
+        while (parent != null) {
+            File parentPomFile = resolveParentPomFile(currentPomFile, parent);
+            if (parentPomFile == null || !visitedPoms.add(canonicalPath(parentPomFile))) {
+                break;
+            }
+            Model parentModel;
+            try {
+                parentModel = readModel(parentPomFile);
+            } catch (Exception e) {
+                System.err.println("Warning: could not read parent POM " + parentPomFile + " - " + e);
+                break;
+            }
+            visitor.accept(parentModel);
+            currentPomFile = parentPomFile;
+            parent = parentModel.getParent();
+        }
+    }
+
+    private static String canonicalPath(File file) {
+        try {
+            return file.getCanonicalPath();
+        } catch (java.io.IOException e) {
+            return file.getAbsolutePath();
+        }
+    }
+
+    private static Map<String, String> propertiesOf(Model model) {
+        Map<String, String> result = new LinkedHashMap<>();
+        if (model.getProperties() != null) {
+            for (String name : model.getProperties().stringPropertyNames()) {
+                result.put(name, model.getProperties().getProperty(name));
+            }
+        }
+        return result;
+    }
+
+    private static void putAllIfAbsent(Map<String, String> target, Map<String, String> source) {
+        for (Map.Entry<String, String> entry : source.entrySet()) {
+            target.putIfAbsent(entry.getKey(), entry.getValue());
+        }
+    }
+
+    private static File resolveParentPomFile(File childPomFile, org.apache.maven.model.Parent parent) {
+        String relativePath = parent.getRelativePath();
+        if (relativePath == null || relativePath.isEmpty()) {
+            relativePath = "../pom.xml";
+        }
+        File parentDir = childPomFile.getAbsoluteFile().getParentFile();
+        File candidate = new File(parentDir, relativePath);
+        if (candidate.isDirectory()) {
+            candidate = new File(candidate, "pom.xml");
+        }
+        if (candidate.isFile()) {
+            return candidate;
+        }
+        return resolveParentPomViaXMvn(parent.getGroupId(), parent.getArtifactId(), parent.getVersion());
+    }
+
+    /** Resolves an external parent POM (e.g. org.apache:apache) via XMvn, mirroring
+     * pom_properties.py's get_parent_pom() - independent of {@link #createMinimalRepositorySystem}. */
+    private static File resolveParentPomViaXMvn(String groupId, String artifactId, String version) {
+        return resolveArtifactViaXMvn(groupId, artifactId, "pom", version);
+    }
+
+    /**
+     * Resolves any system-package-installed artifact (POM or jar) via XMvn's {@code Resolver}, which
+     * maps groupId:artifactId back to a real file regardless of its actual name on disk - more
+     * reliable than {@link #findOnRuntimeClasspath}'s filename heuristic for oddly-named jars.
+     */
+    private static File resolveArtifactViaXMvn(String groupId, String artifactId, String extension, String version) {
+        try {
+            Class<?> factoryClass = Class.forName("org.fedoraproject.xmvn.locator.ServiceLocatorFactory");
+            Object factory = factoryClass.getDeclaredConstructor().newInstance();
+            Object serviceLocator =
+                    factoryClass.getMethod("createServiceLocator").invoke(factory);
+
+            Class<?> resolverClass = Class.forName("org.fedoraproject.xmvn.resolver.Resolver");
+            Object resolver = serviceLocator
+                    .getClass()
+                    .getMethod("getService", Class.class)
+                    .invoke(serviceLocator, resolverClass);
+            if (resolver == null) {
+                return null;
+            }
+
+            Class<?> artifactInterface = Class.forName("org.fedoraproject.xmvn.artifact.Artifact");
+            Class<?> defaultArtifactClass = Class.forName("org.fedoraproject.xmvn.artifact.DefaultArtifact");
+            Object artifact = defaultArtifactClass
+                    .getConstructor(String.class, String.class, String.class, String.class, String.class)
+                    .newInstance(groupId, artifactId, extension, null, version);
+
+            Class<?> requestClass = Class.forName("org.fedoraproject.xmvn.resolver.ResolutionRequest");
+            Object request = requestClass.getConstructor(artifactInterface).newInstance(artifact);
+
+            Object result = resolverClass.getMethod("resolve", requestClass).invoke(resolver, request);
+            if (result == null) {
+                return null;
+            }
+            Class<?> resultClass = Class.forName("org.fedoraproject.xmvn.resolver.ResolutionResult");
+            Object path = resultClass.getMethod("getArtifactPath").invoke(result);
+            return path != null ? ((java.nio.file.Path) path).toFile() : null;
+        } catch (Exception | LinkageError e) {
+            Throwable cause =
+                    e instanceof java.lang.reflect.InvocationTargetException && e.getCause() != null ? e.getCause() : e;
+            System.err.println("Warning: could not resolve " + groupId + ":" + artifactId + ":" + extension + ":"
+                    + version + " via XMvn - " + cause);
+            return null;
+        }
+    }
+
+    /** Repeatedly substitutes {@code ${key}} placeholders from {@code properties}; a handful of passes
+     * covers a property value that itself references another property. */
+    static String interpolate(String value, Map<String, String> properties) {
+        if (value == null || !value.contains("${")) {
+            return value;
+        }
+        String result = value;
+        for (int pass = 0; pass < 5 && result.contains("${"); pass++) {
+            boolean changed = false;
+            for (Map.Entry<String, String> entry : properties.entrySet()) {
+                if (entry.getValue() == null) {
+                    continue;
+                }
+                String placeholder = "${" + entry.getKey() + "}";
+                if (result.contains(placeholder)) {
+                    result = result.replace(placeholder, entry.getValue());
+                    changed = true;
+                }
+            }
+            if (!changed) {
+                break;
+            }
+        }
+        return result;
+    }
+
+    static String findGoalPrefix(Model model) {
+        if (model.getBuild() == null) {
+            return null;
+        }
+
+        String prefix = findGoalPrefixInPlugins(model.getBuild().getPlugins());
+        if (prefix != null) {
+            return prefix;
+        }
+
+        if (model.getBuild().getPluginManagement() != null) {
+            prefix = findGoalPrefixInPlugins(
+                    model.getBuild().getPluginManagement().getPlugins());
+            if (prefix != null) {
+                return prefix;
+            }
+        }
+
+        return null;
+    }
+
+    private static String findGoalPrefixInPlugins(java.util.List<org.apache.maven.model.Plugin> plugins) {
+        if (plugins == null) {
+            return null;
+        }
+        for (org.apache.maven.model.Plugin plugin : plugins) {
+            if ("maven-plugin-plugin".equals(plugin.getArtifactId())) {
+                Object configuration = plugin.getConfiguration();
+                if (configuration instanceof Xpp3Dom) {
+                    Xpp3Dom dom = (Xpp3Dom) configuration;
+                    Xpp3Dom goalPrefixNode = dom.getChild("goalPrefix");
+                    if (goalPrefixNode != null) {
+                        return goalPrefixNode.getValue();
+                    }
+                }
+            }
+        }
+        return null;
+    }
+
+    private static Set<org.apache.maven.artifact.Artifact> populateDependencies(
+            Model model, MavenProject project, Map<String, String> properties, Map<String, String> managedVersions) {
+        Set<org.apache.maven.artifact.Artifact> artifacts = new HashSet<>();
+        java.util.List<String> missingOnClasspath = new java.util.ArrayList<>();
+        java.util.List<String> unresolvedProperties = new java.util.ArrayList<>();
+        java.util.List<String> guessedVersions = new java.util.ArrayList<>();
+        for (org.apache.maven.model.Dependency dep : model.getDependencies()) {
+            String scope = dep.getScope() != null ? dep.getScope() : "compile";
+            if ("test".equals(scope) || "provided".equals(scope)) {
+                continue;
+            }
+            String depGroupId = interpolate(dep.getGroupId(), properties);
+            String depVersion = interpolate(dep.getVersion(), properties);
+            if (depVersion == null) {
+                depVersion = interpolate(managedVersions.get(depGroupId + ":" + dep.getArtifactId()), properties);
+            }
+            boolean guessed = false;
+            if (depVersion == null && model.getParent() != null) {
+                depVersion = project.getVersion();
+                guessed = true;
+            }
+            // don't let an unresolvable property leak into the generated descriptor as literal "${...}" syntax
+            if ((depGroupId != null && depGroupId.contains("${"))
+                    || (depVersion != null && depVersion.contains("${"))) {
+                unresolvedProperties.add(dep.getGroupId() + ":" + dep.getArtifactId() + ":" + dep.getVersion());
+                if (depGroupId != null && depGroupId.contains("${")) {
+                    depGroupId = dep.getGroupId();
+                }
+                depVersion = null;
+                guessed = false;
+            }
+            if (guessed) {
+                guessedVersions.add(depGroupId + ":" + dep.getArtifactId());
+            }
+
+            String depType = dep.getType() != null ? dep.getType() : "jar";
+            org.apache.maven.artifact.handler.ArtifactHandler depHandler =
+                    new org.apache.maven.artifact.handler.DefaultArtifactHandler(depType);
+            org.apache.maven.artifact.Artifact art = new org.apache.maven.artifact.DefaultArtifact(
+                    depGroupId,
+                    dep.getArtifactId(),
+                    depVersion != null ? depVersion : "4.0.0-beta-3-SNAPSHOT",
+                    scope,
+                    depType,
+                    dep.getClassifier(),
+                    depHandler);
+            File resolvedFile = findOnRuntimeClasspath(dep.getArtifactId());
+            if (resolvedFile == null) {
+                // catches RPM-stripped naming, which the filename heuristic above can't match
+                resolvedFile = resolveArtifactViaXMvn(depGroupId, dep.getArtifactId(), depType, depVersion);
+            }
+            if (resolvedFile != null) {
+                art.setFile(resolvedFile);
+            } else {
+                missingOnClasspath.add(art.getGroupId() + ":" + art.getArtifactId() + ":" + art.getVersion());
+                art.setFile(new File("dummy.jar"));
+            }
+            artifacts.add(art);
+        }
+        if (!unresolvedProperties.isEmpty()) {
+            System.err.println("Warning: " + unresolvedProperties.size() + " dependencies have unresolved "
+                    + "${...} property references in groupId/version (not found anywhere in the reachable "
+                    + "parent chain), a placeholder version was used: " + String.join(", ", unresolvedProperties));
+        }
+        if (!guessedVersions.isEmpty()) {
+            System.err.println("Warning: " + guessedVersions.size() + " dependencies had no explicit or "
+                    + "dependencyManagement-provided version; guessed to match this project's own version as "
+                    + "a last resort (verify this is correct): " + String.join(", ", guessedVersions));
+        }
+        if (!missingOnClasspath.isEmpty()) {
+            System.err.println("Warning: " + missingOnClasspath.size() + " dependencies could not be name-matched "
+                    + "to a runtime classpath entry by groupId/artifactId (informational only - their descriptor "
+                    + "metadata is unaffected, and if the jar is genuinely on the classpath it still gets "
+                    + "scanned for inherited @Parameter fields via the broader classpath-wide set): "
+                    + String.join(", ", missingOnClasspath));
+        }
+        return artifacts;
+    }
+
+    /** Matches {@code artifactId} against {@code java.class.path} (a {@code .../<artifactId>/target/classes}
+     * dir, or a {@code <artifactId>[-version].jar}) - picks up reactor siblings Aether/XMvn can't resolve. */
+    static File findOnRuntimeClasspath(String artifactId) {
+        String classpath = System.getProperty("java.class.path", "");
+        for (String entry : classpath.split(File.pathSeparator)) {
+            if (entry.isEmpty()) {
+                continue;
+            }
+            File file = new File(entry);
+            if (file.isDirectory()) {
+                File targetDir = file.getParentFile();
+                File moduleDir = targetDir != null ? targetDir.getParentFile() : null;
+                if ("classes".equals(file.getName())
+                        && targetDir != null
+                        && "target".equals(targetDir.getName())
+                        && moduleDir != null
+                        && artifactId.equals(moduleDir.getName())) {
+                    return file;
+                }
+            } else if (file.isFile()) {
+                String name = file.getName();
+                String prefix = artifactId + "-";
+                // require a version digit after the prefix, else "maven-model" wrongly matches "maven-model-builder-*"
+                if (name.equals(artifactId + ".jar")
+                        || (name.startsWith(prefix)
+                                && name.length() > prefix.length()
+                                && Character.isDigit(name.charAt(prefix.length())))) {
+                    return file;
+                }
+            }
+        }
+        return null;
+    }
+
+    /** Widens the ASM scan set to the whole runtime classpath, not just POM dependencies
+     * {@link #findOnRuntimeClasspath} could name-match - catches oddly-named jars too. The
+     * descriptor's own {@code <dependencies>} metadata still uses {@code project.getArtifacts()}. */
+    static Set<org.apache.maven.artifact.Artifact> buildScanArtifacts(
+            Set<org.apache.maven.artifact.Artifact> declaredArtifacts) {
+        Set<org.apache.maven.artifact.Artifact> scanArtifacts = new HashSet<>(declaredArtifacts);
+
+        Set<String> alreadyCovered = new HashSet<>();
+        for (org.apache.maven.artifact.Artifact art : declaredArtifacts) {
+            if (art.getFile() != null && art.getFile().exists()) {
+                alreadyCovered.add(canonicalPath(art.getFile()));
+            }
+        }
+
+        String classpath = System.getProperty("java.class.path", "");
+        int index = 0;
+        for (String entry : classpath.split(File.pathSeparator)) {
+            if (entry.isEmpty()) {
+                continue;
+            }
+            File file = new File(entry);
+            if (!file.exists() || !alreadyCovered.add(canonicalPath(file))) {
+                continue;
+            }
+            index++;
+            org.apache.maven.artifact.handler.ArtifactHandler handler =
+                    new org.apache.maven.artifact.handler.DefaultArtifactHandler("jar");
+            // groupId/version are placeholders, just unique per entry so same-named jars don't collide in the Set
+            org.apache.maven.artifact.Artifact syntheticArt = new org.apache.maven.artifact.DefaultArtifact(
+                    "classpath-scan-" + index, file.getName(), "0", "compile", "jar", "", handler);
+            syntheticArt.setFile(file);
+            scanArtifacts.add(syntheticArt);
+        }
+        return scanArtifacts;
+    }
+
+    private static org.codehaus.plexus.archiver.manager.ArchiverManager createArchiverManager() {
+        return new org.codehaus.plexus.archiver.manager.ArchiverManager() {
+            @Override
+            public org.codehaus.plexus.archiver.Archiver getArchiver(String name)
+                    throws org.codehaus.plexus.archiver.manager.NoSuchArchiverException {
