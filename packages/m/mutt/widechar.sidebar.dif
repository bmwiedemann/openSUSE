--- handler.c
+++ handler.c	2026-09-07 12:16:24.792259574 +0000
@@ -781,7 +781,7 @@ static void enriched_set_flags(const wch
 static int text_enriched_handler(BODY *a, STATE *s)
 {
   enum {
