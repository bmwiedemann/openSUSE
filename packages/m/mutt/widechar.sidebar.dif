@@ -819,6 +819,8 @@ static int text_enriched_handler(BODY *a
 
     switch (state)
     {
+      case TEXT_GOTWC:
+        state = TEXT;
       case TEXT :
         switch (wc)
         {
@@ -880,9 +882,8 @@ static int text_enriched_handler(BODY *a
           enriched_flush(&stte, 1);
         else
         {
-          ungetwc(wc, s->fpin);
           bytes++;
-          state = TEXT;
+          state = TEXT_GOTWC;
         }
         break;
 
@@ -1589,7 +1590,7 @@ void mutt_decode_attachment(const BODY *
  * strip all trailing spaces to improve interoperability;
  * if $text_flowed is unset, simply verbatim copy input
  */
-static int text_plain_handler(BODY *b, STATE *s)
