@@ -811,7 +811,7 @@ static int text_enriched_handler(BODY *a
   {
     if (state != ST_EOF)
     {
-      if (!bytes || (wc = fgetwc(s->fpin)) == WEOF)
+      if (state != TEXT_GOTWC && !bytes || (wc = fgetwc(s->fpin)) == WEOF)
         state = ST_EOF;
