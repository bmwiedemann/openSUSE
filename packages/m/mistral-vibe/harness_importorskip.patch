From: Martin Pluskal <martin@pluskal.org>
Subject: skip the harness-only tests when the harness is absent

mistralai-vibe-local-harness is built by the maturin backend this package
does not run, so the distribution is not installed.  Guard the test modules
that import it at module scope with pytest.importorskip, the way upstream
already guards its other harness tests, so collection skips them instead of
erroring.

Index: mistral-vibe-2.25.7/tests/app_server/test_unified_harness_backend_adapter.py
===================================================================
--- mistral-vibe-2.25.7.orig/tests/app_server/test_unified_harness_backend_adapter.py
+++ mistral-vibe-2.25.7/tests/app_server/test_unified_harness_backend_adapter.py
@@ -17,6 +17,13 @@ from types import SimpleNamespace
 from typing import TYPE_CHECKING, Any, Literal, cast
 from unittest.mock import AsyncMock, Mock
 
+import pytest
+import tomli_w
+
+# mistralai-vibe-local-harness is an optional extra openSUSE does not ship:
+# skip instead of failing collection, like upstream's own harness guards.
+pytest.importorskip("mistralai_vibe_local_harness")
+
 import mistralai_vibe_local_harness.session_protocol as harness_session_protocol
 from mistralai_vibe_local_harness.vibe import (
     DeferredTurnPreparationContext as HarnessDeferredTurnPreparationContext,
@@ -25,8 +32,6 @@ from mistralai_vibe_local_harness.vibe i
     DeferredTurnStartParams as HarnessDeferredTurnStartParams,
     DeferredTurnStartResult as HarnessDeferredTurnStartResult,
 )
-import pytest
