<services>
	<service name="tar_scm" mode="manual">
		<param name="scm">git</param>
		<param name="url">https://github.com/VirusTotal/yara-x.git</param>
		<param name="revision">v1.23.0</param>
		<param name="match-tag">v*</param>
		<param name="versionformat">@PARENT_TAG@</param>
		<param name="versionrewrite-pattern">v(.*)</param>
		<param name="versionrewrite-replacement">\1</param>
		<param name="changesgenerate">disable</param>
		<param name="exclude">.github</param>
		<param name="exclude">.gitignore</param>
		<param name="exclude">.gitattributes</param>
		<param name="exclude">rustfmt.toml</param>
		<param name="package-meta">no</param>
	</service>
	<service name="tar" mode="manual"/>
	<service name="recompress" mode="manual">
		<param name="file">*.tar</param>
		<param name="compression">xz</param>
	</service>
	<service name="set_version" mode="manual"/>
	<service name="cargo_vendor" mode="manual">
		 <param name="srcdir">yara-x</param>
		 <param name="compression">zst</param>
		 <param name="update">true</param>
		 <param name="i-accept-the-risk">RUSTSEC-2023-0071</param>
		 <!-- RUSTSEC-2023-0071: https://github.com/VirusTotal/yara-x/issues/240#issuecomment-2467771773-->
	</service>
	<service name="cargo_audit" mode="manual"/>
</services>
