    <service name="go_modules" mode="manual">
        <!-- GO-2026-5932 has no fixed version and concerns x/crypto/openpgp,
             which git-bug replaced with the maintained ProtonMail fork upstream.
             Replacing all of x/crypto would also remove packages (such as ssh)
             still used by go-git. -->
        <param name="replace">golang.org/x/net=golang.org/x/net@v0.60.0</param>
    </service>
    <!-- Traditional osc workflow: archive the npm sources and declare each
         tarball in the generated spec include. No build-time downloads.
         node-sources.json is the reduced build inventory written by
         prepare-webui-lock.py: no prebuilt platform binaries. -->
    <service name="node_modules" mode="manual">
        <param name="input">node-sources.json</param>
        <param name="legacy-container">true</param>
        <param name="cpio">node_modules.obscpio</param>
        <param name="output">node_modules.spec.inc</param>
        <param name="source-offset">10000</param>
    </service>
    <!-- BEGIN native-addons: generated by native-addons.py, do not edit -->
    <!-- cargo_vendor keeps update=false on purpose. These crates only
         build Node-API modules that run during the RPM build to generate
         the Web UI assets; the modules are not packaged. Vendoring
         upstream's exact Cargo.lock keeps the dependency set upstream
         tested, and the spec builds in cargo's locked mode against it.
         Updates come with new upstream releases of the addons. -->
    <service name="tar_scm" mode="manual">
        <param name="scm">git</param>
        <param name="url">https://github.com/rolldown/rolldown.git</param>
        <param name="revision">v1.2.8</param>
        <param name="version">1.2.8</param>
        <param name="filename">rolldown</param>
    </service>
    <service name="recompress" mode="manual">
        <param name="file">rolldown-1.2.8.tar</param>
        <param name="compression">zst</param>
    </service>
    <service name="cargo_vendor" mode="manual">
        <param name="src">rolldown-1.2.8.tar.zst</param>
        <param name="tag">rolldown</param>
        <param name="compression">zst</param>
        <param name="filter">true</param>
        <param name="respect-lockfile">true</param>
        <param name="update">false</param>
    </service>
    <service name="tar_scm" mode="manual">
        <param name="scm">git</param>
        <param name="url">https://github.com/tailwindlabs/tailwindcss.git</param>
        <param name="revision">v4.3.3</param>
        <param name="version">4.3.3</param>
        <param name="filename">tailwindcss</param>
    </service>
    <service name="recompress" mode="manual">
        <param name="file">tailwindcss-4.3.3.tar</param>
        <param name="compression">zst</param>
    </service>
    <service name="cargo_vendor" mode="manual">
        <param name="src">tailwindcss-4.3.3.tar.zst</param>
        <param name="tag">tailwindcss</param>
        <param name="compression">zst</param>
        <param name="filter">true</param>
        <param name="respect-lockfile">true</param>
        <param name="update">false</param>
    </service>
    <service name="tar_scm" mode="manual">
        <param name="scm">git</param>
        <param name="url">https://github.com/parcel-bundler/lightningcss.git</param>
        <param name="revision">v1.33.0</param>
        <param name="version">1.33.0</param>
        <param name="filename">lightningcss</param>
    </service>
    <service name="recompress" mode="manual">
        <param name="file">lightningcss-1.33.0.tar</param>
        <param name="compression">zst</param>
    </service>
    <service name="cargo_vendor" mode="manual">
        <param name="src">lightningcss-1.33.0.tar.zst</param>
        <param name="tag">lightningcss</param>
        <param name="compression">zst</param>
        <param name="filter">true</param>
        <param name="respect-lockfile">true</param>
        <param name="update">false</param>
    </service>
    <!-- END native-addons -->
</services>
