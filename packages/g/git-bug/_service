    <service name="go_modules" mode="manual">
        <!-- v0.11.0 is upstream's latest release. govulncheck reports no
             reachable vulnerabilities. GO-2026-5932 has no fixed version
             and concerns x/crypto/openpgp, which git-bug replaced with the
             maintained ProtonMail fork upstream. Replacing all of x/crypto
             would also remove packages (such as ssh) still used by go-git. -->
    </service>
    <!-- Traditional osc workflow: archive the npm sources and declare each
         tarball in the generated spec include. No build-time downloads. -->
    <service name="node_modules" mode="manual">
        <param name="input">node-sources.json</param>
        <param name="legacy-container">true</param>
        <param name="cpio">node_modules.obscpio</param>
        <param name="output">node_modules.spec.inc</param>
        <param name="source-offset">10000</param>
    </service>
</services>
