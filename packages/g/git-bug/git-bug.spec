# The Web UI has only been validated on x86_64. Keep the CLI available
# elsewhere; enable other architectures after testing them, adding their
# Node-API platform suffix below.
%ifarch x86_64
%bcond_without webui
%global napi_triple linux-x64-gnu
%else
%bcond_with webui
%endif

Name:           git-bug
Version:        0.11.0
Release:        0
Summary:        Distributed, offline-first bug tracker embedded in git, with bridges
%if %{with webui}
# Conservative union of the frontend production dependency licenses. The
# notices collector includes dependencies even when Vite tree-shakes them.
License:        0BSD AND Apache-2.0 AND BSD-2-Clause AND BSD-3-Clause AND BlueOak-1.0.0 AND CC-BY-4.0 AND ISC AND MIT AND OFL-1.1 AND Python-2.0 AND Unlicense
%else
License:        MIT
%endif
URL:            https://github.com/git-bug/git-bug
Source0:        https://github.com/git-bug/%{name}/archive/refs/tags/v%{version}.tar.gz#/git-bug-%{version}.tar.gz
# Source0:        git-bug-%%{version}.tar.gz
Source1:        vendor.tar.gz
Source2:        package-lock.json
Source3:        webui-package.json
Source4:        node_modules.spec.inc
Source5:        test-webui.py
Source6:        node-sources.json
Source7:        pnpm-to-obs.py
Source8:        prepare-webui-lock.py
Source9:        test_pnpm_to_obs.py
Source10:       test_prepare_webui_lock.py
Source11:       webui-lock-report.json
Source12:       WEBUI-PACKAGING.md
Source13:       collect-webui-licenses.py
Source14:       test_collect_webui_licenses.py
Source15:       node-sources-full.json
Source16:       native-addons.py
Source17:       test_native_addons.py
Source18:       native-addons.spec.inc
BuildRequires:  git
BuildRequires:  golang(API) >= 1.26
BuildRequires:  golang-packaging
%if %{with webui}
# OBS/osc unpacks node_modules.obscpio into the source directory. This include
# declares its npm tarballs as individual sources for the source RPM. The
# inventory contains no prebuilt platform binaries.
%include %{_sourcedir}/node_modules.spec.inc
# Upstream Rust sources and vendored crates of the native npm addons
# (Rolldown, Tailwind CSS oxide, Lightning CSS), declared together with the
# %%{native_addons} list. Both are generated by native-addons.py.
%include %{_sourcedir}/native-addons.spec.inc
BuildRequires:  cargo
BuildRequires:  cmake
BuildRequires:  gcc
BuildRequires:  gcc-c++
BuildRequires:  local-npm-registry >= 1.1.0
BuildRequires:  make
BuildRequires:  nodejs24
BuildRequires:  npm24
BuildRequires:  python3-base
BuildRequires:  rust >= 1.98
BuildRequires:  zstd
%endif

%description
git-bug is a bug tracker that:

* is fully embedded in git: you only need your git repository to have
  a bug tracker
* is distributed: use your normal git remote to collaborate, push and
  pull your bugs!
* works offline: in a plane or under the sea? Keep reading and
  writing bugs!
* prevents vendor lock-in: your usual service is down or went bad?
  You already have a full backup.
* is fast: listing bugs or opening them is a matter of
  milliseconds
* doesn't pollute your project: no files are added in your
  project
* integrates with your tooling: use the UI you like (CLI,
  terminal, web) or integrate with your existing tools through
  the CLI or the GraphQL API
* bridges to other bug trackers: use bridges to import and export
  to other trackers.

%package bash-completion
Summary:        Bash completion for git-bug
Requires:       bash-completion
Requires:       %{name} = %{version}
Supplements:    (git-bug and bash-completion)
BuildArch:      noarch

%description bash-completion
Bash shell completions for git-bug

%package fish-completion
Summary:        Fish completion for git-bug
Requires:       fish
Requires:       %{name} = %{version}
Supplements:    (git-bug and fish)
BuildArch:      noarch

%description fish-completion
Fish shell completions for git-bug

%package zsh-completion
Summary:        ZSH completion for git-bug
Group:          Productivity/File utilities
Requires:       zsh
Requires:       %{name} = %{version}
Supplements:    (git-bug and zsh)
BuildArch:      noarch

%description zsh-completion
zsh shell completions for git-bug

%prep
%autosetup -p1 -a1
%if %{with webui}
# Use the npm-generated installation tree, not the service download inventory.
cp %{SOURCE2} webui/package-lock.json
cp %{SOURCE3} webui/package.json
# Unpack each native addon with only the crates directory of its vendor
# tarball. Upstream's Cargo.lock and .cargo/config.toml stay in effect;
# Lightning CSS sets its link flags there.
mkdir native
for addon in %{native_addons}; do
    IFS=, read -r name version crate library target manifest npm <<< "$addon"
    tar -C native -xf %{_sourcedir}/$name-$version.tar.zst
    tar -C native/$name-$version -xf %{_sourcedir}/vendor-$name.tar.zst vendor-$name
done
%endif

%build
export GOTOOLCHAIN=local
export GOPROXY=off
export GOSUMDB=off
export GOFLAGS="-mod=vendor -buildmode=pie"
%if %{with webui}
# Print name@version from a package.json file.
package_id() {
    python3 -c 'import json, sys; d = json.load(open(sys.argv[1])); print(d["name"] + "@" + d["version"])' "$1"
}
# Compile the Node-API modules of the native addons from source; npm's
# prebuilt platform packages are not in the sources. The modules only run
# during this build and are not packaged. Plain cargo keeps upstream's release
# profiles and project rustflags, which %%cargo_build overrides via RUSTFLAGS.
export CARGO_HOME="$PWD/.cargo-home"
for addon in %{native_addons}; do
    IFS=, read -r name version crate library target manifest npm <<< "$addon"
    pushd native/$name-$version
    test "$(package_id "$manifest")" = "$npm@$version"
    cargo build --release --offline --locked %{?_smp_mflags} -p "$crate" \
        --config "source.crates-io.replace-with='vendored-sources'" \
        --config "source.vendored-sources.directory='$PWD/vendor-$name'"
    popd
done
# Keep npm configuration and caches inside the build tree. All dependencies
# come from source tarballs served over loopback; disable install scripts.
export npm_config_cache="$PWD/.npm-cache"
export npm_config_userconfig="$PWD/.npmrc"
export npm_config_globalconfig="$PWD/.npmrc-global"
export npm_config_update_notifier=false
export NODE_OPTIONS="--max-old-space-size=1536"
pushd webui
local-npm-registry %{_sourcedir} ci \
    --include=dev --ignore-scripts --legacy-peer-deps \
    --no-audit --no-fund --maxsockets=2
# npm must not have installed any machine code.
python3 - <<'EOF'
import os, sys
found = [os.path.join(root, name) for root, _, names in os.walk("node_modules")
         for name in names if not os.path.islink(os.path.join(root, name))
         and open(os.path.join(root, name), "rb").read(4) == b"\x7fELF"]
sys.exit("Prebuilt ELF files from npm:\n" + "\n".join(found) if found else 0)
EOF
# Install the compiled modules where the npm loaders look first.
for addon in %{native_addons}; do
    IFS=, read -r name version crate library target manifest npm <<< "$addon"
    test "$(package_id node_modules/$npm/package.json)" = "$npm@$version"
    test -d "$(dirname "$target")"
    install -m 0755 ../native/$name-$version/target/release/$library \
        "$target.%{napi_triple}.node"
done
npm run build
test -s dist/index.html.gz
popd
python3 %{SOURCE13} webui webui-licenses
go build -tags webui
%else
go build
%endif

%install
install -Dm755 git-bug %{buildroot}%{_bindir}/git-bug
install -Dm644 -t %{buildroot}%{_mandir}/man1/ doc/man/*

# shell completions
install -Dm0644 misc/completion/bash/git-bug  \
    %{buildroot}%{_datadir}/bash-completion/completions/git-bug
install -Dm0644 misc/completion/fish/git-bug  \
    %{buildroot}%{_datadir}/fish/vendor_completions.d/git-bug.fish
install -Dm0644 misc/completion/zsh/git-bug  \
    %{buildroot}%{_sysconfdir}/zsh_completion.d/git-bug

%check
export GOTOOLCHAIN=local
export GOPROXY=off
export GOSUMDB=off
export GOFLAGS="-mod=vendor -buildmode=pie"
# The full suite includes network-dependent bridge tests (gh#git-bug/git-bug#1313).
# Run the offline Web UI handler tests without suppressing failures.
%if %{with webui}
go test -v -tags webui ./webui
python3 %{SOURCE5} ./git-bug
%else
go test -v ./webui
%endif

%files
%license LICENSE
%if %{with webui}
%license webui-licenses
%endif
%doc README.md
%{_bindir}/git-bug
%{_mandir}/man1/git*.1%{?ext_man}

%files bash-completion
%{_datadir}/bash-completion/completions/git-bug

%files fish-completion
%dir %{_datadir}/fish
%dir %{_datadir}/fish/vendor_completions.d
%{_datadir}/fish/vendor_completions.d/git-bug.fish

%files zsh-completion
%dir %{_sysconfdir}/zsh_completion.d
%config %{_sysconfdir}/zsh_completion.d/git-bug

%changelog
