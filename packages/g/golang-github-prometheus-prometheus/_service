<services>
  <service name="obs_scm" mode="manual">
    <param name="url">https://github.com/prometheus/prometheus.git</param>
    <param name="scm">git</param>
    <param name="exclude">.git</param>
    <param name="exclude">go.work</param>
    <param name="exclude">go.work.sum</param>
    <param name="versionformat">@PARENT_TAG@</param>
    <param name="revision">refs/tags/v3.13.2</param>
    <param name="versionrewrite-pattern">v(.*)</param>
    <param name="match-tag">v3*</param>
  </service>
  <service name="go_modules" mode="manual">
    <param name="archive">prometheus-*.obscpio</param>
  </service>
  <!-- services below are running at buildtime -->
  <service name="tar" mode="buildtime">
  </service>
  <service name="recompress" mode="buildtime">
    <param name="file">*.tar</param>
    <param name="compression">gz</param>
  </service>
</services>
