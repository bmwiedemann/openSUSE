Index: gnutls-3.8.10/lib/constate.c
===================================================================
--- gnutls-3.8.10.orig/lib/constate.c
+++ gnutls-3.8.10/lib/constate.c
@@ -572,7 +572,14 @@ static int _gnutls_init_record_state(rec
 		return gnutls_assert_val(ret);
 	}
 
-	if (is_cipher_algo_allowed(params->cipher->id))
+	/* The service indicator must take into account both the cipher and
+	 * the MAC used for record authentication. AEAD cipher suites carry
+	 * the GNUTLS_MAC_AEAD placeholder, as authentication is provided by
+	 * the cipher itself, so the MAC check only applies to non-AEAD suites.
+	 */
+	if (is_cipher_algo_allowed(params->cipher->id) &&
+	    (params->mac->id == GNUTLS_MAC_AEAD ||
+	     is_mac_algo_approved_in_fips(params->mac->id)))
 		_gnutls_switch_fips_state(GNUTLS_FIPS140_OP_APPROVED);
 	else
 		_gnutls_switch_fips_state(GNUTLS_FIPS140_OP_NOT_APPROVED);
