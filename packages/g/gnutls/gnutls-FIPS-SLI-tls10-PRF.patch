===================================================================
--- gnutls-3.8.10.orig/lib/nettle/int/tls1-prf.c
+++ gnutls-3.8.10/lib/nettle/int/tls1-prf.c
@@ -116,6 +116,12 @@ int tls10_prf(size_t secret_size, const
 
 	memxor(dst, o1, length);
 
+	/* The TLS 1.0/1.1 PRF relies on HMAC-MD5 and HMAC-SHA1, and
