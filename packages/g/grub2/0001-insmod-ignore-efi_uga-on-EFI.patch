From cc02c7c0fbe95ee2726081a2d1b4d44d242e067e Mon Sep 17 00:00:00 2001
From: Michael Chang <mchang@suse.com>
Date: Tue, 22 Sep 2026 18:51:24 +0800
Subject: [PATCH] insmod: ignore efi_uga on EFI

Silently ignore insmod requests for efi_uga on EFI systems.

The module was removed after 2.16, but older generated grub.cfg files
may still try to load it. Avoid emitting an error to preserve boot
compatibility with existing configurations.
---
 grub-core/kern/corecmd.c | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/grub-core/kern/corecmd.c b/grub-core/kern/corecmd.c
index 62d434ba9..bde9548bf 100644
--- a/grub-core/kern/corecmd.c
+++ b/grub-core/kern/corecmd.c
@@ -81,6 +81,15 @@ grub_core_cmd_insmod (struct grub_command *cmd __attribute__ ((unused)),
   if (argc == 0)
     return grub_error (GRUB_ERR_BAD_ARGUMENT, N_("one argument expected"));
 
+#ifdef GRUB_MACHINE_EFI
+  /*
+   * efi_uga was removed after 2.16; silently ignore insmod requests for it
+   * so that grub.cfg files generated by older versions won't emit error.
+   */
+  if (grub_strcmp (argv[0], "efi_uga") == 0)
+    return GRUB_ERR_NONE;
+#endif
+
   if (argv[0][0] == '/' || argv[0][0] == '(' || argv[0][0] == '+')
     mod = grub_dl_load_file (argv[0]);
   else
-- 
2.55.0

