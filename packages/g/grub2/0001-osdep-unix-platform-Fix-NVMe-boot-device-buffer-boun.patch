From b83c1b1d0b7f9a65cd4f4f4cc80f58b3b8c3ede9 Mon Sep 17 00:00:00 2001
From: Michael Chang <mchang@suse.com>
Date: Thu, 8 Oct 2026 12:12:58 +0800
Subject: [PATCH 1/3] osdep/unix/platform: Fix NVMe boot-device buffer bounds
 and termination

In add_multiple_nvme_bootdevices(), multipath_boot was allocated with
xmalloc() and then used with strlen() before guaranteed initialization.
This could read uninitialized memory while computing append space.

The function also ended with "*--ptr = '\0'". If no entry was appended,
ptr still pointed to the buffer start, so the pre-decrement wrote before
the allocation.

Initialize the buffer with an empty string, keep it NUL-terminated after
each append, and remove the final pre-decrement write. Also tighten the
capacity check to use >= and add a bounds check for the non-splitter
path append.

Fixes: 0f13508bc ("ieee1275: support added for multiple nvme bootpaths")
Assisted-by: GitHub Copilot:gpt-5.3-codex
Signed-off-by: Michael Chang <mchang@suse.com>
Reviewed-by: Avnish Chouhan <avnish@linux.ibm.com>
Reviewed-by: Sudhakar Kuppusamy <sudhakar@linux.ibm.com>
---
 grub-core/osdep/unix/platform.c | 22 ++++++++++++++++++----
 1 file changed, 18 insertions(+), 4 deletions(-)

diff --git a/grub-core/osdep/unix/platform.c b/grub-core/osdep/unix/platform.c
index dc5270a7c..b79d3913d 100644
--- a/grub-core/osdep/unix/platform.c
+++ b/grub-core/osdep/unix/platform.c
@@ -271,11 +271,20 @@ add_multiple_nvme_bootdevices (const char *install_device)
     }
 
   ptr = multipath_boot = xmalloc (BOOTDEV_BUFFER);
+  *ptr = '\0';
   if (is_splitter == false && is_FC == false)
     {
+      size_t len;
       non_splitter_path = xasprintf ("%s/namespace@%x:1 ", get_ofpathname (dirR1), nsid);
-      memcpy (ptr, non_splitter_path, strlen (non_splitter_path));
-      ptr += strlen (non_splitter_path);
+      len = strlen (non_splitter_path);
+      if (len < BOOTDEV_BUFFER)
+	{
+	  memcpy (ptr, non_splitter_path, len);
+	  ptr += len;
+	  *ptr = '\0';
+	}
+      else
+	grub_util_warn (_("Maximum size of bootlist exceeded"));
       free (non_splitter_path);
     }
   else
@@ -290,7 +299,7 @@ add_multiple_nvme_bootdevices (const char *install_device)
                   grub_strstr (ep->d_name, dirR2) == NULL)
                 continue;
               path = xasprintf ("%s/namespace@%x ", get_ofpathname (ep->d_name), nsid);
-              if ((strlen (multipath_boot) + strlen (path)) > BOOTDEV_BUFFER)
+              if ((strlen (multipath_boot) + strlen (path)) >= BOOTDEV_BUFFER)
                 {
                   grub_util_warn (_("Maximum five entries are allowed in the bootlist"));
                   free (path);
@@ -298,11 +307,16 @@ add_multiple_nvme_bootdevices (const char *install_device)
                 }
               memcpy (ptr, path, strlen (path));
               ptr += strlen (path);
+	      *ptr = '\0';
               free (path);
             }
         }
     }
-  *--ptr = '\0';
+
+  /* Remove trailing space if present */
+  if (ptr > multipath_boot && *(ptr - 1) == ' ')
+    *(ptr - 1) = '\0';
+
   closedir (dp);
   free (sysfs_path);
   free (dirR1);
-- 
