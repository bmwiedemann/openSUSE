Index: grub-2.16/util/grub.d/20_linux_xen.in
===================================================================
--- grub-2.16.orig/util/grub.d/20_linux_xen.in
+++ grub-2.16/util/grub.d/20_linux_xen.in
@@ -222,7 +222,7 @@ linux_entry_xsm ()
     message="$(gettext_printf "Loading Xen %s with Linux %s ..." ${xen_version} ${version})"
     sed "s/^/$submenu_indentation/" <<-EOF
 	 	echo	'$(echo "$message" | grub_quote)'
-	 	chainloader  \$cmdpath/${xen_basename} ${xen_basename} $section
