From 808af0e115ce24ce17105428a9f90fbe63f0acae Mon Sep 17 00:00:00 2001
From: Gary Lin <glin@suse.com>
Date: Fri, 21 Aug 2026 09:15:17 +0000
Subject: [PATCH 2/5] verifiers: support in-place verification

By design, the verifiers framework stores and verifies the full file in
a private buffer when opening a file, then copies the data to the
caller's buffer during reads. This guarantees that unverified data never
reaches the caller's buffer. However, this behavior doubles memory
usage. As initrd sizes grow, some systems encounter out-of-memory (OOM)
errors during loading.

To mitigate OOM errors, introduce in-place verification to the verifiers
framework. This allows callers to verify files directly within their own
buffers, avoiding redundant allocations.

Add the `in_place` field to `struct grub_file_verifier` so a verifier
can mark itself as in-place-capable. Introduce `grub_verify_in_place()`
to run in-place-capable verifiers over a buffer into which the file has
already been loaded.

When a file is opened with `GRUB_FILE_TYPE_VERIFY_IN_PLACE`, verifiers
with `in_place = true` are skipped during opening. Once the file is
fully read, the caller is responsible for invoking
`grub_verify_in_place()`. If all verifiers registered for the file are
in-place-capable, allocating the private buffer is skipped entirely,
reducing peak memory usage.

Note that if any non-in-place-capable verifier is registered for the
file, the private buffer will still be allocated, leaving memory usage
unchanged.

Assisted-by: Claude:claude-opus-5 Gemini:gemini-3.5-flash
Signed-off-by: Gary Lin <glin@suse.com>
Reviewed-by: Avnish Chouhan <avnish@linux.ibm.com>
Reviewed-by: Leo Sandoval <lsandova@redhat.com>
Part-of: <https://gitlab.freedesktop.org/gnu-grub/grub/-/merge_requests/254>
---
 grub-core/kern/verifiers.c | 159 +++++++++++++++++++++++++++++++++++--
 include/grub/verify.h      |  18 +++++
 2 files changed, 169 insertions(+), 8 deletions(-)

diff --git a/grub-core/kern/verifiers.c b/grub-core/kern/verifiers.c
index 75d7994cf..89732427f 100644
--- a/grub-core/kern/verifiers.c
+++ b/grub-core/kern/verifiers.c
@@ -75,6 +75,32 @@ struct grub_fs verified_fs =
   .fs_close = verified_close
 };
 
+/*
+ * Files which are exempt from verification altogether, no matter which
+ * verifiers are registered. Shared by grub_verifiers_open() and
+ * grub_verify_in_place() so that both entry points agree on the exemptions.
+ */
+static bool
+grub_verifiers_exempt (grub_file_t io, enum grub_file_type type)
+{
+  if ((type & GRUB_FILE_TYPE_MASK) == GRUB_FILE_TYPE_SIGNATURE
+      || (type & GRUB_FILE_TYPE_MASK) == GRUB_FILE_TYPE_VERIFY_SIGNATURE
+      || (type & GRUB_FILE_TYPE_SKIP_SIGNATURE))
+    return true;
+
+  /*
+   * Files read from a memdisk are embedded in the (already verified) GRUB
+   * image and files read from procfs are generated by GRUB itself. Neither
+   * has a detached signature to check.
+   */
+  if (io->device && io->device->disk &&
+      (io->device->disk->dev->id == GRUB_DISK_DEVICE_MEMDISK_ID
+       || io->device->disk->dev->id == GRUB_DISK_DEVICE_PROCFS_ID))
+    return true;
+
+  return false;
+}
+
 static grub_file_t
 grub_verifiers_open (grub_file_t io, enum grub_file_type type)
 {
@@ -84,22 +110,42 @@ grub_verifiers_open (grub_file_t io, enum grub_file_type type)
   grub_file_t ret = 0;
   grub_err_t err;
   int defer = 0;
+  bool in_place = (type & GRUB_FILE_TYPE_VERIFY_IN_PLACE) != 0;
+  bool verify_pending = false;
 
-  grub_dprintf ("verify", "file: %s type: %d\n", io->name, type);
 
-  if ((type & GRUB_FILE_TYPE_MASK) == GRUB_FILE_TYPE_SIGNATURE
-      || (type & GRUB_FILE_TYPE_MASK) == GRUB_FILE_TYPE_VERIFY_SIGNATURE
-      || (type & GRUB_FILE_TYPE_SKIP_SIGNATURE))
-    return io;
+  /*
+   * VERIFY_IN_PLACE requires NO_DECOMPRESS: the verify filter runs before
+   * compression filters (GRUB_FILE_FILTER_VERIFY = 0), so without it
+   * grub_verifiers_open() would hash compressed bytes at open time while
+   * grub_verify_in_place() hashes decompressed bytes from the loaded buffer.
+   */
+  if (in_place && !(type & GRUB_FILE_TYPE_NO_DECOMPRESS))
+    {
+      grub_error (GRUB_ERR_BAD_ARGUMENT,
+		  "GRUB_FILE_TYPE_VERIFY_IN_PLACE requires GRUB_FILE_TYPE_NO_DECOMPRESS");
+      return NULL;
+    }
 
-  if (io->device->disk &&
-      (io->device->disk->dev->id == GRUB_DISK_DEVICE_MEMDISK_ID
-       || io->device->disk->dev->id == GRUB_DISK_DEVICE_PROCFS_ID))
+  grub_dprintf ("verify", "file: %s type: %d\n", io->name, type);
+
+  if (grub_verifiers_exempt (io, type))
     return io;
 
   FOR_LIST_ELEMENTS(ver, grub_file_verifiers)
     {
       enum grub_verify_flags flags = 0;
+
+      /*
+       * Run the verification in grub_verify_in_place() if both the caller
+       * and the verifier agree so.
+       */
+      if (in_place && ver->in_place)
+	{
+	  verify_pending = true;
+	  continue;
+	}
+
       err = ver->init (io, type, &context, &flags);
       if (err)
 	goto fail_noclose;
@@ -114,6 +160,10 @@ grub_verifiers_open (grub_file_t io, enum grub_file_type type)
 
   if (!ver)
     {
+      /*
+       * Note that an in-place verifier cannot satisfy a deferral: it only
+       * measures the file, it does not decide whether the file is allowed.
+       */
       if (defer)
 	{
 	  grub_error (GRUB_ERR_ACCESS_DENIED,
@@ -121,6 +171,9 @@ grub_verifiers_open (grub_file_t io, enum grub_file_type type)
 	  goto fail_noclose;
 	}
 
+      if (verify_pending)
+	io->verify_pending = 1;
+
       /* No verifiers wanted to verify. Just return underlying file. */
       return io;
     }
@@ -172,6 +225,17 @@ grub_verifiers_open (grub_file_t io, enum grub_file_type type)
   FOR_LIST_ELEMENTS_NEXT(ver, grub_file_verifiers)
     {
       enum grub_verify_flags flags = 0;
+
+      /*
+       * Run the verification in grub_verify_in_place() if both the caller
+       * and the verifier agree so.
+       */
+      if (in_place && ver->in_place)
+	{
+	  verify_pending = true;
+	  continue;
+	}
+
       err = ver->init (io, type, &context, &flags);
       if (err)
 	goto fail_noclose;
@@ -193,6 +257,8 @@ grub_verifiers_open (grub_file_t io, enum grub_file_type type)
 
   verified->file = io;
   ret->data = verified;
+  if (verify_pending)
+    ret->verify_pending = 1;
   return ret;
 
  fail:
@@ -226,3 +292,80 @@ grub_verifiers_init (void)
 {
   grub_file_filter_register (GRUB_FILE_FILTER_VERIFY, grub_verifiers_open);
 }
+
+/*
+ * Run the in-place capable verifiers over a buffer the file has already been
+ * loaded into, for files opened with GRUB_FILE_TYPE_VERIFY_IN_PLACE.
+ *
+ * Only verifiers with in_place set are run here. Everything which decides
+ * whether the file may be used has already run in grub_verifiers_open(),
+ * because this call can happen arbitrarily late - on the EFI LoadFile2 path
+ * the Linux EFI stub asks for the initrd after the kernel has been started,
+ * so a failure here can no longer stop the boot, it can only make the stub
+ * give up. For the same reason the resulting measurement lands in the event
+ * log after the kernel's own PCR 4 measurement rather than before it.
+ */
+grub_err_t
+grub_verify_in_place (grub_file_t io, void *buf, grub_size_t size)
+{
+  struct grub_file_verifier *ver;
+  grub_err_t err = GRUB_ERR_NONE;
+
+  if ((io->type & GRUB_FILE_TYPE_VERIFY_IN_PLACE) == 0)
+    return grub_error (GRUB_ERR_BAD_ARGUMENT, N_("in-place verification not requested: %s"),
+		       io->name);
+
+  grub_dprintf ("verify", "in-place file: %s type: %d size: %" PRIuGRUB_SIZE "\n",
+		io->name, io->type, size);
+
+  if (grub_verifiers_exempt (io, io->type))
+    return GRUB_ERR_NONE;
+
+  if (!io->verify_pending)
+    grub_dprintf ("verify", "file %s: grub_verify_in_place() called twice, "
+		  "or no in-place verifiers registered\n", io->name);
+  io->verify_pending = 0;
+
+  FOR_LIST_ELEMENTS(ver, grub_file_verifiers)
+    {
+      void *context = NULL;
+      enum grub_verify_flags flags = 0;
+
+      if (!ver->in_place)
+	continue;
+
+      err = ver->init (io, io->type, &context, &flags);
+      if (err)
+	return err;
+
+      /*
+       * A DEFER_AUTH request is answered in grub_verifiers_open(), which is
+       * the only place seeing every verifier. Measuring the file here does
+       * not authenticate it, so there is nothing to do about it here.
+       */
+      if (flags & (GRUB_VERIFY_FLAGS_SKIP_VERIFICATION
+		   | GRUB_VERIFY_FLAGS_DEFER_AUTH))
+	{
+	  if (ver->close)
+	    ver->close (context);
+	  continue;
+	}
+
+      if (ver->write == NULL)
+	err = grub_error (GRUB_ERR_BAD_ARGUMENT,
+			  "verifier `%s' has no write method", ver->name);
+      else
+	err = ver->write (context, buf, size);
+
+      if (err == GRUB_ERR_NONE && ver->fini)
+	err = ver->fini (context);
+
+      if (ver->close)
+	ver->close (context);
+
+      if (err != GRUB_ERR_NONE)
+	return err;
+    }
+
+  return GRUB_ERR_NONE;
+}
diff --git a/include/grub/verify.h b/include/grub/verify.h
index 672ae1692..f700e9b5d 100644
--- a/include/grub/verify.h
+++ b/include/grub/verify.h
@@ -45,6 +45,21 @@ struct grub_file_verifier
 
   const char *name;
 
+  /*
+   * Set if this verifier measures a file rather than authenticating it, and
+   * is therefore able to work on the buffer the file has already been loaded
+   * into. For files opened with GRUB_FILE_TYPE_VERIFY_IN_PLACE such a
+   * verifier is not run by grub_verifiers_open() but by the caller's later
+   * grub_verify_in_place() call, which saves keeping a second copy of the
+   * file around just to hash it.
+   *
+   * Verifiers which decide whether a file may be used at all must leave this
+   * unset: they have to run while grub_file_open() is still the enforcement
+   * point, as the in-place call may happen much later - on the EFI LoadFile2
+   * path it happens after the kernel has been started.
+   */
+  bool in_place;
+
   /*
    * Check if file needs to be verified and set up context.
    * init/read/fini is structured in the same way as hash interface.
@@ -85,4 +100,7 @@ grub_verifier_unregister (struct grub_file_verifier *ver)
 extern grub_err_t
 EXPORT_FUNC (grub_verify_string) (char *str, enum grub_verify_string_type type);
 
+extern grub_err_t
+EXPORT_FUNC (grub_verify_in_place) (grub_file_t io, void *buf, grub_size_t size);
+
 #endif /* ! GRUB_VERIFY_HEADER */
-- 
2.51.0

