Index: grub-2.16/util/grub-mkconfig.in
===================================================================
--- grub-2.16.orig/util/grub-mkconfig.in
+++ grub-2.16/util/grub-mkconfig.in
@@ -324,7 +324,8 @@ export GRUB_DEFAULT \
   GRUB_BOOTNEXT_OMIT_INACTIVE \
   GRUB_DISABLE_MODULE_DEDUPLICATION \
   SUSE_BTRFS_SNAPSHOT_BOOTING \
-  SUSE_CMDLINE_XENEFI
+  SUSE_CMDLINE_XENEFI \
+  SUSE_REMOVE_LINUX_ROOT_PARAM
 
 if test "x${grub_cfg}" != "x"; then
   rm -f "${grub_cfg}.new"
Index: grub-2.16/util/grub.d/10_linux.in
===================================================================
--- grub-2.16.orig/util/grub.d/10_linux.in
+++ grub-2.16/util/grub.d/10_linux.in
@@ -76,7 +76,7 @@ case x"$GRUB_FS" in
 	else
 	rootsubvol="`make_system_path_relative_to_its_root /`"
 	rootsubvol="${rootsubvol#/}"
-	if [ "x${rootsubvol}" != x ]; then
+	if [ "x${rootsubvol}" != x ] && [ "x$SUSE_REMOVE_LINUX_ROOT_PARAM" != "xtrue" ]; then
 	    GRUB_CMDLINE_LINUX="rootflags=subvol=${rootsubvol} ${GRUB_CMDLINE_LINUX}"
 	fi
 	fi;;
@@ -93,6 +93,10 @@ case x"$GRUB_FS" in
 	;;
 esac
 
+if [ "x$SUSE_REMOVE_LINUX_ROOT_PARAM" = "xtrue" ]; then
+  LINUX_ROOT_DEVICE=""
+fi
+
 title_correction_code=
 
 hotkey=1
