From 0092abd0f92eec6e4f0a20e895de715706dd7582 Mon Sep 17 00:00:00 2001
From: Michael Chang <mchang@suse.com>
Date: Thu, 26 Nov 2026 16:15:14 +0800
Subject: [PATCH] commands/efi/tpcm: Fix pointer-to-int-cast error on 32-bit
 platforms

Signed-off-by: Michael Chang <mchang@suse.com>
---
 grub-core/commands/efi/tpcm.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/grub-core/commands/efi/tpcm.c b/grub-core/commands/efi/tpcm.c
index 38ace6c85..e9e837a2a 100644
--- a/grub-core/commands/efi/tpcm.c
+++ b/grub-core/commands/efi/tpcm.c
@@ -104,7 +104,7 @@ measure_memory (enum grub_file_type type __attribute__((unused)),
                 {
                     desc_len = grub_strlen (desc) + 1;
                     status = c2p->verify_raw (c2p, stage,
-                                              (grub_uint64_t) desc, desc_len,
+                                              (grub_uint64_t) (grub_addr_t) desc, desc_len,
                                               1, &range, &measure_result,
                                               &control_result);
                     if (status == GRUB_EFI_SUCCESS
