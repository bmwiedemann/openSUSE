<services>
  <service name="tar_scm" mode="manual">
    <param name="exclude">testdata/haul.tar.zst</param>
    <param name="filename">hauler</param>
    <param name="revision">v2.1.2</param>
    <param name="scm">git</param>
    <param name="submodules">disable</param>
    <param name="url">https://github.com/hauler-dev/hauler.git</param>
    <param name="versionformat">@PARENT_TAG@</param>
    <param name="versionrewrite-pattern">[v]?([^\+]+)(.*)</param>
    <param name="versionrewrite-replacement">\1</param>
  </service>
  <service name="recompress" mode="manual">
    <param name="file">*.tar</param>
    <param name="compression">zst</param>
  </service>
  <service name="go_modules" mode="manual">
    <param name="compression">zst</param>
    <param name="replace">github.com/go-chi/chi/v5=github.com/go-chi/chi/v5@v5.4.0</param>
    <param name="replace">github.com/klauspost/compress=github.com/klauspost/compress@v1.20.2</param>
    <param name="replace">github.com/go-jose/go-jose/v4=github.com/go-jose/go-jose/v4@v4.1.6</param>
  </service>
</services>
