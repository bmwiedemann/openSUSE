Fix filesystem timestamps of compressed assets for reproducible builds.
Sprockets 4.4.1 already uses a deterministic timestamp in gzip headers.

--- a/hawk/vendor/gems/sprockets-4.4.1/lib/sprockets/utils/gzip.rb
+++ b/hawk/vendor/gems/sprockets-4.4.1/lib/sprockets/utils/gzip.rb
@@ -91,9 +91,8 @@
       #
       # Returns nothing.
       def compress(file, target)
-        mtime = Sprockets::PathUtils.stat(target).mtime
         archiver.call(file, source)
-        File.utime(mtime, mtime, file.path)
+        File.utime(0, 0, file.path)
 
         nil
       end
