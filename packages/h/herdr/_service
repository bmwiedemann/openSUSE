<services>
  <service name="obs_scm" mode="manual">
    <param name="url">https://github.com/herdrdev/herdr.git</param>
    <param name="scm">git</param>
    <param name="revision">refs/tags/v0.9.5</param>
    <param name="versionformat">@PARENT_TAG@</param>
    <param name="versionrewrite-pattern">v(.*)</param>
    <param name="changesgenerate">disable</param>
  </service>
  <service name="tar" mode="manual"/>
  <service name="recompress" mode="manual">
    <param name="file">*.tar</param>
    <param name="compression">zst</param>
  </service>
  <service name="set_version" mode="manual"/>
  <service name="cargo_vendor" mode="manual">
    <param name="src">herdr</param>
    <param name="compression">zst</param>
    <!-- build exactly what upstream's Cargo.lock pins: the tree is only tested
         against it, and update=true moves 113 crates and adds new ones -->
    <param name="update">false</param>
    <param name="respect-lockfile">true</param>
    <!-- upstream already ships a vendor/ dir (libghostty-vt, portable-pty) -->
    <param name="tag">crates</param>
  </service>
</services>
