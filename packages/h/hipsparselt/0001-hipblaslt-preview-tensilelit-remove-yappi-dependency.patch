--- a/projects/hipblaslt/tensilelite/requirements.txt
+++ b/projects/hipblaslt/tensilelite/requirements.txt
@@ -5,7 +5,7 @@ joblib>=1.4.0
 simplejson
 ujson
 orjson
-yappi
+
