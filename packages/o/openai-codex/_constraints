<?xml version="1.0" encoding="UTF-8"?>
<constraints>
  <!-- Around 850 crates are compiled and linked into one binary, with the
       distribution's -C debuginfo=2 on top, so both the peak rustc and the
       vendored-sources-plus-target tree are large. 32 G, not 16: a single
       rustc peaks at 19 GB here, so 16 is under what one job needs - that
       is what OOM-killed 0.157.0. (Upstream's thin LTO is turned off in
       %build precisely because its single link step needed far more memory
       than any worker has - see the comment there.) -->
  <hardware>
    <physicalmemory>
      <size unit="G">32</size>
    </physicalmemory>
    <disk>
      <size unit="G">30</size>
    </disk>
  </hardware>
</constraints>
