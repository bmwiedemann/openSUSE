From: Martin Pluskal <martin@pluskal.org>
Subject: Adapt to the gix 0.88 error API (gix-error Exn types)

gix 0.88 routes fallible APIs through the new gix-error crate, whose
Exn error type does not implement StdError: anyhow's `?` conversion
and `.context()` no longer resolve for it.  Enable gix's `anyhow`
feature (gix-error/anyhow provides From<Exn> for anyhow::Error, so
plain `?` works again) and convert explicitly at the one remaining
`.context()` site in codex-git-utils.

Part of the boo#1285151 re-vendor (with codex-bump-gix-0.88.patch).

--- a/codex-rs/Cargo.toml
+++ b/codex-rs/Cargo.toml
@@ -376,7 +376,7 @@
 flate2 = "1.1.8"
 futures = { version = "0.3", default-features = false }
 gethostname = "1.1.0"
-gix = { version = "0.88.0", default-features = false, features = ["sha1"] }
+gix = { version = "0.88.0", default-features = false, features = ["anyhow", "sha1"] }
 gix-url = "0.35.2"
 glob = "0.3"
 globset = "0.4"
--- a/codex-rs/git-utils/src/baseline.rs
+++ b/codex-rs/git-utils/src/baseline.rs
@@ -315,6 +315,7 @@

 fn blob_oid(repo: &gix::Repository, bytes: &[u8]) -> anyhow::Result<ObjectId> {
     gix::objs::compute_hash(repo.object_hash(), gix::objs::Kind::Blob, bytes)
+        .map_err(anyhow::Error::from)
         .context("compute git baseline blob oid")
 }
