+               types_dir="github.com/containerd/containerd/vendor/github.com/containerd/containerd/api/types"
+               gogo_protopath="$shared_prefix/containerd/containerd/vendor/github.com/gogo/protobuf"
+               vendor_search_str='import "github.com\/containerd\/containerd\/api'
+               vendor_replace_str='import "github.com\/containerd\/containerd\/vendor\/github.com\/containerd\/containerd\/api'
+               ;;
