+#
+   containerd_protopath=""
+   for candidate in \
+       $shared_prefix/containerd/containerd/api \
+       $shared_prefix/containerd/containerd/vendor/github.com/containerd/containerd/api \
+       $shared_prefix/containerd/containerd/v2/api \
+       $shared_prefix/containerd/containerd/v2/vendor/github.com/containerd/containerd/api; do
+       if test -f "$candidate/services/tasks/v1/tasks.proto"; then
+           containerd_protopath="$candidate"
