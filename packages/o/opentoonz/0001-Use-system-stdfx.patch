+#include <kiss_fft.h>
+#include <kiss_fftnd.h>
 #include "ttile.h"
 #include "stdfx.h"
 #include "tfxparam.h"
--- a/toonz/sources/stdfx/iwa_glarefx.cpp
+++ b/toonz/sources/stdfx/iwa_glarefx.cpp
@@ -7,7 +7,7 @@
 
 #include "tparamuiconcept.h"
 
