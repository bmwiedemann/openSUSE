@@ -1035,4 +1035,4 @@
   return settingsIsLinear;
 }
 
-FX_PLUGIN_IDENTIFIER(Iwa_GlareFx, "iwa_GlareFx")
\ No newline at end of file
+FX_PLUGIN_IDENTIFIER(Iwa_GlareFx, "iwa_GlareFx")
