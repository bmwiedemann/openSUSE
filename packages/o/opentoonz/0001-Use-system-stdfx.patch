+#include <kiss_fft.h>
 
 #include <QPair>
 #include <QVector>
@@ -272,4 +272,4 @@
   return irisSizes;
 }
 
-FX_PLUGIN_IDENTIFIER(Iwa_BokehFx, "iwa_BokehFx")
\ No newline at end of file
+FX_PLUGIN_IDENTIFIER(Iwa_BokehFx, "iwa_BokehFx")
--- a/toonz/sources/stdfx/iwa_bokeh_util.h
+++ b/toonz/sources/stdfx/iwa_bokeh_util.h
@@ -5,8 +5,8 @@
 
 #include "tgeometry.h"
 #include "traster.h"
-#include "kiss_fft.h"
