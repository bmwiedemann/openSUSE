From: Martin Pluskal <martin@pluskal.org>
Subject: [PATCH] Do not offer to install coverage and profiling tools

Run with Coverage and Profile offer an Install button for a missing
tool that runs a package manager: cargo install cargo-llvm-cov, npm
install -g c8, adding @vitest/coverage-v8 or coverage.py to the
project, or pip install py-spy. Offer no install command; the message
and the homepage link stay, and the coverage.py one names the openSUSE
package (python3-coverage) for the system Python. The tests that
checked the install commands now check that none is offered.

--- a/crates/ide-coverage/src/plan.rs
+++ b/crates/ide-coverage/src/plan.rs
@@ -1,6 +1,6 @@
 //! Which coverage tool runs a configuration, and how its command line changes.
 
-use crate::{CoveragePrepared, CoverageReportSpec, InstallCommand};
+use crate::{CoveragePrepared, CoverageReportSpec};
 use ide_run::RunConfig;
 use ide_run::wrap::{self, program_name};
 use std::path::Path;
@@ -28,14 +28,9 @@
 }
 
 fn missing(tool: &str, message: impl Into<String>, install: Option<(Vec<String>, &Path)>) -> CoveragePrepared {
-    CoveragePrepared::MissingTool {
-        tool: tool.to_owned(),
-        message: message.into(),
-        install: install.and_then(|(argv, cwd)| {
-            let (command, args) = argv.split_first()?;
-            Some(InstallCommand { command: command.clone(), args: args.to_vec(), cwd: Some(cwd.to_path_buf().into()) })
-        }),
-    }
+    // Distribution build: never offer to run a package manager that installs the tool.
+    let _ = install;
+    CoveragePrepared::MissingTool { tool: tool.to_owned(), message: message.into(), install: None }
 }
 
