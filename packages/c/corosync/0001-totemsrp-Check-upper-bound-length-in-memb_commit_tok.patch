From 9199063b5a671bb69a723e29b8b385bc038a67c2 Mon Sep 17 00:00:00 2001
From: nicholasyang <nicholas.yang@suse.com>
Date: Thu, 26 Nov 2026 14:54:23 +0800
Subject: [PATCH] totemsrp: Check upper bound length in
 memb_commit_token_sanity

A crafted memb_commit_token message larger than commit_token_storage
could overflow the heap-allocated totemsrp_instance when copied.

Add max_msg_len upper bound check to check_memb_commit_token_sanity()
and move alloca(msg_len) after the sanity check in
message_handler_memb_commit_token().
---
 exec/totemsrp.c | 15 +++++++++++++--
 1 file changed, 13 insertions(+), 2 deletions(-)

diff --git a/exec/totemsrp.c b/exec/totemsrp.c
index 1802bb34..612fab02 100644
--- a/exec/totemsrp.c
+++ b/exec/totemsrp.c
@@ -3811,12 +3811,20 @@ static int check_memb_commit_token_sanity(
 	struct totemsrp_instance *instance,
 	const void *msg,
 	size_t msg_len,
+	size_t max_msg_len,
 	int endian_conversion_needed)
 {
 	const struct memb_commit_token *mct_msg = (const struct memb_commit_token *)msg;
 	unsigned int addr_entries;
 	size_t required_len;
 
+	if (msg_len > max_msg_len) {
+		log_printf (instance->totemsrp_log_level_security,
+		    "Received memb_commit_token message is too long...  ignoring.");
+
+		return (-1);
+	}
+
 	if (msg_len < sizeof(struct memb_commit_token)) {
 		log_printf (instance->totemsrp_log_level_security,
 		    "Received memb_commit_token message is too short...  ignoring.");
@@ -4880,7 +4888,7 @@ static int message_handler_memb_commit_token (
 	size_t msg_len,
 	int endian_conversion_needed)
 {
-	struct memb_commit_token *memb_commit_token_convert = alloca (msg_len);
+	struct memb_commit_token *memb_commit_token_convert;
 	struct memb_commit_token *memb_commit_token;
 	struct srp_addr sub[PROCESSOR_COUNT_MAX];
 	int sub_entries;
@@ -4890,10 +4898,13 @@ static int message_handler_memb_commit_token (
 	log_printf (instance->totemsrp_log_level_debug,
 		"got commit token");
 
-	if (check_memb_commit_token_sanity(instance, msg, msg_len, endian_conversion_needed) == -1) {
+	if (check_memb_commit_token_sanity(instance, msg, msg_len,
+	    sizeof(instance->commit_token_storage), endian_conversion_needed) == -1) {
 		return (0);
 	}
 
+	memb_commit_token_convert = alloca (msg_len);
+
 	if (endian_conversion_needed) {
 		memb_commit_token_endian_convert (msg, memb_commit_token_convert);
 	} else {
-- 
2.56.1

