Drop -march=native so that the output does not depend on the build host CPU.
It also prevented the resulting library from running on the baseline
x86-64 v1 CPU.

Index: clthreads/source/Makefile
===================================================================
--- clthreads.orig/source/Makefile
+++ clthreads/source/Makefile
@@ -33,7 +33,6 @@ VERSION = $(MAJVERS).$(MINVERS)
 
 CPPFLAGS += -DVERSION=\"$(VERSION)\" -D_REENTRANT -D_POSIX_PTHREAD_SEMANTICS -I.  
 CXXFLAGS += -Wall -O2 -fPIC
-CXXFLAGS += -march=native
 LDLFAGS += 
 LDLIBS +=
 
