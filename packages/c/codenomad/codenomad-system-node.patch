 use std::path::{Path, PathBuf};
 
 pub fn resolve_bundled_node_binary() -> anyhow::Result<String> {
+    // Distro build: prefer the system Node.js over a downloaded bundle.
+    if let Ok(env_binary) = std::env::var("NODE_BINARY") {
+        if std::path::Path::new(&env_binary).is_file() {
+            return Ok(env_binary);
+        }
+    }
+    for system in ["/usr/bin/node", "/usr/local/bin/node"] {
+        if std::path::Path::new(system).is_file() {
+            return Ok(system.to_string());
+        }
+    }
     let relative_binary = binary_relative_path();
     let platform_dir = platform_dir_name()?;
 
