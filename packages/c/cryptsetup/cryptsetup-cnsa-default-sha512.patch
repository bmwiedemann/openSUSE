 	hdr->version = 2;
 	memset(hdr->label, 0, LUKS2_LABEL_L);
-	strcpy(hdr->checksum_alg, "sha256");
+	strcpy(hdr->checksum_alg, "sha512");
 
 	r = crypt_random_get(cd, (char*)hdr->salt1, LUKS2_SALT_L, CRYPT_RND_SALT);
 	if (r < 0) {
