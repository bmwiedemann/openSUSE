<services>
  <service mode="manual" name="obs_scm">
    <param name="url">https://github.com/mlichvar/clknetsim.git</param>
    <param name="scm">git</param>
    <param name="revision">56b60ef2e807bb8b62ce0741cbaa3875f8a58885</param>
    <param name="changesgenerate">enable</param>
    <param name="filename">clknetsim</param>
    <param name="versionformat">0+git.%cd</param>
  </service>
  <service mode="manual" name="set_version"/>
  <service name="tar" mode="buildtime"/>
  <service name="recompress" mode="buildtime">
    <param name="file">*.tar</param>
    <param name="compression">gz</param>
  </service>
</services>
