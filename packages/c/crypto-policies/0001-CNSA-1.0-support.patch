diff --git a/crypto-policies.7.txt b/crypto-policies.7.txt
index 1022a15..342d15e 100644
--- a/crypto-policies.7.txt
+++ b/crypto-policies.7.txt
@@ -211,6 +211,29 @@ PROVIDED POLICIES
   * *RSA* params size: >= 2048
   * *TLS* protocols: *TLS* >= 1.2, *DTLS* >= 1.2
 
+*CNSA-1.0*::
+  A policy implementing the NSA Commercial National Security Algorithm Suite 1.0.
+  This policy is designed for protecting National Security Systems information
+  up to the TOP SECRET level. It provides a strict, high-security baseline
+  suitable for government and defense applications.
+  This policy provides at least 128-bit security and is more restrictive than
+  *FIPS*.
+
+  Note: CNSA 2.0 with post-quantum algorithms is the recommended successor,
+  but CNSA 1.0 remains valid during the transition period through 2030.
+
+  * MACs: *HMAC* with *SHA-384* (prefered) or *SHA-512*, AEAD
+  * Curves: P-384 and P-521 only (no Bernstein curves, no hybrid PQC)
+  * Signature algorithms: *ECDSA* with P-384+ and *SHA-384* (prefered) or *SHA-512*,
+    *RSA* >= 3072-bit with *SHA-384* or better (no *DSA*, no *EdDSA*, no ML-DSA)
+  * *TLS* Ciphers: *AES-256-GCM* only
+  * non-TLS Ciphers: *AES-256* (*GCM*, *CTR*, *CCM*)
+  * key exchange: *ECDHE* with P-384+, *DHE* >= 3072-bit, *RSA* 3072-bit or 4096-bit
+  * *DH* params size: >= 3072-bit
+  * *RSA* params size: >= 3072-bit
+  * *TLS* protocols: *TLS* >= 1.2, *DTLS* >= 1.2
+  * *Kerberos*: allowing legacy ciphers, as otherwise no kerberos cipher would be available
+
 *EMPTY*::
   All cryptographic algorithms are disabled (used for debugging only, do not
   use).
diff --git a/policies/CNSA-1.0.pol b/policies/CNSA-1.0.pol
new file mode 100644
index 0000000..f8975c4
--- /dev/null
+++ b/policies/CNSA-1.0.pol
@@ -0,0 +1,103 @@
+# CNSA 1.0 profile
+#
+# Primary Sources:
+# - https://media.defense.gov/2021/Oct/15/2002874275/-1/-1/0/CNSA_WORKSHEET_20211015.PDF
+# - https://www.niap-ccevs.org/technical-decisions/TD0980
+# RFCs:
+# RFC 9151 Commercial National Security Algorithm (CNSA) Suite Profile for TLS and DTLS 1.2 and 1.3
+# 	https://www.rfc-editor.org/rfc/rfc9151.html
+# - enc: AES GCM
+# - signature: ECSDA p384, RSA 3072 or 4096bit
+# - kex: ECDH (NIST P384 only), DH (3072 or 4096 modulus), RSA (3072 or 4096 bit, TLS 1.2 only)
+# - rsa schemes: pkcs 1.5 must, pss should
+# - ffgroups: 3072 and 4096 only
+# However compat statement:
+# "A CNSA (D)TLS client that offers interoperability with servers that
+#  are not CNSA compliant MAY offer additional cipher suites, but any
+#  additional cipher suites MUST appear after the CNSA cipher suites in
+#  the ClientHello message.
+#  A CNSA (D)TLS server MUST accept one of the CNSA Suites above
+#  if they are offered in the ClientHello message before accepting a
+#  non-CNSA-compliant suite."
+#
+# RFC 9206 Commercial National Security Algorithm (CNSA) Suite Cryptography for Internet Protocol
+# 	https://www.rfc-editor.org/rfc/rfc9206.html
+# enc: AES GCM only
+# signature: ECDSA (P384 only), RSA (3072 or larger)
+# kex: ECDH (P384 only), DH (3072 MODP, 4096 MODP groups)
+# hash: SHA384, however for PRF can be PRF-HMAC-SHA-512
+#
+# RFC 9212 Commercial National Security Algorithm (CNSA) Suite Cryptography for Secure Shell (SSH)
+# 	https://www.rfc-editor.org/rfc/rfc9212.html
+# - kex: ecdh-sha2-nistp384, diffie-hellman-group15-sha512, diffie-hellman-group16-sha512
+# - pubkey: ecdsa-sha2-nistp384, rsa-sha2-512
+# - enc algs: AEAD_AES_256_GCM
+# - macs: AEAD_AES_256_GCM
+#
+# RFC 8755 Using Commercial National Security Algorithm Suite Algorithms in Secure/Multipurpose Internet Mail Extensions
+# 	https://www.rfc-editor.org/rfc/rfc8755.html
+# - crypto policies does not cover S/MIME yet
+# RFC 8756 Commercial National Security Algorithm (CNSA) Suite Profile of Certificate Management over CMS
+# 	https://www.rfc-editor.org/rfc/rfc8756.html
+# cryptographic parameters:
+# - rsa keypairs: 3072, 4096 bit only
+# - hash: id-sha384 only
+# - hmac: HMAC-SHA384 only
+# - signature: sha384WithRSAEncryption, or ecdsa-with-sha384, or id-RSASSA-PSS (RSA 3072, 4096 bit only)
+#
+# RFC 8603 Commercial National Security Algorithm (CNSA) Suite Certificate and Certificate Revocation List (CRL) Profile
+#
+# MACs: only SHA2-384 (listed explicitly) and SHA2-512 (allowed)
+# AES: only 256 (no 128)
+# Curves: NIST P384 only
+# Signature algorithms: with SHA-384 hash or SHA-512 (no DSA)
+# TLS Ciphers: >= 256-bit key, >= 256-bit block (AES, including AES-CBC)
+# non-TLS Ciphers: as TLS Ciphers
+# key exchange: ECDHE, RSA, DHE (no DHE-DSS)
+# DH params size: >= 3072
+# RSA params size: >= 3072
+# TLS protocols: TLS >= 1.2, DTLS >= 1.2
+
+mac = AEAD HMAC-SHA2-384 HMAC-SHA2-512
+mac@Kerberos = HMAC-SHA2-384 AEAD HMAC-SHA2-512
+mac@SSH = HMAC-SHA2-384
+
+group = SECP384R1 FFDHE-3072 FFDHE-4096
+
+hash = SHA2-384 SHA2-512
+
+sign = ECDSA-SHA2-384 \
+       ECDSA-SHA2-512 \
+       RSA-PSS-SHA2-384 \
+       RSA-PSS-SHA2-512 \
+       RSA-PSS-RSAE-SHA2-384 \
+       RSA-PSS-RSAE-SHA2-512 \
+       RSA-SHA2-384 \
+       RSA-SHA2-512 \
+
+cipher = AES-256-GCM
+
+# cfb for compat only
+cipher@{sequoia,RPM} = AES-256-GCM AES-256-CFB
+
+# 'RSA' is intentionally before DHE ciphersuites, as the DHE ciphersuites have
+# interoperability issues in TLS.
+key_exchange = KEM-ECDH ECDHE RSA DHE DHE-RSA PSK DHE-PSK ECDHE-PSK RSA-PSK ECDHE-GSS DHE-GSS
+
+protocol@TLS = TLS1.3 TLS1.2 DTLS1.2
+protocol@IKE = IKEv2
+
+# not really CNSA 1.0 compliant, but otherwis krb5 has no encryption type left
+cipher@Kerberos = AES-256-CBC
+
+# Parameter sizes
+min_dh_size = 3072
+min_dsa_size = 3072
+min_rsa_size = 3072
+
+# GnuTLS only for now
+sha1_in_certs = 0
+
+arbitrary_dh_groups = 1
+ssh_certs = 1
+etm@SSH = DISABLE_ETM
