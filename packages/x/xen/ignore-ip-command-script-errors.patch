@@ -92,7 +92,7 @@ setup_bridge_port() {
     ip link set dev ${dev} address fe:ff:ff:ff:ff:ff || true
 
     # ... and configure it
-    ip address flush dev ${dev}
+    ip address flush dev ${dev} || true
 }
 
