 Xi/exevents.c             |  24 +++-
 test/pyxtest/inputtest.py | 295 ++++++++++++++++++++++++++++++++++++++
 test/pyxtest/proto/xi.py  |  76 ++++++++++
 test/pyxtest/test_xi.py   | 188 +++++++++++++++++++++++-
 4 files changed, 575 insertions(+), 8 deletions(-)
 create mode 100644 test/pyxtest/inputtest.py

