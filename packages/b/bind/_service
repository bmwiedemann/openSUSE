<services>
  <service name="obs_scm" mode="manual">
    <param name="scm">git</param>
    <param name="url">https://gitlab.isc.org/isc-projects/dlz-modules.git</param>
    <param name="revision">main</param>
    <param name="versionformat">%h</param>
    <param name="filename">dlz-modules</param>
    <param name="package-meta">yes</param>
  </service>
  <service name="tar" mode="buildtime"/>
  <service name="recompress" mode="buildtime">
    <param name="file">*.tar</param>
    <param name="compression">gz</param>
  </service>
  <service name="download_url" mode="manual">
    <param name="protocol">https</param>
    <param name="host">www.internic.net</param>
    <param name="path">/domain/named.root</param>
  </service>
</services>
