Bug boo#958462

Allow the smart bash builtin completion if normal completion scripting
does not return anything.

---
 bash-completion-2.18.0/bash_completion |    3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

--- bash-completion-2.18.0/bash_completion
+++ bash-completion-2.18.0/bash_completion	2026-09-30 11:10:57.608467434 +0000
@@ -3320,11 +3320,12 @@ complete -F _comp_complete_longopt -o fi
     a2ps awk base{32,64,nc} bash bc bison cat chroot colordiff comm cp csplit \
     cut date df diff dir du enscript expand fmt fold gperf grep grub head irb \
     ld ldd less ln m4 mkdir mkfifo mknod mv nl nm numfmt objcopy \
-    objdump od paste pr ptx readelf readlink realpath rm rmdir sed shar \
+    objdump od paste pr ptx readelf readlink realpath sed shar \
     shred shuf sort split stat strip sum sync tac tail tee texindex touch tr \
     unexpand uniq vdir wc who
 complete -F _comp_complete_longopt -o default env netstat seq uname units
 complete -F _comp_complete_longopt -o bashdefault -o default -o filenames ls ll la l ls-l lf
+complete -F _comp_complete_longopt -o bashdefault -o default -o filenames rm rmdir
 
 # @since 2.12
 declare -Ag _comp_xspecs
