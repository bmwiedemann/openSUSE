--- bash-completion-2.18.0/test/t/test_core.py
+++ bash-completion-2.18.0/test/t/test_core.py	2026-09-30 09:56:04.988991516 +0000
@@ -0,0 +1,19 @@
+import pytest
+from conftest import assert_bash_exec
+
+@pytest.mark.bashcomp(cmd=None, temp_cwd=True)
+class TestBoo717151:
+    COMMANDS = ["cat", "cp", "mkdir", "mv", "rm", "ls"]
+
+    @pytest.mark.parametrize("cmd", COMMANDS)
+    def test_directory_completion_no_extra_space_boo717151(self, bash, cmd):
+        """Test directory completion appends slash instead of space (boo#717151)."""
+        from conftest import PS1
+
+        assert_bash_exec(bash, "mkdir -p test_dir_boo717151")
+
+        bash.send(f"{cmd} test_dir_boo\t")
+        bash.expect(r"test_dir_boo717151/")
+
+        bash.sendintr()
+        bash.expect_exact(PS1)
