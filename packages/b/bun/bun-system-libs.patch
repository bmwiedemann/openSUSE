+++ b/scripts/build/depVersionsHeader.ts
@@ -49,6 +49,14 @@ function computeVersions(cfg: Config): [string, string][] {
   // Single source of truth — bumping deps/<name>.ts updates this.
   for (const dep of allDeps) {
     if (dep.versionMacro === undefined) continue;
+    // openSUSE: for a dep whose vendored build has been disabled in favour of
+    // a distribution library, process.versions must report what is actually
+    // linked. The spec file sets these from pkg-config.
+    const systemVersion = process.env[`BUN_SYSTEM_VERSION_${dep.name.toUpperCase()}`];
+    if (systemVersion !== undefined && systemVersion.length > 0) {
+      versions.push([dep.versionMacro, systemVersion]);
+      continue;
+    }
