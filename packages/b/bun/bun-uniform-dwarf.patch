--- a/scripts/build/rust.ts
+++ b/scripts/build/rust.ts
@@ -391,6 +391,18 @@
   // Keep frame pointers — matches the C++ side's `-fno-omit-frame-pointer` / `/Oy-`
   // (flags.ts:293-301). Needed so profilers and crash backtraces can walk Rust frames.
   rustflags.push("-Cforce-frame-pointers=yes");
+  // Emit the same DWARF version as everything else linked in. Clang 21 and the
+  // prebuilt standard library are both DWARF 5; rustc still defaults to 4, so
+  // the binary ends up carrying .debug_ranges and .debug_rnglists at once.
+  // debugedit cannot read that mixture - it aborts on
+  // "string_find_entry: Assertion `ret != NULL' failed" - and rpm then cannot
+  // split a debuginfo package off the executable at all.
+  rustflags.push("-Cdwarf-version=5");
+  // ...but not the DWARF 5 accelerator table that comes with it. It is a name
+  // index for debuggers, nothing depends on it, and debugedit does not know
+  // the section at all: "Unknown debugging section .debug_names", then the
+  // same assertion.
+  rustflags.push("-Cllvm-args=-accel-tables=Disable");
   // Parallel frontend: rustc's default is single-threaded for parse / macro
   // expansion / typeck / borrowck, so the critical-path crate (`bun_runtime`)
   // sits on one core while the rest idle. With this, independent compiler
