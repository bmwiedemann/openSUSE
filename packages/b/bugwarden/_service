<services>
  <service name="obs_scm" mode="manual">
    <param name="url">https://github.com/plusky/bugwarden.git</param>
    <param name="scm">git</param>
    <param name="revision">0.7.0</param>
    <param name="versionformat">@PARENT_TAG@</param>
    <param name="exclude">.git</param>
  </service>
  <service name="tar" mode="manual"/>
  <service name="recompress" mode="manual">
    <param name="file">*.tar</param>
    <param name="compression">zst</param>
  </service>
  <service name="set_version" mode="manual"/>
  <!-- update=false keeps upstream's Cargo.lock as it is: the crate
       set upstream's CI tests and checks with cargo deny, which cargo_audit
       re-checks here. source_validator's "missing update=true" note is
       expected. filter=true empties the crates no Linux target uses; the
       Windows objects it keeps in ring and aws-lc-sys are stripped
       afterwards, see the spec comment above Source1. -->
  <service name="cargo_vendor" mode="manual">
    <param name="srcdir">bugwarden</param>
    <param name="compression">zst</param>
    <param name="update">false</param>
    <param name="filter">true</param>
  </service>
  <service name="cargo_audit" mode="manual">
    <param name="srcdir">bugwarden</param>
  </service>
</services>
