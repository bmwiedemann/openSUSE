---
 CMakeLists.txt |  196 +++++++++++++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 196 insertions(+)

--- /dev/null
+++ b/CMakeLists.txt
@@ -0,0 +1,196 @@
+cmake_minimum_required(VERSION 3.28)
+project(nv-attestation VERSION 1.2.2 LANGUAGES CXX)
+set(CMAKE_CXX_EXTENSIONS ON)
+set(CMAKE_CXX_STANDARD_REQUIRED 1)
+set(CMAKE_CXX_STANDARD 17)
+
+set(CMAKE_POSITION_INDEPENDENT_CODE ON)
+
+include(CMakePackageConfigHelpers)
+include(ExternalProject)
+include(FetchContent)
+include(GNUInstallDirs)
+find_package(PkgConfig REQUIRED)
+
+FetchContent_Declare(
+	Corrosion
+	GIT_REPOSITORY https://github.com/corrosion-rs/corrosion.git
+	# Use a tag that has a fix for https://github.com/corrosion-rs/corrosion/issues/590
+	GIT_TAG 6be991bb34c348dfb8344be22f3606288ea5c7fd
+	EXCLUDE_FROM_ALL
+)
+FetchContent_MakeAvailable(Corrosion)
+
+FetchContent_Declare(
+	regorus
+	GIT_REPOSITORY https://github.com/microsoft/regorus.git
+	GIT_TAG c7bf460bc160c96e38048296e5708943d2e43909
+)
+FetchContent_MakeAvailable(regorus)
+corrosion_import_crate(
+	MANIFEST_PATH "${regorus_SOURCE_DIR}/bindings/ffi/Cargo.toml"
+	PROFILE "release"
+	CRATES regorus-ffi
+	NO_DEFAULT_FEATURES
+	FEATURES "regorus/semver"
+	CRATE_TYPES "staticlib"
+)
+
+set(JWT_DISABLE_PICOJSON ON CACHE BOOL "Disable picojson support in jwt-cpp")
+set(JWT_BUILD_EXAMPLES OFF CACHE BOOL "Disable building jwt-cpp examples")
+cmake_policy(SET CMP0135 NEW)
+FetchContent_Declare(
+	jwt-cpp
+	GIT_REPOSITORY https://github.com/Thalhammer/jwt-cpp.git
+	GIT_TAG e71e0c2d584baff06925bbb3aad683f677e4d498
+	EXCLUDE_FROM_ALL
+)
+FetchContent_MakeAvailable(jwt-cpp)
+add_library(own-jwt-cpp INTERFACE)
+target_include_directories(own-jwt-cpp INTERFACE ${jwt-cpp_SOURCE_DIR}/include)
+
+FetchContent_Declare(
+    CLI11
+    GIT_REPOSITORY https://github.com/CLIUtils/CLI11.git
+    GIT_TAG bfffd37e1f804ca4fae1caae106935791696b6a9
+)
+FetchContent_MakeAvailable(CLI11)
+#
+##
+###
+##
+#
+pkg_check_modules(NVAT_SYSPKG REQUIRED
+	libcurl
+	libxml-2.0
+	nlohmann_json
+	openssl
+	spdlog
+	xmlsec1
+	xmlsec1-openssl
+)
+configure_file(${CMAKE_CURRENT_SOURCE_DIR}/nv-attestation-sdk-cpp/include/nvat.h.in
+               ${CMAKE_CURRENT_BINARY_DIR}/nv-attestation-sdk-cpp/include/nvat.h)
+add_library(nvat
+	nv-attestation-sdk-cpp/src/attestation.cpp
+	nv-attestation-sdk-cpp/src/claims.cpp
+	nv-attestation-sdk-cpp/src/claims_evaluator.cpp
+	nv-attestation-sdk-cpp/src/gpu/claims.cpp
+	nv-attestation-sdk-cpp/src/gpu/corelib_client.cpp
+	nv-attestation-sdk-cpp/src/gpu/evidence.cpp
+	nv-attestation-sdk-cpp/src/gpu/nvml_client.cpp
+	nv-attestation-sdk-cpp/src/gpu/spdm/gpu_opaque_data_parser.cpp
+	nv-attestation-sdk-cpp/src/gpu/verify.cpp
+	nv-attestation-sdk-cpp/src/init.cpp
+	nv-attestation-sdk-cpp/src/log.cpp
+	nv-attestation-sdk-cpp/src/nv_cache.cpp
+	nv-attestation-sdk-cpp/src/nv_http.cpp
+	nv-attestation-sdk-cpp/src/nv_jwt.cpp
+	nv-attestation-sdk-cpp/src/nv_ocsp.cpp
+	nv-attestation-sdk-cpp/src/nv_x509.cpp
+	nv-attestation-sdk-cpp/src/nvat.cpp
+	nv-attestation-sdk-cpp/src/rego_engine/regorus_rego_engine.cpp
+	nv-attestation-sdk-cpp/src/rim.cpp
+	nv-attestation-sdk-cpp/src/spdm/spdm_measurement_records.cpp
+	nv-attestation-sdk-cpp/src/spdm/spdm_opaque_data_parser.cpp
+	nv-attestation-sdk-cpp/src/spdm/spdm_req.cpp
+	nv-attestation-sdk-cpp/src/spdm/spdm_resp.cpp
+	nv-attestation-sdk-cpp/src/switch/claims.cpp
+	nv-attestation-sdk-cpp/src/switch/evidence.cpp
+	nv-attestation-sdk-cpp/src/switch/nscq_client.cpp
+	nv-attestation-sdk-cpp/src/switch/spdm/switch_opaque_data_parser.cpp
+	nv-attestation-sdk-cpp/src/switch/verify.cpp
+	nv-attestation-sdk-cpp/src/utils.cpp
+	nv-attestation-sdk-cpp/src/verify.cpp
+)
+set(NV_ATTESTATION_SOVERSION ${PROJECT_VERSION_MAJOR})
+set_target_properties(nvat PROPERTIES
+	VERSION "${PROJECT_VERSION}"
+	SOVERSION "${NV_ATTESTATION_SOVERSION}"
+)
+
+target_include_directories(nvat
+	PUBLIC
+		$<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}>
+		$<BUILD_INTERFACE:${CMAKE_CURRENT_BINARY_DIR}/nv-attestation-sdk-cpp/include>
+	PRIVATE
+		${NVAT_SYSPKG_INCLUDE_DIRS}
+		nv-attestation-sdk-cpp/src
+		$<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/nv-attestation-sdk-cpp/include>
+		${regorus_SOURCE_DIR}/bindings/ffi
+)
+target_compile_options(nvat PRIVATE ${NVAT_SYSPKG_CFLAGS_OTHER} -Wno-unused-function)
+target_link_libraries(nvat
+	PRIVATE
+		own-jwt-cpp
+		regorus_ffi
+		${NVAT_SYSPKG_LIBRARIES}
+)
+install(TARGETS nvat
+	EXPORT nvatTargets
+	ARCHIVE
+		DESTINATION ${CMAKE_INSTALL_LIBDIR}
+		COMPONENT Development
+	LIBRARY
+		DESTINATION ${CMAKE_INSTALL_LIBDIR}
+		COMPONENT Runtime
+		NAMELINK_COMPONENT Development
+	RUNTIME
+		DESTINATION ${CMAKE_INSTALL_BINDIR}
+		COMPONENT Runtime
+)
+install(FILES "${CMAKE_CURRENT_BINARY_DIR}/nv-attestation-sdk-cpp/include/nvat.h"
+	DESTINATION ${CMAKE_INSTALL_INCLUDEDIR}
+	COMPONENT Development
+)
+install(EXPORT nvatTargets
+	FILE nvatTargets.cmake
+	NAMESPACE nvat::
+	DESTINATION ${CMAKE_INSTALL_DATADIR}/cmake/nvat
+	COMPONENT Development
+)
+configure_package_config_file(nv-attestation-sdk-cpp/cmake/Config.cmake.in nvatConfig.cmake
+	INSTALL_DESTINATION "${CMAKE_INSTALL_DATADIR}/cmake/nvat"
+	NO_SET_AND_CHECK_MACRO
+	NO_CHECK_REQUIRED_COMPONENTS_MACRO
+)
+write_basic_package_version_file(
+	"${CMAKE_CURRENT_BINARY_DIR}/nvatConfigVersion.cmake"
+	VERSION "${PROJECT_VERSION}"
+	COMPATIBILITY SameMajorVersion
+)
+install(FILES
+	${CMAKE_CURRENT_BINARY_DIR}/nvatConfig.cmake
+	${CMAKE_CURRENT_BINARY_DIR}/nvatConfigVersion.cmake
+	DESTINATION ${CMAKE_INSTALL_DATADIR}/cmake/nvat
+	COMPONENT Development
+)
+#
+##
+###
+##
+#
+pkg_check_modules(NVATTEST_SYSPKG REQUIRED
+	nlohmann_json
+	spdlog
+)
+add_executable(nvattest
+	nv-attestation-cli/src/attest.cpp
+	nv-attestation-cli/src/collect_evidence.cpp
+	nv-attestation-cli/src/logging.cpp
+	nv-attestation-cli/src/main.cpp
+	nv-attestation-cli/src/utils.cpp
+	nv-attestation-cli/src/version.cpp
+)
+configure_file(${CMAKE_CURRENT_SOURCE_DIR}/nv-attestation-cli/src/version_config.h.in
+               ${CMAKE_CURRENT_BINARY_DIR}/version_config.h)
+
+target_link_libraries(nvattest PRIVATE nvat ${NVATTEST_SYSPKG_LIBRARIES} CLI11::CLI11)
+target_compile_options(nvattest PRIVATE ${NVATTEST_SYSPKG_CFLAGS_OTHER})
+target_include_directories(nvattest
+	PRIVATE
+		${CMAKE_CURRENT_SOURCE_DIR}/nv-attestation-cli/src
+		${CMAKE_CURRENT_BINARY_DIR}
+		${NVATTEST_SYSPKG_INCLUDE_DIRS}
+)
+install(TARGETS nvattest DESTINATION ${CMAKE_INSTALL_BINDIR})
