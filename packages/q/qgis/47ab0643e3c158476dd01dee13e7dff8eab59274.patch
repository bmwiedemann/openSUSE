From 47ab0643e3c158476dd01dee13e7dff8eab59274 Mon Sep 17 00:00:00 2001
From: Alexander Bruy <alexander.bruy@gmail.com>
Date: Sun, 11 Oct 2026 11:17:32 +0100
Subject: [PATCH] drop QTEST_DISABLE_KEYPAD_NAVIGATION from tests

This is removed upstream and breaks build on Qt >= 6.12.0
---
 src/test/qgstest.h | 1 -
 1 file changed, 1 deletion(-)

diff --git a/src/test/qgstest.h b/src/test/qgstest.h
index 06c835b2b807..f45e7bb095ea 100644
--- a/src/test/qgstest.h
+++ b/src/test/qgstest.h
@@ -66,7 +66,6 @@ using namespace Qt::StringLiterals;
     qputenv( "QGIS_CUSTOM_CONFIG_PATH", settingsDir.path().toUtf8() ); \
     QgsApplication app( argc, argv, false );                           \
     app.setAttribute( Qt::AA_Use96Dpi, true );                         \
-    QTEST_DISABLE_KEYPAD_NAVIGATION                                    \
     TestObject tc;                                                     \
     QTEST_SET_MAIN_SOURCE_PATH                                         \
     return QTest::qExec( &tc, argc, argv );                            \
