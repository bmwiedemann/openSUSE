diff --git a/integration/pom.xml b/integration/pom.xml
index 0851cec3d..5a9d02e60 100644
--- a/integration/pom.xml
+++ b/integration/pom.xml
@@ -219,7 +219,8 @@
                     <reuseForks>false</reuseForks>
