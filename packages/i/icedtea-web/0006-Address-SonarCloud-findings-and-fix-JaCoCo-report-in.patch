+sonar.cpd.exclusions=core/src/main/java/net/adoptopenjdk/icedteaweb/client/policyeditor/PolicyParser.java
diff --git a/core/src/main/java/net/adoptopenjdk/icedteaweb/client/policyeditor/PolicyIdentifier.java b/core/src/main/java/net/adoptopenjdk/icedteaweb/client/policyeditor/PolicyIdentifier.java
