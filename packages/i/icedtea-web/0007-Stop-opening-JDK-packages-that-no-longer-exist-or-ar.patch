-  set "LAUNCHER_BOOTCLASSPATH=%LAUNCHER_BOOTCLASSPATH%;%CUSTOM_JRE%/%NASHORN%"
 ) else (
   set "JAVA=%JRE%/bin/java"
-  set "CP=%JRE%/lib/rt.jar;%JRE%/lib/ext/jfxrt.jar"
-  set "LAUNCHER_BOOTCLASSPATH=%LAUNCHER_BOOTCLASSPATH%;%JRE%/%NASHORN%"
