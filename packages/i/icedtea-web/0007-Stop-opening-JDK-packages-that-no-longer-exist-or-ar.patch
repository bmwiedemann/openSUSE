   JAVA=$JRE/bin/java
-  CP=$JRE/lib/rt.jar:$JRE/lib/ext/jfxrt.jar
-  LAUNCHER_BOOTCLASSPATH="$LAUNCHER_BOOTCLASSPATH:$JRE/$NASHORN"
