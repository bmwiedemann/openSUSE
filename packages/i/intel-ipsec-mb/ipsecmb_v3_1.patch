--- a/lib/openssl/crypto/sha/asm/keccak1600x4-avx512vl.pl
+++ b/lib/openssl/crypto/sha/asm/keccak1600x4-avx512vl.pl
@@ -95,7 +95,8 @@ $sf_size="856";       # 48 + 808 = 856 bytes
 # Emit an internal helper call used by one-shot wrappers.
 # - Win64: call the provided *_internal shim and bracket it with 32-byte
 #   shadow space so shim entry can use xlate-compatible [rsp+8]/[rsp+16].
-# - non-Win64: call the public API symbol (same base name without _internal).
+# - non-Win64: call the local .L_ entry label of the public API function
+#   (same base name without _internal).
 # The argument must be the shim/internal symbol name, e.g.
 #   SHA3_shake128_x4_inc_squeeze_avx512vl_internal
 sub call_internal {
@@ -110,8 +111,11 @@ sub call_internal {
     add     \$32, %rsp
 ___
 
+    # Call the file-local entry label rather than the global symbol so
+    # no PC32 relocation against a preemptible symbol is emitted
+    # (rejected by older linkers when building a shared object).
     return <<___;
-    call    $external_name
+    call    .L_$external_name
 ___
 }
 
