Index: ImageMagick-7.1.2-32/config/policy-limited.xml
===================================================================
--- ImageMagick-7.1.2-32.orig/config/policy-limited.xml
+++ ImageMagick-7.1.2-32/config/policy-limited.xml
@@ -95,6 +95,8 @@
   <!-- <policy domain="path" rights="none" pattern="-"/> -->
   <!-- don't read sensitive paths. -->
   <policy domain="path" rights="none" pattern="/etc/*"/>
+  <!-- but allow to read own data. -->
+  <policy domain="path" rights="read" pattern="/etc/IM*"/>
   <!-- Indirect reads are not permitted. -->
   <policy domain="path" rights="none" pattern="@*"/>
   <!-- These image types are security risks on read, but write is fine -->
