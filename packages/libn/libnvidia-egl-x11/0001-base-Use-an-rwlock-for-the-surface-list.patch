+    surface_list = eplDisplayLockSurfaceList(pdpy);
+    psurf = eplSurfaceListLookup(surface_list, esurf);
+    if (psurf == NULL)
+    {
+        eplDisplayUnlockSurfaceList(pdpy);
+    }
+    *ret_pdpy = pdpy;
+    *ret_psurf = psurf;
+    return EGL_TRUE;
 }
 
