+    EplSurface *psurf = NULL;
+
+    *ret_pdpy = NULL;
+    *ret_psurf = NULL;
+
+    if (pdpy == NULL)
     {
-        eplRefCountRef(&found->refcount);
+        return EGL_FALSE;
     }
 
-    return found;
+    if (esurf == EGL_NO_SURFACE)
