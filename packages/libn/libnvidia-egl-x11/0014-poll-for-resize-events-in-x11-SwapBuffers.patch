From 587334ac2b07d824743fe746beb7cf2dcddc394b Mon Sep 17 00:00:00 2001
From: Riku Salminen <rsalminen@nvidia.com>
Date: Tue, 14 Apr 2026 06:48:04 +0000
Subject: [PATCH 14/18] poll for resize events in x11 SwapBuffers

In x11 SwapBuffers call PollForWindowEvents to ensure that resize events
are handled before CheckReallocWindow.

Without it the event might not get handled if there are no pending frames
and WaitForWindowEvents would not get called.

Fixes dEQP-EGL.functional.resize.*
---
 src/x11/x11-window.c | 16 ++++++++++++++++
 1 file changed, 16 insertions(+)

diff --git a/src/x11/x11-window.c b/src/x11/x11-window.c
index c7816fa..ff6ea62 100644
--- a/src/x11/x11-window.c
+++ b/src/x11/x11-window.c
@@ -2183,6 +2183,22 @@ EGLBoolean eplX11SwapBuffers(EplPlatformData *plat, EplDisplay *pdpy, EplSurface
         options |= XCB_PRESENT_OPTION_SUBOPTIMAL;
     }
 
+    /*
+     * Poll for any pending Present events before entering the throttle loop.
+     *
+     * The throttle loop calls WaitForWindowEvents only when the number of
+     * in-flight frames exceeds MAX_PENDING_FRAMES. With MAX_PENDING_FRAMES=1
+     * the common case is exactly one frame in flight, so the loop exits
+     * immediately without ever calling WaitForWindowEvents.
+     *
+     * This means events queued between two eglSwapBuffers calls, in
+     * particular a PresentConfigureNotify generated by a window resize, would
+     * otherwise never be read before CheckReallocWindow inspects
+     * pending_width/height, causing the resize to go undetected until the
+     * following swap.
+     */
+    PollForWindowEvents(surf);
+
     // Wait for pending frames to complete before we continue.
     while (1)
     {
