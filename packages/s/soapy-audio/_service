<services>
  <!-- Upstream tags releases again; track the tag (0.1.2 sorts above
       the old 0.1.1+git snapshot and ships the hamlib fixes patch-free). -->
  <service name="obs_scm" mode="manual">
    <param name="url">https://github.com/pothosware/SoapyAudio.git</param>
    <param name="scm">git</param>
    <param name="revision">soapy-audio-0.1.2</param>
    <param name="versionformat">0.1.2</param>
    <param name="exclude">.git*</param>
    <param name="filename">soapy-audio</param>
  </service>
  <service name="tar" mode="buildtime"/>
  <service name="recompress" mode="buildtime">
    <param name="file">*.tar</param>
    <param name="compression">zst</param>
  </service>
  <service name="set_version" mode="buildtime"/>
</services>
