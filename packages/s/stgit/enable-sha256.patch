+macro_rules! impl_int_div {
+    ($A:ident, $B:ident, $R:ident) => {
+        /// `$A<Ul> / $B<Ur> = $R<Ul / Ur>`
+        impl<Ul: Unsigned + NonZero, Ur: Unsigned + NonZero> Div<$B<Ur>> for $A<Ul>
+        where
