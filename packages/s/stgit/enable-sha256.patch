+//! LoongArch64 assembly backend
+
+#[cfg(not(target_arch = "loongarch64"))]
+compile_error!("loongarch-asm backend can be used only on loongarch64 target arches");
+
+macro_rules! c {
+    ($($l:expr)*) => {
+        concat!($($l ,)*)
+    };
+}
+
+macro_rules! rounda {
+    ($i:literal, $a:literal, $b:literal, $c:literal, $d:literal, $e:literal, $f:literal, $g:literal, $h:literal) => {
+        c!(
+            "ld.w    $a5, $a1, (" $i " * 4);"
+            "revb.2h $a5, $a5;"
+            "rotri.w $a5, $a5, 16;"
+            roundtail!($i, $a, $b, $c, $d, $e, $f, $g, $h)
+        )
+    };
+}
+
+macro_rules! roundb {
+    ($i:literal, $a:literal, $b:literal, $c:literal, $d:literal, $e:literal, $f:literal, $g:literal, $h:literal) => {
+        c!(
+            "ld.w    $a4, $sp, (((" $i " - 15) & 0xF) * 4);"
+            "ld.w    $a5, $sp, (((" $i " - 16) & 0xF) * 4);"
+            "ld.w    $a6, $sp, (((" $i " -  7) & 0xF) * 4);"
+            "add.w   $a5, $a5, $a6;"
+            "rotri.w $a6, $a4, 18;"
+            "srli.w  $a7, $a4, 3;"
+            "rotri.w $a4, $a4, 7;"
+            "xor     $a6, $a6, $a7;"
+            "xor     $a4, $a4, $a6;"
+            "add.w   $a5, $a5, $a4;"
+            "ld.w    $a4, $sp, (((" $i " -  2) & 0xF) * 4);"
+            "rotri.w $a6, $a4, 19;"
+            "srli.w  $a7, $a4, 10;"
+            "rotri.w $a4, $a4, 17;"
+            "xor     $a6, $a6, $a7;"
+            "xor     $a4, $a4, $a6;"
+            "add.w   $a5, $a5, $a4;"
+            roundtail!($i, $a, $b, $c, $d, $e, $f, $g, $h)
+        )
+    };
+}
+
+macro_rules! roundtail {
+    ($i:literal, $a:literal, $b:literal, $c:literal, $d:literal, $e:literal, $f:literal, $g:literal, $h:literal) => {
+        c!(
+            // Part 0
+            "rotri.w $a6, " $e ", 11;"
+            "rotri.w $a7, " $e ", 25;"
+            "rotri.w $a4, " $e ", 6;"
+            "xor     $a6, $a6, $a7;"
+            "xor     $a4, $a4, $a6;"
+            "xor     $a6, " $g ", " $f ";"
+            "ld.w    $a7, $a3, " $i " * 4;"
+            "and     $a6, $a6, " $e ";"
+            "xor     $a6, $a6, " $g ";"
+            "add.w   $a4, $a4, $a6;"
+            "add.w   $a4, $a4, $a7;"
+            "add.w   " $h ", " $h ", $a5;"
+            "add.w   " $h ", " $h ", $a4;"
+            // Part 1
+            "add.w   " $d ", " $d ", " $h ";"
+            // Part 2
+            "rotri.w $a6, " $a ", 13;"
+            "rotri.w $a7, " $a ", 22;"
+            "rotri.w $a4, " $a ", 2;"
+            "xor     $a6, $a6, $a7;"
+            "xor     $a4, $a4, $a6;"
+            "add.w   " $h ", " $h ", $a4;"
+            "or      $a4, " $c ", " $b ";"
+            "and     $a6, " $c ", " $b ";"
+            "and     $a4, $a4, " $a ";"
+            "or      $a4, $a4, $a6;"
+            "add.w   " $h ", " $h ", $a4;"
+            "st.w    $a5, $sp, ((" $i " & 0xF) * 4);"
+        )
+    };
+}
+
+pub(super) fn compress(state: &mut [u32; 8], blocks: &[[u8; 64]]) {
+    if blocks.is_empty() {
+        return;
+    }
