+            out("$a4") _,
+            out("$a5") _,
+            out("$a6") _,
+            out("$a7") _,
+            out("$t0") _,
+            out("$t1") _,
+            out("$t2") _,
+            out("$t3") _,
+            out("$t4") _,
+            out("$t5") _,
+            out("$t6") _,
+            out("$t7") _,
+
+            options(preserves_flags),
+        );
+    }
+}
