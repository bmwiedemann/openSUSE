+    U47,
+    U48,
+    U49,
+    U50,
+    U51,
+    U52,
+    U53,
+    U54,
+    U55,
+    U56,
+    U57,
+    U58,
+    U59,
+    U60,
+    U61,
+    U62,
+    U63,
+    U64,
+    U96,
+    U128,
+    U192,
+    U256,
+    U384,
+    U448,
+    U512,
+    U768,
+    U896,
+    U1024,
+    U2048,
+    U4096,
+    U8192
+}
+
+impl_serializable_state_u16_array! {
+    U1,
+    U2,
+    U3,
+    U4,
+    U5,
+    U6,
+    U7,
