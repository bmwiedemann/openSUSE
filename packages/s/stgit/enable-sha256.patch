+            #[inline]
+            fn private_div_int(self, _: Less, _: $B<Ur>) -> Self::Output {
+                Z0
+            }
+        }
+        impl<Ul, Ur> PrivateDivInt<Equal, $B<Ur>> for $A<Ul>
+        where
+            Ul: Unsigned + NonZero,
+            Ur: Unsigned + NonZero,
+        {
+            type Output = $R<U1>;
+
+            #[inline]
+            fn private_div_int(self, _: Equal, _: $B<Ur>) -> Self::Output {
+                $R { n: U1::new() }
+            }
+        }
