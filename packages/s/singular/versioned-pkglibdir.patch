       if (executable != NULL) *executable = '\0';
     }
   }
+  else if (config->id == 'r')
+  {
+    char test_path[MAXPATHLEN];
+    char* b = feResource('b');
+    if (b != NULL)
+    {
+      snprintf(test_path, sizeof(test_path), "%s/../share/singular", b);
+      if (access(test_path, X_OK) != 0)
+      {
+        strcpy(value, SINGULAR_DEFAULT_DIR);
+      }
+    }
+    else
+    {
+      strcpy(value, SINGULAR_DEFAULT_DIR);
+    }
+  }
+  else if (config->id == 'D')
+  {
+    char test_path[MAXPATHLEN];
+    char* b = feResource('b');
+    if (b != NULL)
+    {
+      snprintf(test_path, sizeof(test_path), "%s/../share/singular", b);
+      if (access(test_path, X_OK) != 0)
+      {
+        strcpy(value, DATA_DIR);
+      }
+    }
+    else
+    {
+      strcpy(value, DATA_DIR);
+    }
+  }
 
 #ifdef RESOURCE_DEBUG
   printf("value:%s\n", value);
