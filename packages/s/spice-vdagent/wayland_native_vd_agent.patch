+    GNU General Public License for more details.
+
+    You should have received a copy of the GNU General Public License
+    along with this program.  If not, see <http://www.gnu.org/licenses/>.
+*/
+#include <config.h>
+
+#ifdef WITH_WAYLAND
+
+#include <stdint.h>
+#include <syslog.h>
+
+#include <glib.h>
+#include <spice/vd_agent.h>
+#include <wayland-client.h>
+
+#include "internal.h"
+#include "vdagentd-proto.h"
+
+static void send_resolution(VDAgentWayland *w)
+{
+    struct vdagentd_guest_xorg_resolution res = {
+        .width = w->width, .height = w->height,
+        .x = 0, .y = 0, .display_id = 0,
+    };
+    udscs_write(w->vdagentd, VDAGENTD_GUEST_XORG_RESOLUTION,
+                w->width, w->height, (uint8_t *)&res, sizeof(res));
+    if (w->debug)
+        syslog(LOG_DEBUG, "wayland: reported resolution %dx%d",
+               w->width, w->height);
+}
+
+static void output_mode(void *data, struct wl_output *output, uint32_t flags,
+                        int32_t width, int32_t height, int32_t refresh)
+{
+    VDAgentWayland *w = data;
+
+    if (!(flags & WL_OUTPUT_MODE_CURRENT))
+        return;
+    w->pending_width  = width;
+    w->pending_height = height;
+}
+
+static void output_done(void *data, struct wl_output *output)
+{
+    VDAgentWayland *w = data;
+
+    if (w->pending_width <= 0 || w->pending_height <= 0)
+        return;
+    if (w->pending_width == w->width && w->pending_height == w->height)
+        return;
+
+    w->width  = w->pending_width;
+    w->height = w->pending_height;
+    syslog(LOG_INFO, "wayland: output is now %dx%d", w->width, w->height);
+    send_resolution(w);
+}
+
+static void output_geometry(void *d, struct wl_output *o, int32_t x, int32_t y,
+                            int32_t pw, int32_t ph, int32_t sub,
+                            const char *make, const char *model,
+                            int32_t transform)
+{
+}
+
+static void output_scale(void *d, struct wl_output *o, int32_t f)
+{
+}
+
+static void output_name(void *d, struct wl_output *o, const char *n)
+{
+}
+
+static void output_description(void *d, struct wl_output *o, const char *desc)
+{
+}
+
+static const struct wl_output_listener output_listener = {
+    .geometry    = output_geometry,
+    .mode        = output_mode,
+    .done        = output_done,
+    .scale       = output_scale,
+    .name        = output_name,
+    .description = output_description,
+};
+
+void vdagent_wayland_display_attach(VDAgentWayland *w)
+{
+    if (w->output != NULL)
+        wl_output_add_listener(w->output, &output_listener, w);
+}
+
+/* Monitors config ----------------------------------------------------- */
+
+static gboolean spawn_compositor_cmd(const gchar *prog, gchar **argv)
+{
+    GError *err = NULL;
+    if (g_spawn_async(NULL, argv, NULL,
+                      G_SPAWN_SEARCH_PATH | G_SPAWN_STDOUT_TO_DEV_NULL
+                          | G_SPAWN_STDERR_TO_DEV_NULL,
+                      NULL, NULL, NULL, &err))
+        return TRUE;
+    syslog(LOG_WARNING, "wayland: failed to spawn %s: %s", prog, err->message);
+    g_error_free(err);
+    return FALSE;
+}
+
+void vdagent_wayland_set_monitor_config(VDAgentWayland *w,
+                                        VDAgentMonitorsConfig *mon_config)
+{
+    uint32_t width, height;
+
+    if (mon_config == NULL || mon_config->num_of_monitors == 0)
+        return;
+
+    /* Apply only the first monitor. SPICE display index → compositor output
+     * name (Hyprland's "DP-1", sway's "HEADLESS-1", ...) is compositor-specific
+     * and deferred until someone has a multi-head SPICE guest to test against. */
+    width  = mon_config->monitors[0].width;
+    height = mon_config->monitors[0].height;
+    if (width == 0 || height == 0)
+        return;
+
+    syslog(LOG_INFO, "wayland: host requests resize to %ux%u", width, height);
+
+    if (g_getenv("HYPRLAND_INSTANCE_SIGNATURE") != NULL) {
+        gchar *spec = g_strdup_printf(",%ux%u@60,0x0,1", width, height);
+        gchar *argv[] = { "hyprctl", "keyword", "monitor", spec, NULL };
+        gboolean ok = spawn_compositor_cmd("hyprctl", argv);
+        g_free(spec);
+        if (ok)
+            return;
+    }
+    if (g_getenv("SWAYSOCK") != NULL) {
+        gchar *mode = g_strdup_printf("%ux%u", width, height);
+        gchar *argv[] = { "swaymsg", "output", "*", "mode", mode, NULL };
+        gboolean ok = spawn_compositor_cmd("swaymsg", argv);
+        g_free(mode);
+        if (ok)
+            return;
+    }
+    syslog(LOG_DEBUG, "wayland: MONITORS_CONFIG %ux%u — no supported compositor backend",
+           width, height);
+}
+
+#else /* !WITH_WAYLAND */
+
+#include <spice/vd_agent.h>
+
+#include "wayland.h"
+
+void vdagent_wayland_set_monitor_config(VDAgentWayland *w,
+                                        VDAgentMonitorsConfig *mon_config)
+{
+}
+
+#endif /* WITH_WAYLAND */
