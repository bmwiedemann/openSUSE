diff --git a/src/vdagent/wayland/clipboard.c b/src/vdagent/wayland/clipboard.c
new file mode 100644
index 0000000000000000000000000000000000000000..e9a4a12074ea68abb0e58c98d5ee32e5fba981c9
--- /dev/null
+++ b/src/vdagent/wayland/clipboard.c
@@ -0,0 +1,569 @@
+/*  clipboard.c - Wayland data-control clipboard backend
+
+    Copyright 2026 Viacheslav Dermichev
+
+    This program is free software: you can redistribute it and/or modify
+    it under the terms of the GNU General Public License as published by
+    the Free Software Foundation, either version 3 of the License, or
+    (at your option) any later version.
+
+    This program is distributed in the hope that it will be useful,
+    but WITHOUT ANY WARRANTY; without even the implied warranty of
+    MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+    GNU General Public License for more details.
+
+    You should have received a copy of the GNU General Public License
+    along with this program.  If not, see <http://www.gnu.org/licenses/>.
+*/
+#include <config.h>
+
+#ifdef WITH_WAYLAND
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <syslog.h>
+#include <unistd.h>
+
+#include <glib.h>
+#include <glib-unix.h>
+#include <spice/vd_agent.h>
+#include <wayland-client.h>
+
+#include "internal.h"
+#include "vdagentd-proto.h"
+
+#define MAX_CLIPBOARD_TYPES  32
+#define MAX_CLIPBOARD_BYTES  (64 * 1024 * 1024)
+
+G_STATIC_ASSERT(VD_AGENT_CLIPBOARD_SELECTION_CLIPBOARD == 0);
+G_STATIC_ASSERT(VD_AGENT_CLIPBOARD_SELECTION_PRIMARY == 1);
+G_STATIC_ASSERT(VDAGENT_WAYLAND_N_SELECTIONS ==
+                VD_AGENT_CLIPBOARD_SELECTION_PRIMARY + 1);
+
+static const char *sel_name(guint sel_id)
+{
+    return sel_id == VD_AGENT_CLIPBOARD_SELECTION_PRIMARY ? "primary" : "clipboard";
+}
+
+/* mime ↔ SPICE clipboard type mapping. Same set as clipboard.c's atom2agent.
+ * The first entry for any type is the canonical mime we use when we need to
+ * pick one. */
+static const struct {
+    guint32      type;
+    const gchar *mime;
+} mime2type[] = {
+    {VD_AGENT_CLIPBOARD_UTF8_TEXT, "text/plain;charset=utf-8"},
+    {VD_AGENT_CLIPBOARD_UTF8_TEXT, "UTF8_STRING"},
+    {VD_AGENT_CLIPBOARD_UTF8_TEXT, "STRING"},
+    {VD_AGENT_CLIPBOARD_UTF8_TEXT, "TEXT"},
+    {VD_AGENT_CLIPBOARD_UTF8_TEXT, "text/plain"},
+    {VD_AGENT_CLIPBOARD_IMAGE_PNG, "image/png"},
+    {VD_AGENT_CLIPBOARD_IMAGE_BMP, "image/bmp"},
+    {VD_AGENT_CLIPBOARD_IMAGE_BMP, "image/x-bmp"},
+    {VD_AGENT_CLIPBOARD_IMAGE_BMP, "image/x-MS-bmp"},
+    {VD_AGENT_CLIPBOARD_IMAGE_BMP, "image/x-win-bitmap"},
+    {VD_AGENT_CLIPBOARD_IMAGE_TIFF,"image/tiff"},
+    {VD_AGENT_CLIPBOARD_IMAGE_JPG, "image/jpeg"},
+};
+
+static const gchar *canonical_mime_for_type(guint32 type, GPtrArray *mimes)
+{
+    for (gsize i = 0; i < G_N_ELEMENTS(mime2type); i++) {
+        if (mime2type[i].type != type)
+            continue;
+        for (guint j = 0; j < mimes->len; j++) {
+            if (!g_ascii_strcasecmp(g_ptr_array_index(mimes, j), mime2type[i].mime))
+                return mime2type[i].mime;
+        }
+    }
+    return NULL;
+}
+
+static guint32 spice_type_for_mime(const gchar *mime)
+{
+    for (gsize i = 0; i < G_N_ELEMENTS(mime2type); i++) {
+        if (!g_ascii_strcasecmp(mime, mime2type[i].mime))
+            return mime2type[i].type;
+    }
+    return VD_AGENT_CLIPBOARD_NONE;
+}
+
+/* data-control offer -------------------------------------------------- */
+
+/* Each offer carries its own GPtrArray of mimes as the listener data —
+ * `wl_proxy_add_listener` writes the data argument as the proxy's
+ * user_data, so wl_proxy_get_user_data() reads it back. We don't destroy
+ * offers eagerly: at bind time the compositor sends both clipboard and
+ * primary selection back-to-back, and a stray destroy of one would race
+ * with the still-queued selection event for the other. Offers are torn
+ * down when the matching selection/primary_selection event arrives, or
+ * when superseded by a later selection. */
+
+static GPtrArray *offer_mimes(struct ext_data_control_offer_v1 *o)
+{
+    return wl_proxy_get_user_data((struct wl_proxy *)o);
+}
+
+static void offer_destroy_with_mimes(struct ext_data_control_offer_v1 *o)
+{
+    if (o == NULL)
+        return;
+    GPtrArray *mimes = offer_mimes(o);
+    if (mimes)
+        g_ptr_array_unref(mimes);
+    ext_data_control_offer_v1_destroy(o);
+}
+
+static void offer_offer(void *data, struct ext_data_control_offer_v1 *offer,
+                        const char *mime_type)
+{
+    g_ptr_array_add((GPtrArray *)data, g_strdup(mime_type));
+}
+
+static const struct ext_data_control_offer_v1_listener offer_listener = {
+    .offer = offer_offer,
+};
+
+/* data-control device ------------------------------------------------- */
+
+static void close_pending_send(VDAgentWayland *w, guint sel_id);
+
+static void device_data_offer(void *data, struct ext_data_control_device_v1 *device,
+                              struct ext_data_control_offer_v1 *id)
+{
+    GPtrArray *mimes = g_ptr_array_new_with_free_func(g_free);
+    ext_data_control_offer_v1_add_listener(id, &offer_listener, mimes);
+}
+
+/* Build a SPICE-type array from an offer's mimes, in mime2type order, with
+ * each type appearing at most once. Returns NULL if no type matches. */
+static GArray *types_from_mimes(GPtrArray *mimes)
+{
+    gboolean seen[VD_AGENT_CLIPBOARD_IMAGE_JPG + 1] = { 0 };
+    GArray *types = g_array_new(FALSE, FALSE, sizeof(guint32));
+
+    for (gsize i = 0; i < G_N_ELEMENTS(mime2type); i++) {
+        guint32 t = mime2type[i].type;
+        if (t > VD_AGENT_CLIPBOARD_IMAGE_JPG || seen[t])
+            continue;
+        for (guint j = 0; j < mimes->len; j++) {
+            if (!g_ascii_strcasecmp(g_ptr_array_index(mimes, j), mime2type[i].mime)) {
+                g_array_append_val(types, t);
+                seen[t] = TRUE;
+                break;
+            }
+        }
+    }
+    if (types->len == 0) {
+        g_array_free(types, TRUE);
+        return NULL;
+    }
+    return types;
+}
+
+/* Body shared between device_selection and device_primary_selection. */
+static void handle_offer(VDAgentWayland *w, guint sel_id,
+                         struct ext_data_control_offer_v1 *id)
+{
+    GPtrArray *mimes;
+    GArray *types;
+
+    if (w->current_offer[sel_id] != NULL && w->current_offer[sel_id] != id) {
+        offer_destroy_with_mimes(w->current_offer[sel_id]);
+        w->current_offer[sel_id] = NULL;
+    }
+    if (id == NULL)
+        return;
+
+    if (w->we_own[sel_id]) {
+        /* Echo of our own set_selection — discard, don't bounce a GRAB. */
+        offer_destroy_with_mimes(id);
+        return;
+    }
+
+    w->current_offer[sel_id] = id;
+    mimes = offer_mimes(id);
+    types = (mimes && mimes->len) ? types_from_mimes(mimes) : NULL;
+    if (types == NULL) {
+        if (w->debug)
+            syslog(LOG_DEBUG, "wayland: guest %s has no supported mime",
+                   sel_name(sel_id));
+        return;
+    }
+    syslog(LOG_INFO, "wayland: guest %s changed, GRAB %u type(s)",
+           sel_name(sel_id), types->len);
+    udscs_write(w->vdagentd, VDAGENTD_CLIPBOARD_GRAB, sel_id, 0,
+                (uint8_t *)types->data, types->len * sizeof(guint32));
+    g_array_free(types, TRUE);
+}
+
+static void device_selection(void *data, struct ext_data_control_device_v1 *device,
+                             struct ext_data_control_offer_v1 *id)
+{
+    handle_offer(data, VD_AGENT_CLIPBOARD_SELECTION_CLIPBOARD, id);
+}
+
+static void device_primary_selection(void *data,
+                                     struct ext_data_control_device_v1 *device,
+                                     struct ext_data_control_offer_v1 *id)
+{
+    handle_offer(data, VD_AGENT_CLIPBOARD_SELECTION_PRIMARY, id);
+}
+
+static void device_finished(void *data, struct ext_data_control_device_v1 *device)
+{
+    VDAgentWayland *w = data;
+
+    syslog(LOG_WARNING, "wayland: data control device finished");
+    for (guint s = 0; s < VDAGENT_WAYLAND_N_SELECTIONS; s++) {
+        close_pending_send(w, s);
+        g_clear_pointer(&w->current_offer[s],  offer_destroy_with_mimes);
+        g_clear_pointer(&w->current_source[s], ext_data_control_source_v1_destroy);
+        w->we_own[s] = FALSE;
+    }
+    if (w->device == device) {
+        ext_data_control_device_v1_destroy(w->device);
+        w->device = NULL;
+    }
+}
+
+static const struct ext_data_control_device_v1_listener device_listener = {
+    .data_offer        = device_data_offer,
+    .selection         = device_selection,
+    .finished          = device_finished,
+    .primary_selection = device_primary_selection,
+};
+
+/* data-control source ------------------------------------------------- */
+
+static void close_pending_send(VDAgentWayland *w, guint sel_id)
+{
+    if (w->pending_send_fd[sel_id] >= 0) {
+        close(w->pending_send_fd[sel_id]);
+        w->pending_send_fd[sel_id] = -1;
+    }
+}
+
+static void release_source(VDAgentWayland *w, guint sel_id)
+{
+    close_pending_send(w, sel_id);
+    w->we_own[sel_id] = FALSE;
+    g_clear_pointer(&w->current_source[sel_id],
+                    ext_data_control_source_v1_destroy);
+}
+
+/* Locate which selection a source pointer belongs to, or
+ * VDAGENT_WAYLAND_N_SELECTIONS if none — happens when source.send arrives
+ * after we've already torn the source down. */
+static guint sel_for_source(VDAgentWayland *w,
+                            struct ext_data_control_source_v1 *source)
+{
+    for (guint s = 0; s < VDAGENT_WAYLAND_N_SELECTIONS; s++)
+        if (w->current_source[s] == source)
+            return s;
+    return VDAGENT_WAYLAND_N_SELECTIONS;
+}
+
+static void source_send(void *data, struct ext_data_control_source_v1 *source,
+                        const char *mime_type, int32_t fd)
+{
+    VDAgentWayland *w = data;
+    guint sel_id = sel_for_source(w, source);
+    guint32 type;
+
+    if (sel_id >= VDAGENT_WAYLAND_N_SELECTIONS) {
+        close(fd);
+        return;
+    }
+    type = spice_type_for_mime(mime_type);
+    if (type == VD_AGENT_CLIPBOARD_NONE) {
+        if (w->debug)
+            syslog(LOG_DEBUG, "wayland: source.send for unknown mime %s", mime_type);
+        close(fd);
+        return;
+    }
+    if (w->pending_send_fd[sel_id] >= 0) {
+        if (w->debug)
+            syslog(LOG_DEBUG,
+                   "wayland: source.send for %s while previous is pending, dropping",
+                   mime_type);
+        close(fd);
+        return;
+    }
+
+    w->pending_send_fd[sel_id]   = fd;
+    w->pending_send_type[sel_id] = type;
+    if (w->debug)
+        syslog(LOG_DEBUG, "wayland: %s source.send %s -> REQUEST type=%u",
+               sel_name(sel_id), mime_type, type);
+    udscs_write(w->vdagentd, VDAGENTD_CLIPBOARD_REQUEST, sel_id, type, NULL, 0);
+}
+
+static void source_cancelled(void *data, struct ext_data_control_source_v1 *source)
+{
+    VDAgentWayland *w = data;
+    guint sel_id = sel_for_source(w, source);
+
+    if (sel_id >= VDAGENT_WAYLAND_N_SELECTIONS)
+        return;
+    if (w->debug)
+        syslog(LOG_DEBUG, "wayland: %s source cancelled", sel_name(sel_id));
+    release_source(w, sel_id);
+}
+
+static const struct ext_data_control_source_v1_listener source_listener = {
+    .send      = source_send,
+    .cancelled = source_cancelled,
+};
+
+/* internal init / teardown -------------------------------------------- */
+
+gboolean vdagent_wayland_clipboard_attach(VDAgentWayland *w)
+{
+    w->device = ext_data_control_manager_v1_get_data_device(w->data_control, w->seat);
+    if (w->device == NULL) {
+        syslog(LOG_ERR, "wayland: failed to obtain data-control device");
+        return FALSE;
+    }
+    ext_data_control_device_v1_add_listener(w->device, &device_listener, w);
+    return TRUE;
+}
+
+void vdagent_wayland_clipboard_release_state(VDAgentWayland *w)
+{
+    for (guint s = 0; s < VDAGENT_WAYLAND_N_SELECTIONS; s++) {
+        close_pending_send(w, s);
+        g_clear_pointer(&w->current_offer[s],  offer_destroy_with_mimes);
+        g_clear_pointer(&w->current_source[s], ext_data_control_source_v1_destroy);
+    }
+    g_clear_pointer(&w->device, ext_data_control_device_v1_destroy);
+}
+
+/* Public API: clipboard ----------------------------------------------- */
+
+static void install_selection(VDAgentWayland *w, guint sel_id,
+                              struct ext_data_control_source_v1 *source)
+{
+    if (sel_id == VD_AGENT_CLIPBOARD_SELECTION_PRIMARY)
+        ext_data_control_device_v1_set_primary_selection(w->device, source);
+    else
+        ext_data_control_device_v1_set_selection(w->device, source);
+}
+
+void vdagent_wayland_clipboard_grab(VDAgentWayland *w, guint sel_id,
+                                    guint32 *types, guint n_types)
+{
+    guint advertised = 0;
+
+    if (sel_id >= VDAGENT_WAYLAND_N_SELECTIONS)
+        return;
+    if (w->data_control == NULL || w->device == NULL)
+        return;
+    if (n_types > MAX_CLIPBOARD_TYPES) {
+        syslog(LOG_WARNING, "wayland: host GRAB with %u types, capping at %u",
+               n_types, MAX_CLIPBOARD_TYPES);
+        n_types = MAX_CLIPBOARD_TYPES;
+    }
+
+    release_source(w, sel_id);
+
+    w->current_source[sel_id] =
+        ext_data_control_manager_v1_create_data_source(w->data_control);
+    if (w->current_source[sel_id] == NULL) {
+        syslog(LOG_ERR, "wayland: create_data_source failed");
+        return;
+    }
+    ext_data_control_source_v1_add_listener(w->current_source[sel_id],
+                                            &source_listener, w);
+
+    for (guint i = 0; i < n_types; i++) {
+        for (gsize j = 0; j < G_N_ELEMENTS(mime2type); j++) {
+            if (mime2type[j].type == types[i]) {
+                ext_data_control_source_v1_offer(w->current_source[sel_id],
+                                                 mime2type[j].mime);
+                advertised++;
+            }
+        }
+    }
+    if (advertised == 0) {
+        if (w->debug)
+            syslog(LOG_DEBUG,
+                   "wayland: host %s GRAB with no supported types, dropping",
+                   sel_name(sel_id));
+        g_clear_pointer(&w->current_source[sel_id],
+                        ext_data_control_source_v1_destroy);
+        return;
+    }
+
+    w->we_own[sel_id] = TRUE;
+    install_selection(w, sel_id, w->current_source[sel_id]);
+    wl_display_flush(w->display);
+    syslog(LOG_INFO, "wayland: host %s GRAB, offering %u mime(s) for %u type(s)",
+           sel_name(sel_id), advertised, n_types);
+}
+
+void vdagent_wayland_clipboard_data(VDAgentWayland *w, guint sel_id, guint type,
+                                    guchar *data, guint size)
+{
+    ssize_t written = 0;
+
+    if (sel_id >= VDAGENT_WAYLAND_N_SELECTIONS || w->pending_send_fd[sel_id] < 0)
+        return; /* stray reply */
+    if (type != w->pending_send_type[sel_id]) {
+        if (w->debug)
+            syslog(LOG_DEBUG,
+                   "wayland: %s DATA type=%u doesn't match pending type=%u",
+                   sel_name(sel_id), type, w->pending_send_type[sel_id]);
+        close_pending_send(w, sel_id);
+        return;
+    }
+    if (size > MAX_CLIPBOARD_BYTES) {
+        syslog(LOG_WARNING, "wayland: DATA payload %u exceeds %u byte cap, dropping",
+               size, MAX_CLIPBOARD_BYTES);
+        close_pending_send(w, sel_id);
+        return;
+    }
+
+    if (type != VD_AGENT_CLIPBOARD_NONE && size > 0) {
+        while (written < (ssize_t)size) {
+            ssize_t n = write(w->pending_send_fd[sel_id],
+                              data + written, size - written);
+            if (n < 0) {
+                if (errno == EINTR)
+                    continue;
+                syslog(LOG_ERR, "wayland: write to send fd: %s", strerror(errno));
+                break;
+            }
+            written += n;
+        }
+        if (w->debug)
+            syslog(LOG_DEBUG, "wayland: served %zd/%u bytes for %s type=%u",
+                   written, size, sel_name(sel_id), type);
+    }
+    close_pending_send(w, sel_id);
+}
+
+void vdagent_wayland_clipboard_release(VDAgentWayland *w, guint sel_id)
+{
+    if (sel_id >= VDAGENT_WAYLAND_N_SELECTIONS || w->current_source[sel_id] == NULL)
+        return;
+    if (w->device)
+        install_selection(w, sel_id, NULL);
+    release_source(w, sel_id);
+    if (w->display)
+        wl_display_flush(w->display);
+}
+
+/* Drain `offer` for `mime` via a fresh pipe. */
+static GBytes *receive_offer(VDAgentWayland *w,
+                             struct ext_data_control_offer_v1 *offer,
+                             const gchar *mime)
+{
+    int fds[2];
+    GByteArray *buf;
+    guint8 chunk[4096];
+    ssize_t n;
+    GError *err = NULL;
+
+    if (!g_unix_open_pipe(fds, FD_CLOEXEC, &err)) {
+        syslog(LOG_ERR, "wayland: pipe(): %s", err->message);
+        g_error_free(err);
+        return NULL;
+    }
+
+    ext_data_control_offer_v1_receive(offer, mime, fds[1]);
+    /* Push the request out and drop our write end so read() sees EOF. */
+    wl_display_flush(w->display);
+    close(fds[1]);
+
+    buf = g_byte_array_new();
+    while ((n = read(fds[0], chunk, sizeof(chunk))) > 0) {
+        if (buf->len + (gsize)n > MAX_CLIPBOARD_BYTES) {
+            syslog(LOG_WARNING, "wayland: offer for %s exceeds %u byte cap, truncating",
+                   mime, MAX_CLIPBOARD_BYTES);
+            break;
+        }
+        g_byte_array_append(buf, chunk, n);
+    }
+    close(fds[0]);
+
+    if (n < 0) {
+        syslog(LOG_ERR, "wayland: read from offer pipe: %s", strerror(errno));
+        g_byte_array_free(buf, TRUE);
+        return NULL;
+    }
+    if (buf->len == 0) {
+        g_byte_array_free(buf, TRUE);
+        return NULL;
+    }
+    return g_byte_array_free_to_bytes(buf);
+}
+
+void vdagent_wayland_clipboard_request(VDAgentWayland *w, guint sel_id, guint type)
+{
+    struct ext_data_control_offer_v1 *offer;
+    const gchar *mime;
+    GPtrArray *mimes;
+    GBytes *bytes;
+
+    if (sel_id >= VDAGENT_WAYLAND_N_SELECTIONS)
+        goto reply_none;
+    offer = w->current_offer[sel_id];
+    if (offer == NULL)
+        goto reply_none;
+
+    mimes = offer_mimes(offer);
+    mime = mimes ? canonical_mime_for_type(type, mimes) : NULL;
+    if (mime == NULL) {
+        if (w->debug)
+            syslog(LOG_DEBUG,
+                   "wayland: REQUEST type=%u not advertised by current %s offer",
+                   type, sel_name(sel_id));
+        goto reply_none;
+    }
+
+    bytes = receive_offer(w, offer, mime);
+    if (bytes == NULL)
+        goto reply_none;
+
+    gsize len;
+    const guint8 *data = g_bytes_get_data(bytes, &len);
+    if (w->debug)
+        syslog(LOG_DEBUG, "wayland: serving %zu bytes for %s type=%u (%s)",
+               len, sel_name(sel_id), type, mime);
+    udscs_write(w->vdagentd, VDAGENTD_CLIPBOARD_DATA, sel_id, type,
+                data, (uint32_t)len);
+    g_bytes_unref(bytes);
+    return;
+
+reply_none:
+    udscs_write(w->vdagentd, VDAGENTD_CLIPBOARD_DATA, sel_id,
+                VD_AGENT_CLIPBOARD_NONE, NULL, 0);
+}
+
+#else /* !WITH_WAYLAND */
+
+#include "wayland.h"
+
+void vdagent_wayland_clipboard_grab(VDAgentWayland *w, guint sel_id,
+                                    guint32 *types, guint n_types)
+{
+}
+
+void vdagent_wayland_clipboard_request(VDAgentWayland *w, guint sel_id, guint type)
+{
+}
+
+void vdagent_wayland_clipboard_data(VDAgentWayland *w, guint sel_id, guint type,
+                                    guchar *data, guint size)
+{
+}
+
+void vdagent_wayland_clipboard_release(VDAgentWayland *w, guint sel_id)
+{
+}
+
+#endif /* WITH_WAYLAND */
