+
+#include "internal.h"
+
+static void registry_global(void *data, struct wl_registry *registry,
+                            uint32_t name, const char *interface, uint32_t version)
+{
+    VDAgentWayland *w = data;
+
+    if (strcmp(interface, wl_seat_interface.name) == 0 && w->seat == NULL) {
+        w->seat = wl_registry_bind(registry, name, &wl_seat_interface, MIN(version, 1));
+    } else if (strcmp(interface, wl_output_interface.name) == 0 && w->output == NULL) {
+        w->output = wl_registry_bind(registry, name, &wl_output_interface, MIN(version, 2));
+    } else if (strcmp(interface, ext_data_control_manager_v1_interface.name) == 0
+               && w->data_control == NULL) {
+        w->data_control = wl_registry_bind(registry, name,
+                                           &ext_data_control_manager_v1_interface,
+                                           MIN(version, 1));
+    }
+}
+
+static void registry_global_remove(void *d, struct wl_registry *r, uint32_t n)
+{
+}
+
+static const struct wl_registry_listener registry_listener = {
+    .global        = registry_global,
+    .global_remove = registry_global_remove,
+};
+
+static gboolean wayland_io_cb(GIOChannel *source, GIOCondition cond, gpointer data)
+{
+    VDAgentWayland *w = data;
+
+    if (cond & (G_IO_ERR | G_IO_HUP)) {
+        syslog(LOG_ERR, "wayland: display fd error/hup, terminating");
+        return G_SOURCE_REMOVE;
+    }
+    /* Standard wayland-client read pattern: drain anything queued, read the
+     * fd, dispatch, flush any requests we generated. */
+    while (wl_display_prepare_read(w->display) != 0) {
+        if (wl_display_dispatch_pending(w->display) < 0)
+            goto err;
+    }
+    if (wl_display_read_events(w->display) < 0)
+        goto err;
+    if (wl_display_dispatch_pending(w->display) < 0)
+        goto err;
+    wl_display_flush(w->display);
+    return G_SOURCE_CONTINUE;
+
+err:
+    syslog(LOG_ERR, "wayland: dispatch failed: %s", strerror(errno));
+    return G_SOURCE_REMOVE;
+}
+
+static void cleanup_resources(VDAgentWayland *w)
+{
+    if (w->watch_id) {
+        g_source_remove(w->watch_id);
+        w->watch_id = 0;
+    }
+    g_clear_pointer(&w->channel, g_io_channel_unref);
+    vdagent_wayland_clipboard_release_state(w);
+    g_clear_pointer(&w->data_control, ext_data_control_manager_v1_destroy);
+    g_clear_pointer(&w->seat,         wl_seat_destroy);
+    g_clear_pointer(&w->output,       wl_output_destroy);
+    g_clear_pointer(&w->registry,     wl_registry_destroy);
+    g_clear_pointer(&w->display,      wl_display_disconnect);
+}
+
+gboolean vdagent_wayland_session_active(void)
+{
+    const char *env = getenv("WAYLAND_DISPLAY");
+    return env != NULL && env[0] != '\0';
+}
+
+VDAgentWayland *vdagent_wayland_create(UdscsConnection *vdagentd, int debug)
+{
+    VDAgentWayland *w = g_new0(VDAgentWayland, 1);
+    w->vdagentd = vdagentd;
+    w->debug = debug;
+    for (guint s = 0; s < VDAGENT_WAYLAND_N_SELECTIONS; s++)
+        w->pending_send_fd[s] = -1;
+
+    w->display = wl_display_connect(NULL);
+    if (w->display == NULL) {
+        syslog(LOG_ERR, "wayland: failed to connect to display");
+        g_free(w);
+        return NULL;
+    }
+
+    w->registry = wl_display_get_registry(w->display);
+    wl_registry_add_listener(w->registry, &registry_listener, w);
+
+    /* First roundtrip: registry advertisements arrive. */
+    if (wl_display_roundtrip(w->display) < 0) {
+        syslog(LOG_ERR, "wayland: initial roundtrip failed");
+        goto err;
+    }
+    if (w->data_control == NULL) {
+        syslog(LOG_ERR, "wayland: compositor does not advertise %s",
+               ext_data_control_manager_v1_interface.name);
+        goto err;
+    }
+    if (w->seat == NULL) {
+        syslog(LOG_ERR, "wayland: compositor advertised no wl_seat");
+        goto err;
+    }
+    if (w->output == NULL)
+        syslog(LOG_WARNING, "wayland: compositor advertised no wl_output");
+
+    if (!vdagent_wayland_clipboard_attach(w))
+        goto err;
+    vdagent_wayland_display_attach(w);
+
+    /* Second roundtrip: wl_output Mode/Done and any current selection arrive. */
+    if (wl_display_roundtrip(w->display) < 0) {
+        syslog(LOG_ERR, "wayland: post-bind roundtrip failed");
+        goto err;
+    }
+
+    /* Hand the display fd to the GMainLoop. */
+    w->channel = g_io_channel_unix_new(wl_display_get_fd(w->display));
+    if (w->channel == NULL) {
+        syslog(LOG_ERR, "wayland: failed to create GIOChannel");
+        goto err;
+    }
+    g_io_channel_set_encoding(w->channel, NULL, NULL);
+    w->watch_id = g_io_add_watch(w->channel, G_IO_IN | G_IO_ERR | G_IO_HUP,
+                                 wayland_io_cb, w);
+    wl_display_flush(w->display);
+
+    syslog(LOG_INFO, "wayland: backend ready");
+    return w;
+
+err:
+    cleanup_resources(w);
+    g_free(w);
+    return NULL;
+}
+
+void vdagent_wayland_destroy(VDAgentWayland *w)
+{
+    if (w == NULL)
+        return;
+    cleanup_resources(w);
+    g_free(w);
+}
+
+#else /* !WITH_WAYLAND */
+
+#include "wayland.h"
+
+gboolean vdagent_wayland_session_active(void)
+{
+    return FALSE;
+}
+
+VDAgentWayland *vdagent_wayland_create(UdscsConnection *vdagentd, int debug)
+{
+    return NULL;
+}
+
+void vdagent_wayland_destroy(VDAgentWayland *w)
+{
+}
+
+#endif /* WITH_WAYLAND */
