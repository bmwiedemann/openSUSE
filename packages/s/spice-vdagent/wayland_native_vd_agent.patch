+*/
+
+#ifndef __VDAGENT_WAYLAND_INTERNAL_H
+#define __VDAGENT_WAYLAND_INTERNAL_H
+
+#include <stdint.h>
+#include <syslog.h>
+
+#include <glib.h>
+#include <wayland-client.h>
+
+#include "ext-data-control-v1-protocol.h"
+#include "udscs.h"
+#include "wayland.h"
+
+struct VDAgentWayland {
+    UdscsConnection *vdagentd;
+    int              debug;
+
+    struct wl_display    *display;
+    struct wl_registry   *registry;
+    struct wl_seat       *seat;
+    struct wl_output     *output;
+    struct ext_data_control_manager_v1 *data_control;
+    struct ext_data_control_device_v1  *device;
+
+    /* Per-selection state, indexed by VD_AGENT_CLIPBOARD_SELECTION_*.
+     * [0] = CLIPBOARD, [1] = PRIMARY. SECONDARY has no wayland counterpart. */
+#define VDAGENT_WAYLAND_N_SELECTIONS 2
+
+    /* Most recently committed guest-side offer; mime list lives in its
+     * wl_proxy user_data. NULL when that selection is empty. */
+    struct ext_data_control_offer_v1  *current_offer[VDAGENT_WAYLAND_N_SELECTIONS];
+
+    /* Source we install on the device to expose host-owned data to guest
+     * applications. NULL when we don't own that selection. */
+    struct ext_data_control_source_v1 *current_source[VDAGENT_WAYLAND_N_SELECTIONS];
+
+    /* TRUE while our source is the active selection. Discards the selection
+     * event the compositor echoes back when we install our own source. */
+    gboolean we_own[VDAGENT_WAYLAND_N_SELECTIONS];
+
+    /* In-flight paste: source.send stashes the write-end fd here; the DATA
+     * reply later writes the bytes and closes it. -1 = idle. */
+    int     pending_send_fd[VDAGENT_WAYLAND_N_SELECTIONS];
+    guint32 pending_send_type[VDAGENT_WAYLAND_N_SELECTIONS];
+
+    /* Tracked output mode. `width`/`height` are what we last reported;
+     * `pending_*` are staged from wl_output Mode events and committed on Done. */
+    int32_t width, height;
+    int32_t pending_width, pending_height;
+
+    GIOChannel *channel;
+    guint       watch_id;
+};
+
+/* display.c ------------------------------------------------------------ */
+void vdagent_wayland_display_attach(VDAgentWayland *w);
+
+/* clipboard.c ---------------------------------------------------------- */
+gboolean vdagent_wayland_clipboard_attach(VDAgentWayland *w);
+void     vdagent_wayland_clipboard_release_state(VDAgentWayland *w);
+
+#endif /* __VDAGENT_WAYLAND_INTERNAL_H */
