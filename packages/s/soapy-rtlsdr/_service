<services>
  <service name="obs_scm" mode="manual">
    <param name="url">https://github.com/pothosware/SoapyRTLSDR.git</param>
    <param name="scm">git</param>
    <!-- track the 0.3.4 tag: folds the Blog V4 snapshot into a release -->
    <param name="revision">soapy-rtlsdr-0.3.4</param>
    <!-- tag build: plain version, no +git suffix -->
    <param name="versionformat">0.3.4</param>
    <param name="exclude">.git*</param>
    <param name="filename">soapy-rtlsdr</param>
  </service>
  <service name="tar" mode="buildtime"/>
  <service name="recompress" mode="buildtime">
    <param name="file">*.tar</param>
    <param name="compression">zst</param>
  </service>
  <service name="set_version" mode="buildtime"/>
</services>
