<services>
  <!-- upstream tags only 0.1.0/0.1.1 (2019); all later work sits on master, so pin a commit -->
  <service name="obs_scm" mode="manual">
    <param name="url">https://github.com/pothosware/SoapyFCDPP.git</param>
    <param name="scm">git</param>
    <param name="revision">96c31ed20ceac1b9024fde3bf0a386767edb7ad6</param>
    <param name="versionformat">0.2.0~git%cd.%h</param>
    <param name="exclude">.git*</param>
    <param name="filename">soapy-fcdpp</param>
  </service>
  <service name="tar" mode="buildtime"/>
  <service name="recompress" mode="buildtime">
    <param name="file">*.tar</param>
    <param name="compression">zst</param>
  </service>
  <service name="set_version" mode="buildtime"/>
</services>
