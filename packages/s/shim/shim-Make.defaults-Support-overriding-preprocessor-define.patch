From eed4adeecd79f9bcd6f68af33905894f74d81f17 Mon Sep 17 00:00:00 2001
From: Chun-Yi Lee <jlee@suse.com>
Date: Thu, 29 Oct 2026 22:55:58 +0800
Subject: [PATCH] Make.defaults: Support overriding preprocessor defines via
 EXTRA_DEFINES

Currently, CFLAGS accumulates various internal build options and ends
with $(DEFINES). When downstream packagers need to supplement or override
specific preprocessor macros without disrupting the build defaults, there
is no dedicated interface to do so.

Overriding DEFINES directly on the make command line is too intrusive, as
it wipes out all default definitions set by Make.defaults.

Append $(EXTRA_DEFINES) to CFLAGS. This provides a clean mechanism for
build scripts to pass extra preprocessor directives, such as tailoring
the debug directory path:

    make EXTRA_DEFINES='-UDEBUGDIR -DDEBUGDIR=L"/usr/lib/debug/..."'

This patch is sent to upstream for reviewing.

Link: https://github.com/rhboot/shim/pull/837
Signed-off-by: Chun-Yi Lee <jlee@suse.com>
---
 BUILDING      | 6 ++++++
 Make.defaults | 3 ++-
 2 files changed, 8 insertions(+), 1 deletion(-)

Index: shim-16.1/BUILDING
===================================================================
--- shim-16.1.orig/BUILDING
+++ shim-16.1/BUILDING
@@ -75,6 +75,12 @@ Variables you could set to customize the
 - ENABLE_CODESIGN_EKU
   This changes the certificate validation logic to require Extended Key
   Usage 1.3.6.1.5.5.7.3.3 ("Code Signing").
+- EXTRA_DEFINES
+  This allows you to append additional C preprocessor macros to CFLAGS
+  without overriding the internal DEFINES set by the build system.
+  For example, to customize the embedded debug directory path:
+
+    make EXTRA_DEFINES='-UDEBUGDIR -DDEBUGDIR=L\"/usr/lib/debug/usr/share/efi/$(ARCH)/\"'
 
 Vendor SBAT data:
 It will sometimes be requested by reviewers that a build includes extra
Index: shim-16.1/Make.defaults
===================================================================
--- shim-16.1.orig/Make.defaults
+++ shim-16.1/Make.defaults
@@ -138,7 +138,8 @@ CFLAGS		= $(FEATUREFLAGS) \
 		  $(ARCH_CFLAGS) \
 		  $(WERRFLAGS) \
 		  $(INCLUDES) \
-		  $(DEFINES)
+		  $(DEFINES) \
+		  $(EXTRA_DEFINES)
 
 POST_PROCESS_PE_FLAGS =
 
