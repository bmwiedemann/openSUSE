From 52d7607779d67ede2c26249e9f822efe9708892c Mon Sep 17 00:00:00 2001
From: Christophe Marin <christophe@krop.fr>
Date: Sun, 15 Nov 2026 15:48:21 +0100
Subject: [PATCH] Don't add executables to exported CMake targets

This prevents installing the devel package without requiring the dcmtk utilities.
---
 CMake/GenerateCMakeExports.cmake | 5 +++--
 CMake/dcmtkMacros.cmake          | 2 +-
 2 files changed, 4 insertions(+), 3 deletions(-)

diff --git a/CMake/GenerateCMakeExports.cmake b/CMake/GenerateCMakeExports.cmake
index c5922ce..f800eae 100644
--- a/CMake/GenerateCMakeExports.cmake
+++ b/CMake/GenerateCMakeExports.cmake
@@ -18,11 +18,12 @@
 # APPEND. A single non-APPEND call allows CMake to resolve dependency targets
 # that live in other export sets (e.g. ITK codec targets) using those sets'
 # own namespaces, rather than blindly prepending the DCMTK:: namespace.
-get_property(DCMTK_EXECUTABLE_TARGETS GLOBAL PROPERTY DCMTK_EXECUTABLE_TARGETS)
+
+# get_property(DCMTK_EXECUTABLE_TARGETS GLOBAL PROPERTY DCMTK_EXECUTABLE_TARGETS)
 get_property(DCMTK_LIBRARY_TARGETS GLOBAL PROPERTY DCMTK_LIBRARY_TARGETS)
 set(dcmtk_all_export_targets "")
 list(APPEND dcmtk_all_export_targets
-    ${DCMTK_EXECUTABLE_TARGETS}
+    # ${DCMTK_EXECUTABLE_TARGETS}
     config
     ${DCMTK_LIBRARY_TARGETS}
     DCMTK
diff --git a/CMake/dcmtkMacros.cmake b/CMake/dcmtkMacros.cmake
index 4ba6845..c669d63 100644
--- a/CMake/dcmtkMacros.cmake
+++ b/CMake/dcmtkMacros.cmake
@@ -66,7 +66,7 @@ macro(DCMTK_ADD_EXECUTABLE PROGRAM)
 
         # declare installation files, also export DCMTKTargets.cmake
         install(TARGETS ${PROGRAM}
-                EXPORT DCMTKTargets
+                # EXPORT DCMTKTargets
                 COMPONENT bin
                 DESTINATION ${CMAKE_INSTALL_BINDIR})
     endif()
-- 
2.56.0

