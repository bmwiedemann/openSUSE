+#[repr(C)]
+#[cfg_attr(
+    all(target_arch = "x86_64", target_pointer_width = "32"),
+    repr(align(4))
+)]
+#[derive(Clone, Copy, Debug)]
+struct __SI_CLOCK_T(crate::clock_t);
+
+s_no_extra_traits! {
+    #[cfg_attr(
+        all(target_arch = "x86_64", target_pointer_width = "32"),
+        repr(align(8))
+    )]
+    pub struct siginfo_t {
+        pub si_signo: c_int,
+
