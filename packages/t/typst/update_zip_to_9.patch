+    pub fn difftime(time1: time_t, time0: time_t) -> c_double;
+    pub fn mktime(tm: *mut tm) -> time_t;
+    pub fn gmtime(timep: *const time_t) -> *mut tm;
+    pub fn gmtime_r(timep: *const time_t, result: *mut tm) -> *mut tm;
