+
+#[cfg(not(feature = "deflate-flate2"))]
+impl<W> Default for DeflateCache<W> {
+    fn default() -> Self {
+        Self(core::marker::PhantomData)
+    }
+}
+
+#[cfg(not(feature = "deflate-flate2"))]
+impl<W> Debug for DeflateCache<W> {
+    fn fmt(&self, f: &mut Formatter<'_>) -> core::fmt::Result {
+        f.write_str("DeflateCache")
+    }
+}
 
