-/// AES variant used.
-#[derive(Copy, Clone, Debug, Eq, PartialEq)]
-#[cfg_attr(feature = "_arbitrary", derive(arbitrary::Arbitrary))]
-#[repr(u8)]
-pub enum AesMode {
-    /// 128-bit AES encryption.
-    Aes128 = 0x01,
-    /// 192-bit AES encryption.
-    Aes192 = 0x02,
-    /// 256-bit AES encryption.
-    Aes256 = 0x03,
-}
