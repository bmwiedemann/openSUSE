+/// Helper to extract Info-ZIP UnicodePath (0x7075) extra field content and CRC32.
+pub(crate) fn get_upath(extra_fields: &ExtraFields) -> (Option<&[u8]>, Option<u32>) {
+    extra_fields
+        .inner
+        .iter()
+        .rev()
+        .find_map(|f| match f {
+            ExtraField::UnicodePath(u) => Some((&*u.content, u.crc32)),
+            _ => None,
+        })
+        .unzip()
+}
