+        msgvec: *mut crate::mmsghdr,
+        vlen: c_uint,
+        flags: c_uint,
+    ) -> c_int;
+    #[cfg_attr(musl_redir_time64, link_name = "__recvmmsg_time64")]
+    pub fn recvmmsg(
