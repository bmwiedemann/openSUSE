-                    dst.push(byte);
-                }
-            }
-        } else {
-            // Copy with implicit zeros
-            for _ in 0..len {
-                if dist as usize > dst.len() {
-                    dst.push(0);
-                } else {
-                    let byte = dst[dst.len() - dist as usize];
-                    dst.push(byte);
-                }
-            }
-        }
-    }
