+impl<'k, 'n, T: sealed::FileOptionExtension> FileOptions<'k, 'n, T> {
+    pub(crate) fn normalize(&mut self) {
+        if !self.last_modified_time.is_valid() {
+            self.last_modified_time = FileOptions::<T>::default().last_modified_time;
+        }
