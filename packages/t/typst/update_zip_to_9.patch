+impl<R: BufRead> LazyDecompressor<R> {
+    pub fn new(reader: R, parameters: InstantiationParameters) -> Self {
+        LazyDecompressor::Uninitialized {
+            inner: reader,
+            parameters,
+        }
+    }
+
+    /// Consumes this decoder, returning the underlying reader.
+    pub fn into_inner(self) -> io::Result<R> {
+        match self {
+            LazyDecompressor::Uninitialized { inner, .. } => Ok(inner),
+            LazyDecompressor::Failed(None) => Err(io::Error::other(
+                "Decompressor previously failed to initialize or panicked while reading",
+            )),
+            LazyDecompressor::Failed(Some(inner)) => Ok(inner),
+            LazyDecompressor::Initialized(d) => Ok(match d {
+                Decompressor::Stored(r) => r,
+                #[cfg(feature = "deflate-flate2")]
+                Decompressor::Deflated(r) => r.into_inner(),
+                #[cfg(feature = "deflate64")]
+                Decompressor::Deflate64(r) => r.into_inner(),
+                #[cfg(feature = "_bzip2_any")]
+                Decompressor::Bzip2(r) => r.into_inner(),
+                #[cfg(feature = "zstd")]
+                Decompressor::Zstd(r) => r.finish(),
+                #[cfg(feature = "lzma")]
+                Decompressor::Lzma(r) => r.into_inner(),
+                #[cfg(feature = "legacy-zip")]
+                Decompressor::Shrink(r) => r.into_inner(),
+                #[cfg(feature = "legacy-zip")]
+                Decompressor::Reduce(r) => r.into_inner(),
+                #[cfg(feature = "legacy-zip")]
+                Decompressor::Implode(r) => r.into_inner(),
+                #[cfg(feature = "xz")]
+                Decompressor::Xz(r) => r.into_inner(),
+                #[cfg(feature = "ppmd")]
+                Decompressor::Ppmd(r) => r.into_inner(),
+            }),
+        }
+    }
+
+    /// Consumes this decoder, returning the underlying reader.
+    pub fn inner(&self) -> Option<&R> {
+        #[allow(clippy::infallible_destructuring_match)]
+        match self {
+            LazyDecompressor::Initialized(decompressor) => Some(match decompressor {
+                Decompressor::Stored(r) => r,
+                #[cfg(feature = "deflate-flate2")]
+                Decompressor::Deflated(r) => r.get_ref(),
+                #[cfg(feature = "deflate64")]
+                Decompressor::Deflate64(r) => r.get_ref(),
+                #[cfg(feature = "_bzip2_any")]
+                Decompressor::Bzip2(r) => r.get_ref(),
+                #[cfg(feature = "zstd")]
+                Decompressor::Zstd(r) => r.get_ref(),
+                #[cfg(feature = "lzma")]
+                Decompressor::Lzma(r) => r.inner(),
+                #[cfg(feature = "legacy-zip")]
+                Decompressor::Shrink(r) => r.inner(),
+                #[cfg(feature = "legacy-zip")]
+                Decompressor::Reduce(r) => r.inner(),
+                #[cfg(feature = "legacy-zip")]
+                Decompressor::Implode(r) => r.inner(),
+                #[cfg(feature = "xz")]
+                Decompressor::Xz(r) => r.inner(),
+                #[cfg(feature = "ppmd")]
+                Decompressor::Ppmd(r) => r.get_ref(),
+            }),
+            LazyDecompressor::Uninitialized { inner, .. } => Some(inner),
+            LazyDecompressor::Failed(maybe_inner) => maybe_inner.as_ref(),
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::{CompressionMethod, SUPPORTED_COMPRESSION_METHODS};
+
+    #[test]
+    fn from_eq_to() {
+        for v in 0..(u32::from(u16::MAX) + 1) {
+            let from = CompressionMethod::parse_from_u16(v as u16);
+            let to = u32::from(from.serialize_to_u16());
+            assert_eq!(v, to);
+        }
+    }
+
+    #[test]
+    fn to_eq_from() {
+        fn check_match(method: CompressionMethod) {
+            let to = method.serialize_to_u16();
+            let from = CompressionMethod::parse_from_u16(to);
+            let back = from.serialize_to_u16();
+            assert_eq!(to, back);
+        }
+
+        for &method in SUPPORTED_COMPRESSION_METHODS {
+            check_match(method);
+        }
+    }
+
+    #[test]
+    fn to_display_fmt() {
+        fn check_match(method: CompressionMethod) {
+            let debug_str = format!("{method:?}");
+            let display_str = format!("{method}");
+            assert_eq!(debug_str, display_str);
+        }
+
+        for &method in SUPPORTED_COMPRESSION_METHODS {
+            check_match(method);
+        }
+    }
+
+    #[cfg(feature = "legacy-zip")]
+    #[test]
+    fn check_reduce() {
+        assert_eq!(CompressionMethod::Reduce(1), CompressionMethod::REDUCE_1);
+        assert_eq!(CompressionMethod::Reduce(1).serialize_to_u16(), 2);
+        assert_eq!(CompressionMethod::REDUCE_1.serialize_to_u16(), 2);
+    }
+}
