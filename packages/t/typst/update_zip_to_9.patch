+        impl core::hash::Hash for siginfo_t {
+            fn hash<H: core::hash::Hasher>(&self, state: &mut H) {
+                self.si_signo.hash(state);
+                self.si_code.hash(state);
+                self.si_errno.hash(state);
+            }
