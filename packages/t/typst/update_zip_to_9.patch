-pub(crate) fn find_data_start(
-    data: &ZipFileData,
-    reader: &mut (impl Read + Seek + ?Sized),
-) -> Result<u64, ZipError> {
-    // Go to start of data.
-    reader.seek(SeekFrom::Start(data.header_start))?;
