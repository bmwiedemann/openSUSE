+pub const MAP_WIRED: c_int = 0x0800;
+
+pub const MAP_FAILED: *mut c_void = !0 as *mut c_void;
+
+// Memory sync constants
+pub const MS_ASYNC: c_int = 0x01;
+pub const MS_INVALIDATE: c_int = 0x02;
+pub const MS_SYNC: c_int = 0x04;
