# Expand the %H remap macro to IPv4 for IPv6-mapped clients (tftpd/tftpd.c).
# Add is_v6_mapped(). In rewrite_macros(), convert an IPv6-mapped address
# (::ffff:a.b.c.d) to its IPv4 form so %H expands to the dotted quad.
# Kept from the 0.48 package.

diff --git a/tftpd/tftpd.c b/tftpd/tftpd.c
index 6dcf14f..e44f834 100644
@@ -1401,6 +1410,21 @@ static char hexchar(unsigned char c)
     return c >= 10 ? (c + 'A' - 10) : c + '0';
 }
 
+#ifdef HAVE_IPV6
+static inline int is_v6_mapped(const union sock_addr* pa)
+{
+    const unsigned char v6_mapped[] = { 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+                               0x00, 0x00, 0xFF, 0xFF };
+
+    if (from.sa.sa_family != AF_INET6)
+        return 0;
+    if (memcmp(&pa->s6.sin6_addr.s6_addr, v6_mapped, sizeof(v6_mapped)))
+        return 0;
+
+    return 1;
+}
+#endif
+
 static size_t rewrite_macros(char macro, const char **output)
 {
 #ifdef INET6_ADDRSTRLEN
@@ -1410,17 +1434,27 @@ static size_t rewrite_macros(char macro, const char **output)
 #endif
     const unsigned char *cp;
     size_t bytes;
+    const union sock_addr *pfrom = &from;
+
+#ifdef HAVE_IPV6
+    union sock_addr ipv4_from;
+    if (is_v6_mapped(&from)) {
+        ipv4_from.si.sin_family = AF_INET;
+        memcpy(&ipv4_from.si.sin_addr, from.s6.sin6_addr.s6_addr + 12, 4);
+        pfrom = &ipv4_from;
+    }
+#endif
 
     *output = obuf;
 
-    switch (from.sa.sa_family) {
+    switch (pfrom->sa.sa_family) {
     case AF_INET:
-        cp = (const unsigned char *)&from.si.sin_addr;
+        cp = (const unsigned char *)&pfrom->si.sin_addr;
         bytes = 4;
         break;
 #ifdef HAVE_IPV6
     case AF_INET6:
-        cp = (const unsigned char *)&from.s6.sin6_addr;
+        cp = (const unsigned char *)&pfrom->s6.sin6_addr;
         bytes = 16;
         break;
 #endif
@@ -1431,7 +1465,7 @@ static size_t rewrite_macros(char macro, const char **output)
     switch (macro) {
     case 'i':
     {
-        const char *p = inet_ntop(from.sa.sa_family, SOCKADDR_P(&from),
+        const char *p = inet_ntop(pfrom->sa.sa_family, SOCKADDR_P(pfrom),
                                   obuf, sizeof obuf);
         return p ? strlen(p) : 0;
     }
