<services>
	<service name="tar_scm" mode="manual">
		<param name="filename">timezone-icu</param>
		<param name="scm">git</param>
		<param name="url">https://github.com/unicode-org/icu-data</param>
		<param name="revision">main</param>
		<param name="include">LICENSE</param>
		<param name="include">tzdata/icunew/2026e/44</param>
		<param name="versionformat">2026e</param>
	</service>
	<service name="recompress" mode="manual">
		<param name="file">*.tar</param>
		<param name="compression">xz</param>
	</service>
	<service name="set_version" mode="manual"/>
</services>
