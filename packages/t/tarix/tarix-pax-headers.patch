+/* seek (if needed) to the given record and pass it through to the
+   output; returns 0 on success, nonzero on error like the caller */
+static int copy_blocks(struct extract_files_state *state,
+  unsigned long blocknum, off64_t offset, unsigned long blocklength)
+{
+  /* for the DMSG macro */
+  int debug_messages = state->debug_messages;
+  off64_t destoff;
+  char passbuf[TARBLKSZ];
+
+  /* seek to the record start and then pass the record through */
+  /* don't actually seek if we're already there */
+  if (state->curpos != blocknum)
+  {
+    destoff = state->zlib_level ? offset : blocknum * TARBLKSZ;
+    DMSG("seeking to %lld\n", (long long)destoff);
+    if (ts_seek(state->tsp, destoff) != 0)
+    {
+      fprintf(stderr, "seek error\n");
+      return 1;
+    }
+    state->curpos = blocknum;
+  }
+  DMSG("reading %ld records\n", blocklength);
+  for (unsigned long bnum = 0; bnum < blocklength; ++bnum)
+  {
+    int n;
+    if ((n = ts_read(state->tsp, passbuf, TARBLKSZ)) < TARBLKSZ)
+    {
+      if (n >= 0)
+        perror("partial tarfile read");
+      else
+        ptserror("read tarfile", n, state->tsp);
+      return 2;
+    }
+    DMSG("read a rec, now at %lld, %ld left\n",
+      (long long)state->curpos, blocklength - bnum - 1);
+    ++state->curpos;
+    if ((n = write(state->outfd, passbuf, TARBLKSZ)) < TARBLKSZ)
+    {
+      perror((n > 0) ? "partial tarfile write" : "write tarfile");
+      return 2;
+    }
+    DMSG("wrote rec\n");
+  }
+
+  return 0;
+}
