From 3c89230da8677fa6c1375f567324583dbd4e7f31 Mon Sep 17 00:00:00 2001
From: Gary Lin <glin@suse.com>
Date: Fri, 30 Oct 2026 15:09:12 +0800
Subject: [PATCH] Revert "File device paths: don't print "File(" or ")""

This reverts commit 9a5e71044bb7262e049793a9759ced5496f11757.

Removing "File(" and ")" from EFIDP_MEDIA_FILE formatting causes
efibootmgr and efibootdump to output the formatted file path fused
directly to the load option's optional data without any whitespace or
delimiter (e.g. ".../loader.efiroot=/dev/sda2"). This breaks downstream
tools that extract the bootloader path from CLI output.

Apply this revert until efibootmgr upstream fixes the optional data
delimiter issue.
---
 src/dp-media.c | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/src/dp-media.c b/src/dp-media.c
index ffda361..df47264 100644
--- a/src/dp-media.c
+++ b/src/dp-media.c
@@ -60,7 +60,9 @@ _format_media_dn(unsigned char *buf, size_t size, const_efidp dp)
 	case EFIDP_MEDIA_FILE: {
 		size_t limit = (efidp_node_size(dp)
 				- offsetof(efidp_file, name)) / 2;
+		format(buf, size, off, "File", "File(");
 		format_ucs2(buf, size, off, "File", dp->file.name, limit);
+		format(buf, size, off, "File", ")");
 		break;
 			       }
 	case EFIDP_MEDIA_PROTOCOL:
-- 
2.51.0

